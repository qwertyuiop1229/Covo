  "bugs": {
    "url": "https://github.com/qwertyuiop1229/simplechat/issues"
  },
  "homepage": "https://github.com/qwertyuiop1229/simplechat#readme",
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@peculiar/x509": "^2.2.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.11.4",
    "fake-indexeddb": "^6.2.6",
    "firebase": "12.19.0",
    "firebase-admin": "^14.1.0",
    "jimp": "^1.6.1",
    "jest": "^30.4.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "@tauri-apps/plugin-updater": "2.14.1",
    "esbuild": "0.25.12",
    "firebase-runtime": "npm:firebase@12.19.0",
    "photoswipe": "5.4.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
