{
  "name": "simplechat",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "check:secrets": "node scripts/check_secret_safety.mjs",
    "test": "jest --runInBand",
    "tauri": "tauri",
    "deploy": "powershell -ExecutionPolicy Bypass -File deploy.ps1 -y",
    "build:css": "node scripts/build_tailwind.mjs",
    "build:css:regen": "node scripts/build_tailwind.mjs --regen",
    "test:web": "node scripts/build_firebase.mjs --if-needed && node scripts/serve_web_preview.mjs",
    "test:firebase-runtime": "node scripts/build_firebase.mjs --if-needed && firebase emulators:exec --config firebase.emulators.json --project demo-covo-security-test --only firestore \"playwright test browser-tests/firestore-sdk.spec.cjs\"",
    "test:web:google": "node scripts/build_firebase.mjs --if-needed && npx --yes firebase-tools hosting:channel:deploy mobile-test --expires 1d --project simplechat-65a0d --config firebase.preview.json",
    "test:win": "node scripts/test_windows.mjs",
    "test:win:native": "node scripts/test_windows.mjs --native",
    "test:unit": "jest --runInBand tests/worker-security.test.js tests/crypto.test.js tests/client-security.test.js tests/chat-regressions.test.js tests/chat-lifecycle-audit.test.js tests/dependency-loader.test.js tests/runtime-stability.test.js tests/communication.test.js",
    "test:security": "firebase emulators:exec --config firebase.emulators.json --project demo-covo-security-test --only firestore,database \"jest --runInBand --silent\"",
    "build:firebase": "node scripts/build_firebase.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwertyuiop1229/simplechat.git"
  },
  "keywords": [],
