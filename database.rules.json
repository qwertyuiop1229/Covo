{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "artifacts": {
      "$appId": {
        "settings": {
          ".read": "auth != null",
          ".write": "false"
        },
        "latestAnnouncement": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "servers": {
          "$serverId": {
            ".read": "auth != null && root.child('artifacts').child($appId).child('servers').child($serverId).child('members').child(auth.uid).exists()",
            "members": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !newData.exists()"
              }
            },
            "rooms": {
              "$roomId": {
                ".write": "auth != null && root.child('artifacts').child($appId).child('servers').child($serverId).child('members').child(auth.uid).exists()",
                "messages": {
                  ".indexOn": ["timestamp"],
                  "$messageId": {
                    ".write": "auth != null && root.child('artifacts').child($appId).child('servers').child($serverId).child('members').child(auth.uid).exists()"
                  }
                },
                "typing": {
                  "$uid": {
                    ".write": "auth != null && auth.uid === $uid && root.child('artifacts').child($appId).child('servers').child($serverId).child('members').child(auth.uid).exists()"
                  }
                },
                "readReceipts": {
                  "$uid": {
                    ".write": "auth != null && auth.uid === $uid && root.child('artifacts').child($appId).child('servers').child($serverId).child('members').child(auth.uid).exists()"
                  }
                }
              }
            }
          }
        },
        "users": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}