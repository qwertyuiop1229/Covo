{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "artifacts": {
      "$appId": {
        "settings": {
          ".read": "auth != null",
          ".write": "false"
        },
        "latestAnnouncement": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "servers": {
          "$serverId": {
            ".read": "auth != null && (root.child('artifacts').child($appId).child('servers').child($serverId).child('members').child(auth.uid).exists() || !data.exists())",
            ".write": "auth != null",
            "members": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            },
            "rooms": {
              "$roomId": {
                ".write": "auth != null && (root.child('artifacts').child($appId).child('servers').child($serverId).child('members').child(auth.uid).exists() || !data.exists())",
                "messages": {
                  ".indexOn": ["timestamp"],
                  "$messageId": {
                    ".write": "auth != null && (root.child('artifacts').child($appId).child('servers').child($serverId).child('members').child(auth.uid).exists() || !data.exists())"
                  }
                },
                "typing": {
                  "$uid": {
                    ".write": "auth != null && auth.uid === $uid"
                  }
                },
                "readReceipts": {
                  "$uid": {
                    ".write": "auth != null && auth.uid === $uid"
                  }
                }
              }
            }
          }
        },
        "dm_messages": {
          "$dmId": {
            ".read": "auth != null && $dmId.contains(auth.uid)",
            ".write": "auth != null && $dmId.contains(auth.uid)",
            ".indexOn": ["timestamp"],
            "$messageId": {
              ".write": "auth != null && $dmId.contains(auth.uid)"
            }
          }
        },
        "dm_typing": {
          "$dmId": {
            ".read": "auth != null && $dmId.contains(auth.uid)",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && $dmId.contains(auth.uid)"
            }
          }
        },
        "dm_readReceipts": {
          "$dmId": {
            ".read": "auth != null && $dmId.contains(auth.uid)",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && $dmId.contains(auth.uid)"
            }
          }
        },
        "users": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}