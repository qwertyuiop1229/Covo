    try {
      const { ref, set } = await import('../vendor/firebase/firebase-database.js');
      const rtdb = await _getOrInitRTDB();
      await set(ref(rtdb, `artifacts/${appId}/latestAnnouncement`), {
        id: docRef.id,
        version,
        title,
        category,
        content,
        publishedAt: Date.now()
      });
