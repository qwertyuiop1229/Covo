  <!-- 🛡️ システムリカバリー＆過去バージョン復旧パネル -->
  <div id="emergencyRecoveryOverlay" class="fixed inset-0 modal-overlay flex items-center justify-center hidden p-4" style="z-index:999999;backdrop-filter:blur(25px);background:rgba(15,23,42,0.85);">
    <div class="bg-gray-900 border border-red-500/30 rounded-3xl shadow-2xl w-full max-w-2xl overflow-hidden p-6 flex flex-col space-y-6 animate-pop-in text-white max-h-[90dvh]">
      <div class="flex items-center justify-between border-b border-gray-800 pb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl bg-red-500/20 border border-red-500/40 flex items-center justify-center text-red-500 text-2xl animate-pulse">
            <i class="fas fa-exclamation-triangle"></i>
