    const isAdmin = await isAppAdmin(appId, verifiedUser, env);
    if (!isAdmin) {
       return new Response(JSON.stringify({ error: "Forbidden: Not an Admin" }), { status: 403, headers: { ...cors, 'Content-Type': 'application/json' } });
    }
    const kvStats = {
      fileCount: 0,
      totalBytes: 0,
      categories: {
        images: { bytes: 0, count: 0, label: "画像", color: "#3b82f6" },
        videos: { bytes: 0, count: 0, label: "動画・音声", color: "#a855f7" },
        documents: { bytes: 0, count: 0, label: "書類・PDF", color: "#f59e0b" },
        avatars: { bytes: 0, count: 0, label: "アイコン", color: "#10b981" },
