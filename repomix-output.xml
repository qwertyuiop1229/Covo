  for (const part of parts) {
    if (BLOCKED_EXTENSIONS.has(part)) {
      alertMessage(`セキュリティ保護のため、実行可能形式または危険な拡張子 (.${part}) を含むファイルは送信できません`, "error");
      return false;
    }
