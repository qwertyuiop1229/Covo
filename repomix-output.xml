  try {
    const newRoomRef = await addDoc(collection(db, `artifacts/${appId}/servers/${destinationServerId}/rooms`), {
      name, categoryId, channelType, createdAt: serverTimestamp(), createdBy: userId, currentKeyVersion: 1
    });
