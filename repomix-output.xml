      _ringMasterGain.gain.setValueAtTime(0, 0);
      _ringMasterGain.disconnect();
    } catch (_) {}
    _ringMasterGain = null;
  }
  if (_ringActiveNodes && _ringActiveNodes.length > 0) {
    _ringActiveNodes.forEach(node => {
      try {
