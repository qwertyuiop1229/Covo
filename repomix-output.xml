    .dark-server-theme .mention-option:hover .mention-option-sub, .dark-server-theme .mention-option.active .mention-option-sub, .dark .mention-option:hover .mention-option-sub, .dark .mention-option.active .mention-option-sub {
      color: #cbd5e1;
    }
    /* === 通話オーバーレイ === */
    @keyframes callPulse {
      0%, 100% { transform: scale(1); opacity: 0.7; }
      50% { transform: scale(1.18); opacity: 0.3; }
    }
    @keyframes callSlideIn {
      from { transform: translateY(100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    @keyframes callFadeOut {
      from { transform: translateY(0); opacity: 1; }
      to { transform: translateY(100%); opacity: 0; }
    }

    #callOverlay {
      position: fixed;
      inset: 0;
      z-index: 100000;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f2544 100%);
      padding: var(--safe-top, max(24px, env(safe-area-inset-top, 0px))) var(--safe-right, env(safe-area-inset-right, 0px)) max(24px, var(--safe-bottom, env(safe-area-inset-bottom, 0px))) var(--safe-left, env(safe-area-inset-left, 0px));
      gap: 0;
    }
    #callOverlay.show {
