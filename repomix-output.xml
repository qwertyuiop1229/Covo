/* ===== カスタムスクロールバー（全要素共通・矢印ボタン完全非表示）===== */
    * {
      scrollbar-width: thin;
      scrollbar-color: rgba(0,0,0,0.18) transparent;
    }
    *::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    *::-webkit-scrollbar-button {
      display: none !important;
      width: 0 !important;
      height: 0 !important;
    }
    *::-webkit-scrollbar-track {
      background: transparent;
    }
    *::-webkit-scrollbar-thumb {
      background: rgba(0,0,0,0.18);
      border-radius: 100px;
    }
    *::-webkit-scrollbar-thumb:hover {
      background: rgba(0,0,0,0.32);
    }
    *::-webkit-scrollbar-corner {
      background: transparent;
    }

    /* モーダル背景 */
    .modal-overlay {
      background-color: rgba(0, 0, 0, 0.75);
    }

    /* ドロップダウンコンテナのスタイル */
    .dropdown-container {
      position: relative;
      display: inline-block;
    }

    .dropdown-content {
      display: none;
      position: absolute;
      background-color: white;
      min-width: 100px;
      box-shadow: 0px 4px 8px 0px rgba(0, 0, 0, 0.2);
      z-index: 10;
      right: 0;
      border-radius: 0.5rem;
      overflow: hidden;
      border: 1px solid #ddd;
    }

    .dropdown-content button {
      color: black;
      padding: 8px 12px;
      text-decoration: none;
      display: block;
      width: 100%;
      text-align: left;
      border: none;
      background-color: transparent;
      cursor: pointer;
      transition: background-color 0.2s;
      font-size: 0.875rem;
    }

    .dropdown-content button:hover {
      background-color: #f0f0f0;
    }

    /* メッセージ内容と入力欄 */
    .message-content {
      white-space: pre-wrap;
      word-wrap: break-word;
      word-break: break-word;
    }

    textarea#messageInput {
      white-space: pre-wrap;
      word-wrap: break-word;
      word-break: break-word;
      overflow-y: auto;
      resize: none;
      min-height: 0;
      max-height: 200px;
      background-color: transparent;
      border: none;
      font-size: 16px;
      line-height: 1.5;

      /* ★スクロールバーを非表示にする設定 */
      -ms-overflow-style: none;
      /* IE and Edge */
      scrollbar-width: none;
      /* Firefox */
    }

    /* ★Chrome, Safari, Opera用 */
    textarea#messageInput::-webkit-scrollbar {
      display: none;
    }

    textarea#messageInput:focus {
      background-color: transparent;
      outline: none;
    }

    /* 既読表示 */
    .read-receipt {
      font-size: 0.7rem;
      color: #888;
      margin-top: 2px;
      display: block;
      text-align: right;
    }

    .other-message .read-receipt {
      text-align: left;
    }

    /* 未読の境界線（「ここから未読」） */
    .unread-divider {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      margin: 6px 0 2px;
      padding: 0 4px;
      color: #ef4444;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      user-select: none;
    }
    .unread-divider::before,
    .unread-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: currentColor;
      opacity: 0.35;
    }
    body.dark-server-theme .unread-divider { color: #f87171; }

    /* カスタムコンテキストメニュー */
    .custom-context-menu {
      position: fixed;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      z-index: 100;
      flex-direction: column;
      gap: 6px;
      min-width: 120px;
    }
    .custom-context-menu:not(.hidden) {
      display: flex;
    }
    .custom-context-menu-inner {
      background-color: white;
      border: 1px solid #ddd;
      border-radius: 0.5rem;
      box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
      padding: 4px 0;
      overflow: hidden;
    }

    .custom-context-menu button {
      display: block;
      width: 100%;
      padding: 8px 12px;
      text-align: left;
      background: none;
      border: none;
      cursor: pointer;
      font-size: 0.875rem;
      color: black;
    }

    .custom-context-menu button:hover {
      background-color: #f0f0f0;
    }

    /* サイドバーリサイズ用ハンドル */
    #resizer, #resizerRight {
      width: 2px;
      cursor: col-resize;
      background-color: #e5e7eb;
      transition: background-color 0.2s;
      flex-shrink: 0;
    }

    #resizer:hover, #resizerRight:hover {
      background-color: #d1d5db;
    }

    /* リプライ機能用CSS (Discord風L字ライン) - merged above */
    .reply-quote:hover {
      text-decoration: underline;
      text-decoration-color: #94a3b8;
      text-underline-offset: 2px;
    }

    .reply-quote-nickname {
      font-weight: 600;
      color: #475569;
      flex-shrink: 0;
      max-width: 40%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
