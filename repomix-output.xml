/* アプリ全体の基底スタイル（全画面固定・文字選択制御・スクロール基盤の一本化） */
    html, body {
      height: 100%;
      width: 100%;
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      overflow: hidden;
      overscroll-behavior: none;
      touch-action: pan-x pan-y;
      background-color: #ffffff;
      font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      transition: none !important;
    }
    html.dark-server-theme, body.dark-server-theme, html:has(body.dark-server-theme) {
      background-color: #111827 !important;
    }

    /* 入力フィールドでのみ文字選択を許可 */
    textarea,
    input[type="text"],
    input[type="email"],
    input[type="password"],
    input[type="number"],
    .select-all,
    [contenteditable="true"] {
      -webkit-user-select: text;
      -moz-user-select: text;
      -ms-user-select: text;
      user-select: text;
    }

    .container {
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      height: 100dvh;
      max-width: none;
      margin: 0;
      padding: 0;
      border-radius: 0;
      overflow: hidden;
      background-color: #ffffff;
      box-shadow: none;
    }
    /* モーダル・オーバーレイの正規全画面配置（-100pxハックを廃止しスクロールズレを防止） */
    .modal-overlay, #bottomSheetOverlay, #loadingOverlay, #updateOverlay, #dropOverlay {
      top: 0 !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      padding: 0 !important;
    }
    /* iOSでのタップ時強制ズーム回避のため、テキスト入力要素のみ16px以上に固定 */
    input:not([type="range"]):not([type="checkbox"]):not([type="radio"]),
    textarea,
    select {
      font-size: 16px !important;
    }
    .stamp-jump-anim {
      animation: stampWiggle 0.8s ease-in-out;
    }
    @keyframes stampWiggle {
      0%, 100% { transform: translateX(0); }
      15% { transform: translateX(-10px) rotate(-5deg); }
      30% { transform: translateX(8px) rotate(3deg); }
      45% { transform: translateX(-6px) rotate(-2deg); }
      60% { transform: translateX(4px) rotate(1deg); }
      75% { transform: translateX(-2px); }
