<file path="public/css/modules/sidebar.css">
/* --- メンバーリスト・プロフィール・アクティブパネル用スタイル (Discord完全準拠) --- */
    #membersSidebar {
      width: 320px;
      min-width: 260px;
      max-width: 360px;
      background-color: #f2f3f5;
      border-left: 1px solid #e5e7eb;
