/* === PWAインストールバナー === */
    #pwaInstallBanner {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 9998;
      background: linear-gradient(135deg, #1e293b, #334155);
