<file path="firestore.rules">
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- ユーティリティ関数 ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGlobalAdmin(appId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList) &&
        (
          ('emails' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data && 'email' in request.auth.token && request.auth.token.email in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data.emails) ||
          ('admins' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data.admins)
        );
    }

    function isListAdmin(appId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList) &&
        (
          ('emails' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data && 'email' in request.auth.token && request.auth.token.email in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data.emails) ||
          ('admins' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data.admins)
        );
    }

    function isServerAdmin(appId, serverId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)) &&
        (request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data.serverAdmins
          || isGlobalAdmin(appId));
    }

    function isJoinedServer(appId, serverId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)) &&
        (request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data.joinedUsers
          || isGlobalAdmin(appId));
    }

    // --- 各コレクションのルール ---

    match /artifacts/{appId} {

      // 1. 全体設定
      match /settings/{docId} {
        // allowedEmailsは機密情報が含まれるため、旧ドキュメントへのアクセスを禁止（新しく allowedEmails サブコレクションを使用）
        allow read: if (isAuthenticated() && docId != 'allowedEmails') || isGlobalAdmin(appId);
        allow write: if isGlobalAdmin(appId);
      }
      match /settings/allowedEmailsConfig {
        allow read: if isAuthenticated();
        allow write: if isListAdmin(appId) || isGlobalAdmin(appId);
      }
      
      // ログイン許可リストの新しいコレクション（サブコレクションとして管理）
      match /allowedEmails/{emailId} {
        // 全体管理者はフルアクセス。
        // 一般ユーザーはログイン時に「自分のメアド」のドキュメントだけ取得可能。
        // リスト管理者は「自分が追加したドキュメント」のみ読み書き可能。
        allow get: if isGlobalAdmin(appId) ||
                   (isAuthenticated() && request.auth.token.email == emailId) ||
                   (isListAdmin(appId) && resource.data.addedBy == request.auth.uid);
        allow list: if isGlobalAdmin(appId) ||
                    (isListAdmin(appId) && resource.data.addedBy == request.auth.uid);
        allow create: if isGlobalAdmin(appId) ||
                      (isListAdmin(appId) && request.resource.data.addedBy == request.auth.uid);
        allow update, delete: if isGlobalAdmin(appId) ||
                              (isListAdmin(appId) && resource.data.addedBy == request.auth.uid);
      }

      // 全体サーバーカスタムスタンプ
      match /server_stamps/{docId} {
        allow read: if isAuthenticated();
        allow write: if isGlobalAdmin(appId);
      }

      // バグ報告・フィードバック (サイズ制限と作成者バリデーションでDoS/改ざん防止)
      match /feedbacks/{docId} {
        allow create: if isAuthenticated() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 10000;
        allow read, update, delete: if isGlobalAdmin(appId);
      }

      // 全体お知らせ・リリースノート (What's New)
      match /announcements/{docId} {
        allow read: if isAuthenticated();
        allow write: if isGlobalAdmin(appId);
      }

      // 招待コードインデックス（コード→サーバーID の逆引き）
      // 認証済みユーザーなら読める、書き込みは認証済みユーザー（内容が正しくなくても実害なし）
      match /inviteIndex/{code} {
        allow get: if isAuthenticated();
        allow create: if isServerAdmin(appId, request.resource.data.serverId);
        allow update: if isServerAdmin(appId, resource.data.serverId) && isServerAdmin(appId, request.resource.data.serverId);
        allow delete: if isServerAdmin(appId, resource.data.serverId);
      }

      // 2. ユーザー情報
      match /users/{userId} {
        allow get: if isAuthenticated();
        allow list: if isGlobalAdmin(appId);
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // サーバー作成クォータ（本人のみ読み書き）
      match /userQuotas/{qUserId} {
        allow read: if isAuthenticated() && request.auth.uid == qUserId;
        allow write: if false; // クライアントからの直接更新を禁止
      }

      match /users/{userId}/profile/{docId} {
        allow get: if isAuthenticated();
        allow list: if isGlobalAdmin(appId);
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // E2EE 秘密鍵バックアップ: 本人のみ読み書き可（他者・未認証は一切読めない）
      match /users/{userId}/private/{docId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // 既読状態の同期
      match /users/{userId}/readStates/{docId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // 3. グローバルオンライン状態
      match /status/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      // 4. P2P音声通話シグナリング
      match /calls/{callId} {
        allow read, delete: if isAuthenticated() &&
          (resource.data.caller.uid == request.auth.uid ||
           resource.data.callee.uid == request.auth.uid ||
           resource.data.calleeUid == request.auth.uid);
        allow update: if isAuthenticated() &&
          (resource.data.caller.uid == request.auth.uid ||
           resource.data.callee.uid == request.auth.uid ||
           resource.data.calleeUid == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['caller', 'callee', 'calleeUid']);
        allow create: if isAuthenticated() &&
          request.resource.data.caller.uid == request.auth.uid;
        match /callerCandidates/{candId} {
          allow read, create, delete: if isAuthenticated() &&
            (get(/databases/$(database)/documents/artifacts/$(appId)/calls/$(callId)).data.caller.uid == request.auth.uid ||
             get(/databases/$(database)/documents/artifacts/$(appId)/calls/$(callId)).data.calleeUid == request.auth.uid);
        }
        match /calleeCandidates/{candId} {
          allow read, create, delete: if isAuthenticated() &&
            (get(/databases/$(database)/documents/artifacts/$(appId)/calls/$(callId)).data.caller.uid == request.auth.uid ||
             get(/databases/$(database)/documents/artifacts/$(appId)/calls/$(callId)).data.calleeUid == request.auth.uid);
        }
      }

      // 4b. P2Pファイル共有シグナリング（本体はP2P。ここはofferやICE候補だけ）
      match /fileshares/{shareId} {
        allow read, delete: if isAuthenticated() &&
          (resource.data.sender.uid == request.auth.uid ||
           resource.data.receiverUid == request.auth.uid);
        allow update: if isAuthenticated() &&
          (resource.data.sender.uid == request.auth.uid ||
           resource.data.receiverUid == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sender', 'receiverUid']);
        allow create: if isAuthenticated() &&
          request.resource.data.sender.uid == request.auth.uid;
        match /senderCandidates/{candId} {
          allow read, create, delete: if isAuthenticated() &&
            (get(/databases/$(database)/documents/artifacts/$(appId)/fileshares/$(shareId)).data.sender.uid == request.auth.uid ||
             get(/databases/$(database)/documents/artifacts/$(appId)/fileshares/$(shareId)).data.receiverUid == request.auth.uid);
        }
        match /receiverCandidates/{candId} {
          allow read, create, delete: if isAuthenticated() &&
            (get(/databases/$(database)/documents/artifacts/$(appId)/fileshares/$(shareId)).data.sender.uid == request.auth.uid ||
             get(/databases/$(database)/documents/artifacts/$(appId)/fileshares/$(shareId)).data.receiverUid == request.auth.uid);
        }
      }

      // ============================================================
      // サーバーベース構造
      // ============================================================

      match /servers/{serverId} {
        // 単一ドキュメント取得は認証済みユーザー全員に許可（参加時のID検索・パスワード照合のため）
        allow get: if isAuthenticated();
        // 一覧取得はグローバル管理者、または自分が joinedUsers に含まれるドキュメントのみ
        allow list: if isGlobalAdmin(appId) ||
          (isAuthenticated() && request.auth.uid in resource.data.joinedUsers);

        // サーバー作成: 参加者および管理者は作成者（自身）のみに限定する
        allow create: if isAuthenticated() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.serverAdmins == [request.auth.uid] &&
          request.resource.data.joinedUsers == [request.auth.uid];

        allow update: if (isServerAdmin(appId, serverId) || isGlobalAdmin(appId)) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']) || resource.data.createdBy == request.auth.uid);

        // 退出操作: 自分自身を joinedUsers/serverAdmins から削除する場合のみ
        allow update: if isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['joinedUsers', 'serverAdmins', 'memberCount']) &&
          request.auth.uid in resource.data.joinedUsers &&
          request.resource.data.joinedUsers == resource.data.joinedUsers.removeAll([request.auth.uid]) &&
          (!('serverAdmins' in resource.data) ? (!('serverAdmins' in request.resource.data)) : (request.resource.data.serverAdmins == resource.data.serverAdmins.removeAll([request.auth.uid]))) &&
          request.resource.data.memberCount == resource.data.memberCount - 1;

        // サーバー削除: グローバル管理者またはサーバー管理者
        allow delete: if isGlobalAdmin(appId) || isServerAdmin(appId, serverId);

        // サーバー内の秘密情報（管理者のみ）
        match /secrets/{docId} {
          allow read: if isServerAdmin(appId, serverId) || isGlobalAdmin(appId);
          allow create, update: if isServerAdmin(appId, serverId);
          allow delete: if isServerAdmin(appId, serverId) || isGlobalAdmin(appId);
        }

        // ルーム一覧
        match /rooms/{roomId} {
          allow read: if isJoinedServer(appId, serverId);
          allow create: if isServerAdmin(appId, serverId);
          allow update: if isServerAdmin(appId, serverId) || (
            isJoinedServer(appId, serverId) && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageSender', 'lastMessageText']) ||
              (!('sharedKey' in resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedKey', 'currentKeyVersion']))
            )
          );
          allow delete: if isServerAdmin(appId, serverId) || isGlobalAdmin(appId);

          // ルーム内メッセージ
          match /messages/{messageId} {
            allow read: if isJoinedServer(appId, serverId);
            allow create: if isJoinedServer(appId, serverId) &&
              request.resource.data.senderId == request.auth.uid;
            allow update: if isJoinedServer(appId, serverId) && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned'])
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'reactions'])
              || (resource.data.senderId == request.auth.uid
                  && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'createdAt', 'timestamp', 'isPinned']))
              || (isServerAdmin(appId, serverId)
                  && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'createdAt', 'timestamp']))
            );
            allow delete: if isJoinedServer(appId, serverId) &&
              (resource.data.senderId == request.auth.uid || isServerAdmin(appId, serverId));
          }

          // 既読レシート
          match /readReceipts/{receiptUserId} {
            allow read: if isJoinedServer(appId, serverId);
            allow create, update: if isJoinedServer(appId, serverId) &&
              request.auth.uid == receiptUserId;
            allow delete: if isJoinedServer(appId, serverId) &&
              (request.auth.uid == receiptUserId || isServerAdmin(appId, serverId));
          }

          // E2EE ルーム共通鍵（各メンバーの公開鍵で暗号化済み）
          // 参加メンバーなら読み取り可（自分宛の wrapped key を復号するため）。
          // 新規の鍵の作成（配布）は参加メンバーなら許可するが、上書き(update)や削除(delete)はサーバー管理者に限定。
          match /roomKeys/{keyId} {
            allow read: if isJoinedServer(appId, serverId);
            allow create: if isJoinedServer(appId, serverId);
            allow update, delete: if isServerAdmin(appId, serverId);
          }

          // E2EE 救済リクエスト（鍵の復号エラー時に自動自己治癒・鍵配布を要求）
          match /rescueRequests/{reqUserId} {
            allow read: if isJoinedServer(appId, serverId);
            allow create, update: if isJoinedServer(appId, serverId) && request.auth.uid == reqUserId;
            allow delete: if isJoinedServer(appId, serverId);
          }

          // タイピングインジケーター（サーバー参加者のみ）
          match /typing/{userId} {
            allow read: if isJoinedServer(appId, serverId);
            allow write: if isJoinedServer(appId, serverId) && request.auth.uid == userId;
          }
        }

        // サーバー別プロフィール
        match /profiles/{profileUserId} {
          allow read: if isJoinedServer(appId, serverId);
          allow create, update: if isJoinedServer(appId, serverId) &&
            request.auth.uid == profileUserId;
          allow delete: if isJoinedServer(appId, serverId) &&
            (request.auth.uid == profileUserId || isServerAdmin(appId, serverId));
        }

        // サーバーカスタムスタンプ
        match /stamps/{stampId} {
          allow read: if isJoinedServer(appId, serverId) || isServerAdmin(appId, serverId);
          allow create: if (isJoinedServer(appId, serverId) || isServerAdmin(appId, serverId)) &&
            request.resource.data.createdBy == request.auth.uid &&
            request.resource.data.name is string &&
            request.resource.data.url is string;
          // スタンプの削除・更新はサーバー管理者または全体管理者のみ可能
          allow delete: if (isJoinedServer(appId, serverId) || isServerAdmin(appId, serverId)) &&
            (isServerAdmin(appId, serverId) || isGlobalAdmin(appId));
          allow update: if (isJoinedServer(appId, serverId) || isServerAdmin(appId, serverId)) &&
            (isServerAdmin(appId, serverId) || isGlobalAdmin(appId));
        }

        // スタンプグループ（古い形式 / 拡張形式）
        match /stampGroups/{groupId} {
          allow read: if isJoinedServer(appId, serverId) || isServerAdmin(appId, serverId);
          allow create: if (isJoinedServer(appId, serverId) || isServerAdmin(appId, serverId)) &&
            request.resource.data.createdBy == request.auth.uid &&
            request.resource.data.name is string;
          allow delete, update: if (isJoinedServer(appId, serverId) || isServerAdmin(appId, serverId)) &&
            (isServerAdmin(appId, serverId) || isGlobalAdmin(appId));
        }

        // 招待コード
        match /inviteCodes/{code} {
          allow get: if isAuthenticated();
          allow list: if isServerAdmin(appId, serverId);
          allow write: if isServerAdmin(appId, serverId);
        }
      }
    }

  }
}
</file>

<file path="public/css/modules/sidebar.css">
/* --- メンバーリスト用スタイル (Discord風) --- */
    #membersSidebar {
      width: 240px;
      background-color: #f9fafb;
      border-left: 1px solid #e5e7eb;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }

    .member-group-title {
      font-size: 0.75rem;
      font-weight: 700;
      color: #9ca3af;
      text-transform: uppercase;
      padding: 1rem 1rem 0.5rem 1rem;
      letter-spacing: 0.05em;
    }

    .member-item {
      display: flex;
      align-items: center;
      padding: 0.5rem 1rem;
      cursor: pointer;
      transition: background-color 0.1s;
      border-radius: 0.25rem;
      margin: 0 0.5rem;
    }

    .member-item:hover {
      background-color: #e5e7eb;
    }

    .avatar-placeholder {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background-color: #374151;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.875rem;
      font-weight: 600;
      margin-right: 0.75rem;
      position: relative;
      flex-shrink: 0;
    }

    .avatar-placeholder img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }

    /* ステータスバッジ */
    .status-indicator {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      position: absolute;
      bottom: -1px;
      right: -1px;
      border: 2px solid #f9fafb;
      transition: all 0.2s ease-in-out;
    }

    .status-online {
      background-color: #22c55e;
    }

    .status-away {
      background-color: #facc15;
    }

    .status-offline {
      background-color: #9ca3af;
    }

    /* ダークモード時の目に優しい上品な発光インジケーター */
    body.dark-server-theme .status-indicator {
      border-color: #1f2937;
    }
    body.dark-server-theme .status-online {
      background-color: #10b981;
    }
    body.dark-server-theme .status-away {
      background-color: #fbbf24;
    }
    body.dark-server-theme .status-offline {
      background-color: #475569;
    }

    .member-info {
      flex: 1;
      overflow: hidden;
    }

    .member-name {
      font-size: 0.9rem;
      font-weight: 500;
      color: #1f2937;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .member-status-text {
      font-size: 0.7rem;
      color: #6b7280;
    }

