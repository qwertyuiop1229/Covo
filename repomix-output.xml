<file path="scripts/build_tailwind.mjs">
/**
 * build_tailwind.mjs
 * Tailwind CSS ビルドスクリプト
 *
 * 背景: Tailwind CLI (tailwindcss.cmd) は index.html (456KB) や main.js (1.5MB) を
 *       content スキャン対象にすると Node.js Zone Allocation OOM でクラッシュする。
 *       このスクリプトは PostCSS を直接呼び出し、事前生成済みの軽量スキャンファイル
 *       (tailwind.safelist.html) のみを参照してビルドする。
 *
 * 使用方法:
 *   node scripts/build_tailwind.mjs           # 通常ビルド
 *   node scripts/build_tailwind.mjs --regen   # safelist.html 再生成 + ビルド
 */
import fs from 'fs';
import path from 'path';
import { createRequire } from 'module';
import { fileURLToPath } from 'url';
const __dirname = path.dirname(fileURLToPath(import.meta.url));
const projectRoot = path.resolve(__dirname, '..');
const require = createRequire(import.meta.url);
const inputFile   = path.join(projectRoot, 'tailwind.input.css');
const outputFile  = path.join(projectRoot, 'public', 'css', 'styles.css');
const safelistFile = path.join(projectRoot, 'tailwind.safelist.html');
// --regen フラグで safelist.html を再生成
if (process.argv.includes('--regen')) {
  console.log('[1/2] Regenerating tailwind.safelist.html ...');
  const html = fs.readFileSync(path.join(projectRoot, 'public', 'index.html'), 'utf8');
  const js   = fs.readFileSync(path.join(projectRoot, 'public', 'js', 'main.js'), 'utf8');
  const allClasses = new Set();
  for (const match of html.matchAll(/class="([^"]+)"/g)) {
    for (const cls of match[1].split(/\s+/)) { if (cls.trim()) allClasses.add(cls.trim()); }
  }
  for (const match of js.matchAll(/className\s*[+=]\s*['"`]([^'"`]+)['"`]/g)) {
    for (const cls of match[1].split(/\s+/)) {
      if (cls.trim() && !cls.includes('${') && !cls.includes('+')) allClasses.add(cls.trim());
    }
  }
  for (const match of js.matchAll(/classList\.(add|remove|toggle)\(["']([^"']+)["']/g)) {
    for (const cls of match[2].split(/\s*,\s*/)) {
      const c = cls.replace(/['"]/g, '').trim(); if (c) allClasses.add(c);
    }
  }
  const classes = [...allClasses];
  let htmlOut = '<!DOCTYPE html><html><body>\n';
  for (let i = 0; i < classes.length; i += 200) {
    htmlOut += `<div class="${classes.slice(i, i + 200).join(' ')}"></div>\n`;
  }
  htmlOut += '</body></html>';
  fs.writeFileSync(safelistFile, htmlOut, 'utf8');
  console.log(`    -> ${allClasses.size} classes -> tailwind.safelist.html (${Math.round(htmlOut.length/1024)}KB)`);
}
// tailwind.safelist.html がなければ警告
if (!fs.existsSync(safelistFile)) {
  console.warn('WARNING: tailwind.safelist.html not found. Run with --regen to generate it.');
}
// PostCSS + Tailwind ビルド
const tailwindConfig = require(path.join(projectRoot, 'tailwind.config.js'));
const postcss    = require(path.join(projectRoot, 'node_modules', 'postcss'));
const tailwindcss = require(path.join(projectRoot, 'node_modules', 'tailwindcss'));
const inputCss = fs.readFileSync(inputFile, 'utf8');
console.log(process.argv.includes('--regen') ? '[2/2] Building Tailwind CSS...' : 'Building Tailwind CSS...');
const processor = postcss([tailwindcss(tailwindConfig)]);
processor.process(inputCss, { from: inputFile, to: outputFile })
  .then(result => {
    // シンプルminify (cssnanoがない環境用)
    let css = result.css;
    css = css.replace(/\/\*[\s\S]*?\*\//g, '');
    css = css.replace(/\s+/g, ' ');
    css = css.replace(/\s*\{\s*/g, '{');
    css = css.replace(/\s*\}\s*/g, '}');
    css = css.replace(/\s*:\s*/g, ':');
    css = css.replace(/\s*;\s*/g, ';');
    css = css.replace(/;}/g, '}');
    css = css.trim();
    fs.writeFileSync(outputFile, css, 'utf8');
    const size = fs.statSync(outputFile).size;
    console.log(`OK: styles.css (${Math.round(size / 1024)}KB)`);
    process.exit(0);
  })
  .catch(err => {
    console.error('Tailwind build error:', err.message || err);
    process.exit(1);
  });
</file>

<file path="scripts/check_secret_safety.mjs">
import {execFileSync} from 'node:child_process';
import {readFile,readdir,lstat} from 'node:fs/promises';
import {resolve,relative,basename,sep} from 'node:path';
import {fileURLToPath} from 'node:url';
const workspace=fileURLToPath(new URL('../',import.meta.url));
// This is a preventive guard, not a guarantee that every possible secret format is detectable.
export function sensitivePath(file) {
  const name=basename(file.replaceAll('\\','/')).toLowerCase();
  return /\.(pem|key|p8|p12|pfx|jwk|jks|keystore)$/.test(name) ||
    /^(\.env(?:\..*)?|\.dev\.vars(?:\..*)?|id_rsa|id_ed25519|id_ecdsa)$/.test(name) ||
    /^(?:.*service[-_]?account.*|client_secret.*|credentials(?:\..*)?)\.json$/.test(name);
}
export function secretContentKinds(buffer) {
  const text=buffer[0]===0xff&&buffer[1]===0xfe ? buffer.toString('utf16le') : buffer.toString('utf8');
  const kinds=[];
  if(/-----BEGIN ((?:RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY)-----(?:[A-Za-z0-9+/=\s]|\\[rn]){64,}-----END \1-----/.test(text))kinds.push('private-key-material');
  const decoded=text.replaceAll('\\"','"');
  if(/["']kty["']\s*:\s*["'](?:RSA|EC|OKP)["']/.test(decoded) && /["']d["']\s*:\s*["'][A-Za-z0-9_-]{24,}["']/.test(decoded))kinds.push('private-jwk');
  if(/\b(?:ghp_|gho_|ghu_|ghs_|ghr_)[A-Za-z0-9]{36,}\b|\bgithub_pat_[A-Za-z0-9_]{50,}\b|\bAKIA[0-9A-Z]{16}\b/.test(text))kinds.push('credential-token');
  const assignment=/(?:api_secret|client_secret|worker_auth_password|cloudflare_api_token|tauri_signing_private_key)["']?\s*[:=]\s*["']([^"'\r\n]{16,})["']/gi;
  for(const match of text.matchAll(assignment))if(!/^(?:\$\{|your[_ -]|replace[_ -]|example[_ -]|test[_ -]|dummy[_ -])/i.test(match[1])){kinds.push('credential-literal');break;}
  return [...new Set(kinds)];
}
async function publicFiles(directory) {
  let items;try{items=await readdir(directory,{withFileTypes:true});}catch(error){if(error.code==='ENOENT')return [];throw error;}
  return (await Promise.all(items.map(item=>item.isDirectory()?publicFiles(resolve(directory,item.name)):[resolve(directory,item.name)]))).flat();
}
export async function assertSecretSafety({root=workspace}={}) {
  root=resolve(root);const issues=[];
  const addable=execFileSync('git',['ls-files','-z','--cached','--others','--exclude-standard'],{cwd:root,encoding:'utf8',maxBuffer:16*1024*1024}).split('\0').filter(Boolean);
  const files=new Set(addable.map(file=>resolve(root,file)));
  const frontend=resolve(root,'public');
  for(const file of await publicFiles(frontend))files.add(file);
  for(const [name,extract] of [
    ['src-tauri/tauri.conf.json',config=>config.build?.frontendDist],
    ['firebase.json',config=>config.hosting?.public]
  ]){
    try{const file=resolve(root,name),config=JSON.parse(await readFile(file,'utf8')),dist=extract(config);
      if(dist && resolve(name.startsWith('src-tauri/')?resolve(root,'src-tauri'):root,dist)!==frontend)issues.push({file:name,kind:'unexpected-publication-root'});
    }catch(error){if(error.code!=='ENOENT')throw error;}
  }
  for(const file of files){
    if(!file.startsWith(root+sep)){issues.push({file:'[outside workspace]',kind:'unexpected-path'});continue;}
    const name=relative(root,file).replaceAll('\\','/');
    if(sensitivePath(name)){issues.push({file:name,kind:'sensitive-filename'});continue;}
    try{
      const info=await lstat(file);
      if(info.isSymbolicLink()){issues.push({file:name,kind:'publication-symlink'});continue;}
      if(!info.isFile())continue;
      const content=await readFile(file);
      for(const kind of secretContentKinds(content))issues.push({file:name,kind});
    }catch(error){if(error.code!=='ENOENT')throw error;}
  }
  if(issues.length){
    const summary=issues.map(issue=>`${issue.file.replace(/[\r\n\x00-\x1f]/g,'?')} (${issue.kind})`).join('\n');
    throw new Error('Potential secret material in Git/publication inputs. Values are hidden.\n'+summary);
  }
  return {checkedFiles:files.size};
}
if(process.argv[1] && resolve(process.argv[1])===fileURLToPath(import.meta.url)){
  assertSecretSafety().then(result=>console.log(`[secrets] Checked ${result.checkedFiles} Git/publication inputs; no blocked material found.`)).catch(error=>{console.error(error.message);process.exitCode=1;});
}
</file>

<file path="scripts/check-static.cjs">
const fs = require('fs');
const path = require('path');
const parser = require('@babel/parser');
const files = fs.readdirSync('public/js').filter(f => f.endsWith('.js')).map(f => `public/js/${f}`)
  .concat(['server/src/index.js', 'public/firebase-messaging-sw.js']);
const errors = [];
for (const file of files) {
  const tree = parser.parse(fs.readFileSync(file, 'utf8'), { sourceType: 'unambiguous' });
  for (const imp of tree.program.body.filter(n => n.type === 'ImportDeclaration' && n.source.value.startsWith('.'))) {
    const target = path.resolve(path.dirname(file), imp.source.value.split('?')[0]);
    const targetTree = parser.parse(fs.readFileSync(target, 'utf8'), { sourceType: 'module' });
    const names = new Set(targetTree.program.body.filter(n => n.type === 'ExportNamedDeclaration').flatMap(n =>
      n.declaration ? (n.declaration.id ? [n.declaration.id.name] : n.declaration.declarations.map(d => d.id.name)) : n.specifiers.map(s => s.exported.name)));
    for (const spec of imp.specifiers.filter(s => s.type === 'ImportSpecifier')) {
      if (!names.has(spec.imported.name)) errors.push(`${file}: missing export ${spec.imported.name} in ${target}`);
    }
  }
}
if (errors.length) {
  console.error(errors.join('\n'));
  process.exitCode = 1;
} else {
  console.log(`Parsed ${files.length} JavaScript files; all local named imports resolve.`);
}
