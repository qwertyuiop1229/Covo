        <!-- 過去に使ったステータスメッセージ履歴 -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="block font-bold text-gray-600 dark:text-gray-300">過去に使ったステータス</label>
            <span id="customStatusHistoryCount" class="text-[10px] text-gray-400"></span>
          </div>
          <div id="customStatusHistoryContainer" class="flex flex-wrap gap-2 max-h-36 overflow-y-auto pr-1">
            <div id="customStatusHistoryEmpty" class="text-[11px] text-gray-400 dark:text-gray-500 py-1 italic">過去のステータス履歴はありません</div>
          </div>
        </div>
        <!-- ボタン群 -->
        <div class="flex items-center justify-end gap-3 pt-3 border-t border-gray-100 dark:border-white/5">
          <button type="button" onclick="closeCustomStatusModal()" class="px-4 py-2.5 rounded-xl font-bold text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-white/5 transition">
            キャンセル
          </button>
          <button type="submit" id="saveCustomStatusBtn" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-md transition active:scale-95">
            保存
          </button>
        </div>
      </form>
    </div>
  </div>
  <!-- 地理学習（隠し機能）用コンテナとスクリプト -->
  <div id="geoStudyContainer" class="hidden fixed inset-0 z-[9999999] bg-gray-900 flex-col overflow-hidden text-white"></div>
  <link rel="stylesheet" href="css/geo_study.css" />
  <script src="js/geo_study.js" defer></script>
  <!-- テキスト・コード用プレビューモーダル -->
  <div id="textFilePreviewModal" class="hidden fixed inset-0 bg-black/60 z-[9999] flex items-center justify-center p-3 sm:p-4 select-none" style="display:none;" onclick="if(event.target===this)window.closeTextFilePreview()">
    <div class="bg-white dark:bg-[#2b2d31] rounded-2xl shadow-2xl w-full max-w-3xl h-[85vh] flex flex-col overflow-hidden border border-gray-200 dark:border-[#1e1f22]" onclick="event.stopPropagation()">
      <div class="px-5 py-3.5 bg-gray-50 dark:bg-[#1e1f22] border-b border-gray-200 dark:border-white/5 flex items-center justify-between flex-shrink-0 select-none">
        <div class="flex items-center gap-2.5 min-w-0">
          <i class="fas fa-file-code text-indigo-500 text-sm"></i>
          <div class="min-w-0">
            <span id="textPreviewTitle" class="text-sm font-bold text-gray-800 dark:text-[#dbdee1] truncate block">ファイルプレビュー</span>
            <span id="textPreviewMeta" class="text-[10px] text-gray-400 font-mono">0 行</span>
          </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <button id="textPreviewCopyBtn" onclick="window.copyTextPreviewContent()" class="px-3 py-1.5 rounded-lg bg-gray-100 hover:bg-gray-200 dark:bg-white/10 dark:hover:bg-white/15 text-gray-700 dark:text-gray-200 text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer" title="テキストをコピー">
            <i class="far fa-copy text-xs"></i> <span>コピー</span>
          </button>
          <button id="textPreviewDownloadBtn" class="px-3 py-1.5 rounded-lg bg-[#5865F2] hover:bg-[#4752c4] text-white text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer" title="ダウンロード">
            <i class="fas fa-download text-xs"></i> <span>ダウンロード</span>
          </button>
          <button onclick="window.closeTextFilePreview()" class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-gray-600 dark:hover:text-white transition cursor-pointer" title="閉じる">
            <i class="fas fa-times text-sm"></i>
          </button>
        </div>
      </div>
      <div class="flex-1 flex overflow-hidden bg-gray-950 font-mono text-xs select-text">
        <div id="textPreviewLineNumbers" class="py-4 px-3 text-right text-gray-500 dark:text-gray-600 select-none border-r border-white/5 bg-black/20 leading-relaxed font-mono whitespace-pre flex-shrink-0">1</div>
        <pre class="flex-1 p-4 overflow-auto text-gray-200 leading-relaxed m-0 whitespace-pre"><code id="textPreviewCode" class="font-mono"></code></pre>
      </div>
    </div>
  </div>
  <!-- 音声ファイルプレビューモーダル -->
  <div id="audioPreviewModal" class="hidden fixed inset-0 bg-black/60 z-[9999] flex items-center justify-center p-4" style="display:none;" onclick="if(event.target===this)window.closeAudioPreviewModal()">
    <div class="bg-white dark:bg-[#2b2d31] rounded-2xl shadow-2xl w-full max-w-md p-4 relative">
      <div class="flex items-center justify-between mb-3">
        <span id="modalAudioTitle" class="text-sm font-bold text-gray-800 dark:text-[#dbdee1] truncate flex-1 mr-2">音楽ファイル</span>
        <button onclick="window.closeAudioPreviewModal()" class="w-7 h-7 flex items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-[#383a40] text-gray-400 hover:text-gray-700 dark:hover:text-white transition-colors flex-shrink-0" title="閉じる"><i class="fas fa-times text-sm"></i></button>
      </div>
      <div id="modalAudioPlayerContainer"></div>
    </div>
  </div>
</body>
</html>
