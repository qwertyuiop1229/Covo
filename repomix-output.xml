<file path="public/css/modules/sidebar.css">
/* --- メンバーリスト・プロフィール・アクティブパネル用スタイル (Discord完全準拠) --- */
    #membersSidebar {
      width: 320px;
      min-width: 260px;
      max-width: 360px;
      background-color: #f2f3f5;
      border-left: 1px solid #e5e7eb;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      position: relative;
    }
    body.dark-server-theme #membersSidebar {
      background-color: #111827 !important;
      border-left-color: rgba(255, 255, 255, 0.07) !important;
    }
    body.discord-dark-theme #membersSidebar {
      background-color: #232428 !important;
      border-left-color: #1f2023 !important;
    }
    .member-group-title {
      font-size: 0.75rem;
      font-weight: 700;
      color: #9ca3af;
      text-transform: uppercase;
      padding: 1rem 1rem 0.5rem 1rem;
      letter-spacing: 0.05em;
    }
    .member-item {
      display: flex;
      align-items: center;
      padding: 0.5rem 1rem;
      cursor: pointer;
      transition: background-color 0.1s;
      border-radius: 0.25rem;
      margin: 0 0.5rem;
    }
    .member-item:hover {
      background-color: #e5e7eb;
    }
    .avatar-placeholder {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background-color: #374151;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.875rem;
      font-weight: 600;
      margin-right: 0.75rem;
      position: relative;
      flex-shrink: 0;
    }
    .avatar-placeholder img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 50%;
    }
    /* ステータスバッジ */
    .status-indicator {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      position: absolute;
      bottom: -1px;
      right: -1px;
      border: 2px solid #f9fafb;
      transition: all 0.2s ease-in-out;
      z-index: 20;
    }
    .status-online {
      background-color: #22c55e;
    }
    .status-away {
      background-color: #facc15;
    }
    .status-offline {
      background-color: #9ca3af;
    }
    /* ダークモード時の目に優しい上品な発光インジケーター */
    body.dark-server-theme .status-indicator {
      border-color: #1f2937;
    }
    body.dark-server-theme .status-online {
      background-color: #10b981;
    }
    body.dark-server-theme .status-away {
      background-color: #fbbf24;
    }
    body.dark-server-theme .status-offline {
      background-color: #475569;
    }
    .member-info {
      flex: 1;
      overflow: hidden;
    }
    .member-name {
      font-size: 0.9rem;
      font-weight: 500;
      color: #1f2937;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .member-status-text {
      font-size: 0.7rem;
      color: #6b7280;
    }
    /* サーバーヘッダー & ルームタイトル */
#serverHeader {
  background-color: #ffffff;
  border-bottom: 1px solid #e2e8f0;
  color: #0f172a;
  border-top-left-radius: 12px !important;
}
#serverNameDisplay {
  color: #0f172a !important;
  font-weight: 800;
}
#serverHeader .fa-chevron-right {
  color: #94a3b8 !important;
}
#serverSettingsBtn {
  color: #64748b !important;
}
#serverSettingsBtn:hover {
  color: #0f172a !important;
}
/* ルームヘッダー タイトル視認性向上 */
#currentRoomTitleText {
  color: #0f172a;
}
#currentRoomIcon {
  color: #64748b;
}
body.dark-server-theme #currentRoomTitleText,
body.discord-dark-theme #currentRoomTitleText {
  color: #f8fafc !important;
}
body.dark-server-theme #currentRoomIcon,
body.discord-dark-theme #currentRoomIcon {
  color: #94a3b8 !important;
}
body:not(.dark-server-theme):not(.discord-dark-theme) #currentRoomTitleText {
  color: #0f172a !important;
}
body:not(.dark-server-theme):not(.discord-dark-theme) #currentRoomIcon {
  color: #64748b !important;
}
/* ユーザーパネル (Discord風マイページ input_file_3.png 角丸カード準拠) */
#userPanel {
  background-color: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  padding: 0 0.75rem;
  height: 58px;
  min-height: 58px;
  display: flex;
  align-items: center;
  border-radius: 1rem !important; /* 角丸を完全に復元 */
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}
body.dark-server-theme #userPanel {
  background-color: #162032 !important;
  border-color: rgba(255, 255, 255, 0.08) !important;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35) !important;
}
body.discord-dark-theme #userPanel {
  background-color: #2b2d31 !important;
  border-color: #383a40 !important;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35) !important;
}
/* PC DiscordUIモード時: 左端のサーバー一覧レール(72px)の下まで横に大きく伸ばす */
@media (min-width: 769px) {
  body.discord-ui-mode #discordServerNav {
    padding-bottom: 78px !important; /* サーバー追加ボタンと探索ボタンをuserPanelの直上に配置して被りを防止 */
    z-index: 20 !important;
  }
  body.discord-ui-mode #sidebar {
    z-index: 35 !important;
    overflow: visible !important; /* userPanelの左端アバターがサーバー一覧に切り落とされるのを完全防止 */
  }
  body.discord-ui-mode #sidebar #userPanel {
    position: absolute !important;
    bottom: 8px !important;
    left: -64px !important; /* 左のサーバーナビの下まで伸びて画面左端から8pxの位置にフィット */
    right: 8px !important;  /* サイドバー右端から8pxの位置 */
    width: auto !important;
    z-index: 50 !important;
    border-radius: 1rem !important; /* 角丸を美しく維持 */
    margin: 0 !important;
  }
}
.user-panel-info {
  flex: 1;
  overflow: hidden;
  margin-left: 0.35rem;
  margin-right: 0.25rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2px;
}
.user-panel-name {
  font-size: 0.85rem;
  font-weight: 700;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.2;
}
body.dark-server-theme .user-panel-name {
  color: #f8fafc !important;
}
body.discord-dark-theme .user-panel-name {
  color: #f2f3f5 !important;
}
.user-panel-id {
  font-size: 0.72rem;
  font-weight: 500;
  color: #64748b;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
body.dark-server-theme .user-panel-id {
  color: #94a3b8 !important;
}
body.discord-dark-theme .user-panel-id {
  color: #949ba4 !important;
}
/* ミュート・スピーカーオフ コントロール (Discord input_file_2.png 準拠) */
.user-panel-ctrl-btn, .user-panel-chevron-btn {
  background: transparent;
  border: none;
  cursor: pointer;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.user-panel-ctrl-btn.is-muted #userPanelMicIcon,
.user-panel-ctrl-btn.is-muted #userPanelMicSlash,
.user-panel-ctrl-btn.is-deafened #userPanelDeafenIcon,
.user-panel-ctrl-btn.is-deafened #userPanelDeafenSlash {
  color: #da373c !important;
}
.user-panel-ctrl-btn.is-muted #userPanelMicSlash,
.user-panel-ctrl-btn.is-deafened #userPanelDeafenSlash {
  display: flex !important;
}
.user-panel-ctrl-btn.is-muted,
.user-panel-ctrl-btn.is-deafened {
  background-color: rgba(218, 55, 60, 0.12) !important;
}
.user-panel-ctrl-btn.is-muted:hover,
.user-panel-ctrl-btn.is-deafened:hover {
  background-color: rgba(218, 55, 60, 0.22) !important;
}
/* Discord風 音声クイックメニュー */
.user-audio-quick-menu {
  animation: notifSlideInUp 0.18s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
#openSettingsBtn {
  color: #64748b;
  transition: all 0.15s ease;
  border-radius: 0.375rem;
}
#openSettingsBtn:hover {
  color: #0f172a;
  background-color: rgba(0, 0, 0, 0.08);
}
body.dark-server-theme #openSettingsBtn:hover,
body.discord-dark-theme #openSettingsBtn:hover {
  color: #ffffff !important;
  background-color: rgba(255, 255, 255, 0.1) !important;
}
    /* スマホ対応CSS - LINE風UI（ブレークポイントを768pxに統一） */
    @media (max-width: 768px) {
      body {
        padding: 0;
      }
      .container>div {
        flex-direction: column;
      }
      #appContainer {
        flex-direction: column;
        position: relative;
      }
      #sidebar {
        width: 100% !important;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 10;
        background: white;
      }
      #resizer, #resizerRight {
        display: none;
      }
      #membersSidebar {
        display: none;
      }
      /* サイドバーが非表示時はチャットエリアがフル表示 */
      #sidebar.mobile-hidden {
        display: none !important;
      }
      #roomList {
        flex: 1;
        overflow-y: auto;
        border-bottom: none;
      }
      #messagesDisplay {
        flex: 1;
        min-height: 0;
      }
      .my-message,
      .other-message {
        max-width: 85%;
      }
      /* スマホではユーザーパネルを大きく */
      #userPanel {
        padding: 1rem;
      }
      /* スマホ用の戻るボタン */
      #mobileBackButton {
        display: flex !important;
      }
      /* スマホ入力欄: 下部Safe Area（ホームバー）を自然に吸収し、無駄な余白をゼロに */
      #messageInputArea {
        border-top: 0 none !important;
        border-top-width: 0 !important;
        border-bottom: 0 none !important;
        padding-top: 0.5rem !important;
        padding-bottom: max(10px, env(safe-area-inset-bottom, 0px)) !important;
        margin-bottom: 0 !important;
        background-color: #ffffff !important;
        box-shadow: none !important;
        flex-shrink: 0 !important;
      }
      /* 入力欄とボトムナビの境目に出る影・線を完全に除去 */
      #messageInputArea::before,
      #messageInputArea::after {
        display: none !important;
        box-shadow: none !important;
      }
      #mobileBottomNav {
        box-shadow: none !important;
        border-top: 0 none !important;
        border: 0 none !important;
      }
      /* チャットエリア下端の影も念のため消す */
      #chatArea {
        box-shadow: none !important;
      }
      /* mobile: 入力フィールド・サイドボタンの影を消す */
      #messageInputInner,
      #messageInputInner:focus-within,
      .input-side-btn,
      .input-side-btn:hover,
      .input-side-btn:active,
      .input-side-btn:focus {
        box-shadow: none !important;
      }
      /* mobile: 入力ボックスの枠線（黒っぽい線に見えていた1.5px border）を消し、
         薄グレー背景で形を保つ。枠線が無いので影/線が一切出ない。
         ファイル添付ボタンと高さ・縦位置を完全に揃えるため min-height を固定し中央寄せ。 */
      #messageInputInner,
      #messageInputInner:focus-within {
        border: 0 none !important;
        background: #f3f4f6 !important;
        min-height: 42px;
        align-items: center;
      }
      body.dark-server-theme #messageInputInner,
      body.dark-server-theme #messageInputInner:focus-within {
        background: #0f172a !important;
      }
      /* 入力欄が1行のときボタンと天地が揃うよう、行は中央揃えにする */
      #messageInputArea .flex.items-end {
        align-items: center !important;
      }
      /* mobile: ファイル添付・スタンプボタンのアスペクト比と位置を整流 */
      #fileAttachButton, #stickerButton, #plusMenuButton, #sendMessageButton {
        border: 0 none !important;
        box-shadow: none !important;
        width: 44px !important;
        height: 44px !important;
        aspect-ratio: 1 / 1 !important;
        border-radius: 8px !important;
      }
      #fileAttachButton, #stickerButton, #plusMenuButton {
        background: #f3f4f6 !important;
        color: #6b7280 !important;
      }
      #fileAttachButton:disabled, #stickerButton:disabled, #plusMenuButton:disabled {
        background: #f3f4f6 !important;
        color: #c4c8ce !important;
      }
      body.dark-server-theme #fileAttachButton, body.dark-server-theme #stickerButton, body.dark-server-theme #plusMenuButton {
        background: #0f172a !important;
        color: #94a3b8 !important;
      }
      body.dark-server-theme #fileAttachButton:disabled, body.dark-server-theme #stickerButton:disabled, body.dark-server-theme #plusMenuButton:disabled {
        background: #0f172a !important;
        color: #475569 !important;
      }
      /* ダークモード時はチャット背景の#1a202cに合わせる */
      body.dark-server-theme #messageInputArea {
        background-color: #1a202c !important;
      }
      /* mobile: userPanel上の境界線を消し、背景をsidebarと同色にして影感を消す */
      #userPanel {
        border-top: none !important;
        background-color: #f3f4f6 !important;
      }
      /* iPhoneでの勝手なズーム拡大を防止 */
      input,
      textarea,
      select {
        font-size: 16px !important;
      }
      /* メンバー一覧のボトムシート対応 */
      #bottomSheetOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 40;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      #bottomSheetOverlay.show {
        display: block;
        opacity: 1;
      }
      #membersSidebar {
        display: flex !important;
        /* Tailwindの hidden md:flex を上書き */
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 70vh;
        background-color: white;
        z-index: 50;
        border-radius: 1rem 1rem 0 0;
        /* box-shadow は閉じている時に上向きの影が画面下部(ナビ付近)へ漏れて
