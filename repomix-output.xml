        try { opened.close(); } catch (_) {}
        if (generation !== _accountGeneration) return;
        _dbInstance = null;
        _dbInitPromise = null;
      };
      _dbInstance.onclose = () => {
        if (generation !== _accountGeneration) return;
        _dbInstance = null;
        _dbInitPromise = null;
      };
      resolve(_dbInstance);
    };
    req.onerror = () => {
      if (generation !== _accountGeneration) { resolve(null); return; }
      console.warn("[LocalStore] Failed to open IndexedDB:", req.error);
      _dbInstance = null;
      _dbInitPromise = null;
      resolve(null);
