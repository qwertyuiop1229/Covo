export const CLIENT_PROTOCOL = 2;
export const MINIMUM_WINDOWS_VERSION = '1.1.282';
export function supportsWindowsVersion(version) {
  const match = /^v?(\d+)\.(\d+)\.(\d+)$/.exec(String(version));
