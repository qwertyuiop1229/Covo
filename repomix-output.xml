      }
      const msgCheckUrl = `${rtdbBase.replace(/\/$/, '')}/artifacts/${appId}/dm_messages/${dmId}/${messageId}.json?access_token=${rtdbToken}`;
      const msgCheckRes = await fetch(msgCheckUrl, { headers: { 'X-Firebase-ETag': 'true' } });
