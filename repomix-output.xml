      background: #1e1f22;
      border-color: rgba(255,255,255,0.1);
      color: #dbdee1;
    }
    .covo-select-options {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      left: auto;
      min-width: 190px;
      max-width: min(90vw, 290px);
      width: max-content;
      background: white;
      border-radius: 12px;
      padding: 6px;
      box-shadow: 0 10px 25px -5px rgba(0,0,0,0.2), 0 8px 10px -6px rgba(0,0,0,0.1);
      border: 1px solid #e2e8f0;
      z-index: 100;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px) scale(0.96);
      transition: all 0.18s cubic-bezier(0.34, 1.2, 0.64, 1);
    }
    .covo-custom-select.open .covo-select-options {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }
    body.dark-server-theme .covo-select-options {
      background: #1e293b;
      border-color: rgba(255,255,255,0.12);
    }
    body.discord-dark-theme .covo-select-options {
