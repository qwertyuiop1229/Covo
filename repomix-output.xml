    await env.DB.prepare('UPDATE app_control SET enabled = 1, revision = revision + 1, locked_until = ? WHERE id = ?').bind(Date.now() + 60000, env.FIREBASE_APP_ID).run();
    await writeMaintenanceMirrors(env, true).catch(() => {});
