<file path="public/css/modules/base.css">
/* アプリ全体の基底スタイル（全画面固定・文字選択制御・スクロール基盤の一本化） */
    :root {
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --safe-left: env(safe-area-inset-left, 0px);
      --safe-right: env(safe-area-inset-right, 0px);
    }
    html, body {
      height: 100%;
      width: 100%;
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      overflow: hidden;
      overscroll-behavior: none;
      touch-action: pan-x pan-y;
      background-color: #ffffff;
      font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
      transition: none !important;
    }
    html.dark-server-theme, body.dark-server-theme, html:has(body.dark-server-theme) {
      background-color: #111827 !important;
    }
    /* 入力フィールドでのみ文字選択を許可 */
    textarea,
    input[type="text"],
    input[type="email"],
    input[type="password"],
    input[type="number"],
    .select-all,
    [contenteditable="true"] {
      -webkit-user-select: text;
      -moz-user-select: text;
      -ms-user-select: text;
      user-select: text;
    }
    .container {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      margin: 0;
      padding: 0;
      border-radius: 0;
      overflow: hidden;
      background-color: #ffffff;
      box-shadow: none;
    }
    /* モーダル・オーバーレイの正規全画面配置（-100pxハックを廃止しスクロールズレを防止） */
    .modal-overlay, #bottomSheetOverlay, #loadingOverlay, #updateOverlay, #dropOverlay {
      top: 0 !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      padding: 0 !important;
    }
    /* iOSでのタップ時強制ズーム回避のため、テキスト入力要素のみ16px以上に固定 */
    input:not([type="range"]):not([type="checkbox"]):not([type="radio"]),
    textarea,
    select {
      font-size: 16px !important;
    }
    /* スタンプ用 LINE完全準拠の滑らかなスウェイ揺動（優しく揺れて穏やかに収束） */
    .stamp-jump-anim {
      animation: stampSway 0.85s cubic-bezier(0.2, 0.8, 0.25, 1) both !important;
      will-change: transform;
    }
    @keyframes stampSway {
      0%   { transform: translateX(0); }
      15%  { transform: translateX(5.5px); }
      32%  { transform: translateX(-3.8px); }
      48%  { transform: translateX(2.2px); }
      64%  { transform: translateX(-1.1px); }
      80%  { transform: translateX(0.4px); }
      100% { transform: translateX(0); }
    }
    /* 通常メッセージ用 LINE完全準拠の滑らかなスウェイ揺動（横にゆるやかになめらかにゆすって緩やかに終了） */
    .message-jump-anim,
    .message-bubble.message-jump-anim {
      animation: messageSway 0.85s cubic-bezier(0.2, 0.8, 0.25, 1) both !important;
      will-change: transform;
    }
    @keyframes messageSway {
      0%   { transform: translateX(0); }
      15%  { transform: translateX(5.5px); }
      32%  { transform: translateX(-3.8px); }
      48%  { transform: translateX(2.2px); }
      64%  { transform: translateX(-1.1px); }
      80%  { transform: translateX(0.4px); }
      100% { transform: translateX(0); }
    }
    /* Reactions */
    .reaction-picker-bar {
      display: flex;
      gap: 8px;
      padding: 8px 12px;
      background: white;
      border: 1px solid #ddd;
      border-radius: 9999px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.15);
      align-items: center;
      justify-content: center;
      margin-bottom: 2px;
    }
    .reaction-picker-bar.scrollable {
      justify-content: flex-start;
      overflow-x: auto;
      border-radius: 12px;
      max-width: 100%;
    }
    .reaction-picker-bar.scrollable::-webkit-scrollbar {
      display: none;
    }
    body.dark-server-theme .reaction-picker-bar,
    body.discord-dark-theme .reaction-picker-bar {
      background: #1e293b;
      border-color: rgba(255,255,255,0.1);
      box-shadow: 0 4px 24px rgba(0,0,0,0.5);
    }
    body.discord-dark-theme .reaction-picker-bar {
      background: #2b2d31;
      border-color: #383a40;
    }
    .reaction-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.2s, background-color 0.2s;
      cursor: pointer;
    }
    .reaction-btn:hover {
      transform: scale(1.2);
      background-color: #f3f4f6;
    }
    body.dark-server-theme .reaction-btn:hover,
    body.discord-dark-theme .reaction-btn:hover {
      background-color: #334155;
    }
    body.discord-dark-theme .reaction-btn:hover {
      background-color: #35373c;
    }
    .reaction-btn img.emoji {
      width: 24px;
      height: 24px;
      pointer-events: none;
    }
    .reaction-more-btn {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6b7280;
      background: #f3f4f6;
      transition: background-color 0.2s;
      cursor: pointer;
    }
    .reaction-more-btn:hover {
      background-color: #e5e7eb;
    }
    body.dark-server-theme .reaction-more-btn {
      background-color: #334155;
      color: #cbd5e1;
    }
    body.dark-server-theme .reaction-more-btn:hover {
      background-color: #475569;
    }
    .reactions-container {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      position: relative;
      margin-top: 6px;
      margin-bottom: -2px;
      z-index: 20;
    }
    .my-message .reactions-container {
      justify-content: flex-end;
    }
    .other-message .reactions-container {
      justify-content: flex-start;
    }
    .date-divider {
      text-align: center;
      margin: 1.5rem 0;
      width: 100%;
    }
    .date-divider-inner, #floatingDateBadge {
      display: inline-block;
      padding: 4px 16px;
      background-color: rgba(71, 85, 105, 0.85);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: 500;
      border-radius: 9999px;
      box-shadow: none;
      border: none;
      line-height: 1.25rem;
      letter-spacing: 0.05em;
      transition: opacity 0.3s ease;
    }
    body.dark-server-theme .date-divider-inner,
    body.dark-server-theme #floatingDateBadge,
    body.discord-dark-theme .date-divider-inner,
    body.discord-dark-theme #floatingDateBadge {
      background-color: rgba(51, 65, 85, 0.85);
      color: #ffffff;
      border: none;
      box-shadow: none;
    }
    body.discord-dark-theme .date-divider-inner,
    body.discord-dark-theme #floatingDateBadge {
      background-color: rgba(43, 45, 49, 0.9);
      color: #dbdee1;
    }
    .reaction-modal-emoji img {
      width: 28px !important;
      height: 28px !important;
      object-fit: contain;
    }
   .reply-quote {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background-color: transparent;
      padding: 2px 0 2px 28px;
      margin-bottom: 4px;
      cursor: pointer;
      font-size: 0.8rem;
      color: #64748b;
      max-width: 100%;
      min-width: 0;
      overflow: hidden;
      box-sizing: border-box;
    }
    .reply-quote::before {
      content: "";
      position: absolute;
      left: 12px;
      top: 50%;
      height: 12px;
      width: 12px;
      border-left: 2px solid #9ca3af;
      border-top: 2px solid #9ca3af;
      border-top-left-radius: 6px;
    }
    .my-reply {
      padding: 2px 28px 2px 0;
      justify-content: flex-end;
      max-width: 100%;
      min-width: 0;
    }
    .my-reply::before {
      left: auto;
      right: 12px;
      border-left: none;
