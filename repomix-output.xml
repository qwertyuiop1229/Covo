      const isDesktop = Boolean(window.__TAURI__) || Boolean(window.__TAURI_INTERNALS__) || location.origin.includes('localhost') || location.protocol === 'tauri:';
      const desktopView = document.getElementById('emergencyDesktopView');
      const webView = document.getElementById('emergencyWebView');
      const modalTitle = document.getElementById('emergencyModalTitle');
      const modalSub = document.getElementById('emergencyModalSubtitle');
      const headerIcon = document.getElementById('emergencyHeaderIcon');
      const stopReasonEl = document.getElementById('emergencyStopReasonText');
      if (isDesktop) {
        if (desktopView) desktopView.classList.remove('hidden');
        if (webView) webView.classList.add('hidden');
        if (modalTitle) modalTitle.textContent = "アプリケーション保守 / 安全停止中";
        if (modalSub) modalSub.textContent = "起動処理でエラーを検知しました。以下の操作で直前の安定版に戻すか、自動修復を行えます。";
        if (headerIcon) headerIcon.className = "fas fa-wrench";
        if (stopReasonEl && errMsg) {
          stopReasonEl.textContent = `停止理由: ${String(errMsg).slice(0, 180)} (直前のアップデートまたは一時的な破損の可能性があります)`;
        }
        // Windows版: 直前の安定版へのロールバック情報と修復確認をバックグラウンド実行
        emergencyAutoCheckUpdateAndRepair();
      } else {
        if (webView) webView.classList.remove('hidden');
        if (desktopView) desktopView.classList.add('hidden');
        if (modalTitle) modalTitle.textContent = "サービス一時待機 / メンテナンス中";
        if (modalSub) modalSub.textContent = "現在サーバーのメンテナンスを行っているか、一時的に通信が不安定な状態です。管理者が対応しておりますので、しばらくそのままお待ちください。";
        if (headerIcon) headerIcon.className = "fas fa-circle-info";
        startWebAutoReconnectPolling();
      }
      panel.classList.remove('hidden');
      panel.style.display = 'flex';
      const detailArea = document.getElementById('emergencyErrorDetail');
      if (detailArea && errMsg) {
        detailArea.value = `発生時刻: ${new Date().toLocaleString()}\nメッセージ: ${errMsg}\n詳細スタック: ${errObj ? (errObj.stack || JSON.stringify(errObj)) : 'なし'}`;
      }
    };
    // 1つ前の安定バージョンへ戻す (ロールバック実行)
    window.emergencyRollbackToPreviousVersion = async function(btn) {
      if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>直前の安定版を取得中...'; }
      const invoke = window.__TAURI__?.core?.invoke;
      try {
        let curVer = "1.0.0";
        try {
          const vRes = await fetch("version.json", { cache: "no-store" });
          if (vRes.ok) curVer = (await vRes.json()).version || curVer;
        } catch (_) {}
        const ghRes = await fetch('https://api.github.com/repos/qwertyuiop1229/Covo/releases?per_page=10', { cache: 'no-store' });
        if (!ghRes.ok) throw new Error(`GitHub API error: ${ghRes.status}`);
        const releases = await ghRes.json();
        // 現在のバージョンより前の直前の安定版リリースを特定
        const cleanCur = curVer.replace(/^v/i, '').trim();
        let targetPrevRel = null;
        for (let i = 0; i < releases.length; i++) {
          const relTag = (releases[i].tag_name || "").replace(/^v/i, '').trim();
          const hasExe = releases[i].assets?.some(a => a.name?.endsWith(".exe"));
          if (hasExe) {
            if (relTag === cleanCur) {
              // 現在バージョンの次の要素が1つ前
              if (i + 1 < releases.length) targetPrevRel = releases[i + 1];
              break;
            } else if (window.isSemverNewer(cleanCur, relTag) && !targetPrevRel) {
              targetPrevRel = releases[i];
              break;
            }
          }
        }
        if (!targetPrevRel && releases.length > 1) {
          targetPrevRel = releases[1]; // フォールバック: リストの2番目
        }
        if (!targetPrevRel) throw new Error("直前の安定版リリースが見つかりませんでした");
        const exeAsset = targetPrevRel.assets?.find(a => a.name?.endsWith(".exe"));
        if (!exeAsset || !exeAsset.browser_download_url) throw new Error("インストーラー (.exe) が見つかりませんでした");
        const prevTag = targetPrevRel.tag_name;
        // ロールバック使用中フラグとバージョンロックをセット（起動時の再クラッシュ防止）
        localStorage.setItem('covo_rolled_back_from_ver', curVer);
        localStorage.setItem('covo_ignore_force_update', '1');
        if (btn) btn.innerHTML = `<i class="fas fa-spinner fa-spin mr-1"></i>${prevTag} をダウンロード中...`;
        if (invoke) {
          await invoke('silent_install_past_version', { url: exeAsset.browser_download_url, tag: prevTag });
          if (btn) btn.innerHTML = `<i class="fas fa-check text-emerald-400"></i> ${prevTag} へ復旧完了（再起動中...）`;
        } else {
          window.open(exeAsset.browser_download_url, '_blank');
          if (btn) { btn.disabled = false; btn.innerHTML = `ブラウザでダウンロード開始`; }
        }
      } catch (err) {
        alert("ロールバック失敗: " + (err.message || err));
        if (btn) { btn.disabled = false; btn.innerHTML = `<i class="fas fa-clock-rotate-left"></i> 1つ前のバージョンに戻して起動`; }
      }
    };
    // Windows版: 自動バックグラウンドアップデート＆整合性修復ルーチン
    let _emergencyAutoCheckRunning = false;
    async function emergencyAutoCheckUpdateAndRepair() { const title=document.getElementById('emergencyAutoCheckTitle'); if(title)title.textContent='接続を確認してから操作を選択してください'; }
    // 手動操作アクション群 (Windows / Web)
    window.emergencyApplyLatestUpdate = async () => { await import('./js/desktop_runtime.js'); try { await window.covoCheckUpdate?.(true); } catch(error) { (await import('./js/recovery_runtime.js')).recoveryNotice(error.message); } };
    window.emergencyRunIntegrityRepair = async () => { await (await import('./js/recovery_runtime.js')).runRecoveryInspection(); };
    window.emergencyOpenRecoveryEngine = function() {
      const invoke = window.__TAURI__?.core?.invoke;
      if (invoke) {
        invoke('open_recovery_window').catch(() => {
          window.location.href = "recovery.html";
        });
      } else {
        window.location.href = "recovery.html";
      }
    };
    window.emergencyOpenLogFolder = function() {
      const invoke = window.__TAURI__?.core?.invoke;
      if (invoke) {
        invoke('open_log_dir').catch(e => alert('ログフォルダオープン失敗: ' + e));
      }
    };
    window.emergencyRestartApp = function() {
      const invoke = window.__TAURI__?.core?.invoke;
      if (invoke) {
        invoke('restart_app').catch(() => invoke('plugin:process|restart').catch(() => window.location.reload()));
      } else {
        window.location.reload();
      }
    };
    // Web版: バックエンド復旧自動検知・自動リロードタイマー (Discord / Slack 準拠)
    let _webReconnectTimer = null;
    function startWebAutoReconnectPolling() { /* Firebase's live connection resumes without reloading the app. */ }
    window.emergencyReloadWeb = function() {
      window.location.reload();
    };
    window.emergencyClearCacheWeb = async () => { await (await import('./js/recovery_runtime.js')).runRecoveryInspection(); };
    // リカバリーボタン用先行フォールバック定義 (ReferenceError防止)
    if (typeof window.openPastVersionsModal !== 'function') {
      window.openPastVersionsModal = function() {
        const modal = document.getElementById('pastVersionsModal');
        if (modal) { modal.classList.remove('hidden'); modal.style.display = 'flex'; }
        if (typeof window.loadPastVersionsPage === 'function') window.loadPastVersionsPage(1);
      };
    }
    if (typeof window.closePastVersionsModal !== 'function') {
      window.closePastVersionsModal = function() {
        const modal = document.getElementById('pastVersionsModal');
        if (modal) { modal.classList.add('hidden'); modal.style.display = 'none'; }
      };
    }
    if (typeof window.emergencyCheckUpdate !== 'function') {
      window.emergencyCheckUpdate = async function(btn) {
        if (btn) btn.textContent = '確認中...';
        await emergencyAutoCheckUpdateAndRepair();
        if (btn) btn.textContent = '更新をチェック';
      };
    }
    window._earlyErrors = window._earlyErrors || [];
    window._covoLogs = window._covoLogs || [];
    // ネイティブコンソール関数の退避
    if (!window.__covo_native_console__) {
      window.__covo_native_console__ = {
        log: console.log.bind(console),
        warn: console.warn.bind(console),
        error: console.error.bind(console),
        info: (console.info || console.log).bind(console),
        debug: (console.debug || console.log).bind(console)
      };
    }
    // 共通ログ追加関数（直近同一メッセージの二重登録・多重ループを完全排除）
    window._pushCovoLog = function(type, text) {
      if (!text) return;
      const line = `[${type}] ${text}`;
      const logs = window._covoLogs || [];
      if (logs.length > 0 && logs[logs.length - 1] === line) {
        return;
      }
      logs.push(line);
      if (logs.length > 300) logs.shift();
      window._covoLogs = logs;
      try {
        sessionStorage.setItem('covo_recent_logs', JSON.stringify(logs.slice(-100)));
      } catch (_) {}
      const panel = document.getElementById('devConsolePanel');
      if (panel && panel.style.display === 'flex' && typeof window.__appendConsoleLine === 'function') {
        window.__appendConsoleLine(line);
      }
      const streamBody = document.getElementById('reportsConsoleStreamBody');
      if (streamBody && streamBody.offsetParent !== null) {
        const div = document.createElement('div');
        div.className = line.startsWith('[ERR]') ? 'text-rose-400' : line.startsWith('[WARN]') ? 'text-amber-400' : 'text-blue-300';
        div.textContent = line;
        if (streamBody.querySelector('.text-gray-500')) streamBody.innerHTML = '';
        streamBody.appendChild(div);
        streamBody.scrollTop = streamBody.scrollHeight;
      }
    };
    // 🛡️ 超初期・クラッシュ時でも 100% クラウド (RTDB) にエラーを即時記録する軽量ダイレクトビーコン
    window._sendEarlyTelemetry = function(type, message, stack) {
      try {
        if (_isIgnoredEarlyError(message, '', stack)) return;
        const normType = String(type || 'error').toLowerCase();
        const msgStr = String(message || 'Unknown Error').substring(0, 3000);
        const stackStr = String(stack || '').substring(0, 6000);
        let hash = 0;
        const rawSig = `${normType}:::${msgStr.substring(0, 200)}:::${stackStr.substring(0, 200)}`;
        for (let i = 0; i < rawSig.length; i++) {
          hash = ((hash << 5) - hash) + rawSig.charCodeAt(i);
          hash |= 0;
        }
        const signature = 'err_' + Math.abs(hash).toString(36);
        const payload = {
          id: signature,
          signature: signature,
          type: normType,
          message: msgStr,
          stack: stackStr,
          lastOccurredAt: Date.now(),
          count: 1,
          affectedEmails: ['未初期化/起動前'],
          environment: { userAgent: navigator.userAgent || 'unknown', appVersion: 'boot_early', screenSize: `${window.innerWidth}x${window.innerHeight}` }
        };
        // 1. RTDB REST API (PUT) へ直接書き込み (.write: true なので即座に全端末へ届く)
        const rtdbUrl = `https://simplechat-65a0d-default-rtdb.asia-southeast1.firebasedatabase.app/artifacts/simplechat-65a0d/error_reports/${signature}.json`;
        fetch(rtdbUrl, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        }).catch(() => {});
        // 2. Worker API 経由でもバックアップ送信
        fetch('https://simplechat-api.astro-fray-server.workers.dev/api/reportError', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ appId: 'simplechat-65a0d', signature, payload }),
          keepalive: true
        }).catch(() => {});
      } catch (_) {}
    };
    function _extractErrorDetails(args) {
      let stack = '';
      let msgParts = [];
      for (const a of args) {
        if (a instanceof Error) {
          if (!stack && a.stack) stack = a.stack;
          msgParts.push(a.message || a.stack || String(a));
        } else if (typeof a === 'object') {
          try {
            msgParts.push(JSON.stringify(a));
          } catch (_) {
            msgParts.push(String(a));
          }
        } else {
          msgParts.push(String(a));
        }
      }
      return { message: msgParts.join(' '), stack: stack || '' };
    }
    // コンソールの先行フック（二重フックを完全防止 & スタックトレース抽出）
    // コンソールの先行フック（二重フックを完全防止 & スタックトレース抽出）
    if (!window.__covo_console_hooked__) {
      window.__covo_console_hooked__ = true;
      function isAppScriptError(msg, stack, src) {
        const str = `${msg || ''} ${stack || ''} ${src || ''}`.toLowerCase();
        return str.includes('main.js') ||
               str.includes('crypto_helpers.js') ||
               str.includes('local_store.js') ||
               str.includes('text_formatter.js') ||
               str.includes('ui_helpers.js') ||
               str.includes('debug_ui.js') ||
               str.includes('file_uploader.js') ||
               str.includes('index.html');
      }
      console.warn = function(...args) {
        const { message: msg, stack } = _extractErrorDetails(args);
        const isIgnored = _isIgnoredEarlyError(msg, '', stack) && !isAppScriptError(msg, stack, '');
        if (isIgnored) return; // 拡張機能やAdBlockの外部ノイズは完全に消音
        window._pushCovoLog('WARN', msg);
        if (typeof window._reportTelemetryError === 'function') {
          window._reportTelemetryError('warn', msg, stack);
        } else {
          if (window._earlyErrors.length < 50) window._earlyErrors.push({ type: 'warn', message: msg, stack, time: Date.now() });
          window._sendEarlyTelemetry('warn', msg, stack);
        }
        window.__covo_native_console__.warn.apply(console, args);
      };
      console.error = function(...args) {
        const { message: msg, stack } = _extractErrorDetails(args);
        const isIgnored = _isIgnoredEarlyError(msg, '', stack) && !isAppScriptError(msg, stack, '');
        if (isIgnored) return; // 拡張機能やAdBlockの外部ノイズは完全に消音
        window._pushCovoLog('ERR', msg);
        if (typeof window._reportTelemetryError === 'function') {
          window._reportTelemetryError('error', msg, stack);
        } else {
          if (window._earlyErrors.length < 50) window._earlyErrors.push({ type: 'error', message: msg, stack, time: Date.now() });
          window._sendEarlyTelemetry('error', msg, stack);
        }
        window.__covo_native_console__.error.apply(console, args);
      };
      console.log = function(...args) {
        const msg = args.map(a => (typeof a === 'object' ? JSON.stringify(a) : String(a))).join(' ');
        window._pushCovoLog('INFO', msg);
        window.__covo_native_console__.log.apply(console, args);
      };
    }
    // エラーリスナーの先行登録（二重登録を完全防止 & 100% 漏れなく即時収集）
    if (!window.__covo_error_listeners_attached__) {
      window.__covo_error_listeners_attached__ = true;
      function isAppScriptError(msg, stack, src) {
        const str = `${msg || ''} ${stack || ''} ${src || ''}`.toLowerCase();
        return str.includes('main.js') ||
               str.includes('crypto_helpers.js') ||
               str.includes('local_store.js') ||
               str.includes('text_formatter.js') ||
               str.includes('ui_helpers.js') ||
               str.includes('debug_ui.js') ||
               str.includes('file_uploader.js') ||
               str.includes('index.html');
      }
      window.addEventListener('error', function(e) {
        const isApp = isAppScriptError(e.message, e.error?.stack, e.filename);
        const isExt = !isApp && _isIgnoredEarlyError(e.message, e.filename, e.error);
        if (isExt) {
          try { e.preventDefault(); e.stopPropagation(); } catch (_) {}
          return; // 拡張機能のエラーはコンソール・ログ・画面へ出さずに完全消音
        }
        const msg = e.message || (e.error && e.error.message) || 'JavaScript 実行エラー';
        const stack = (e.error && e.error.stack) || `${e.filename || ''}:${e.lineno || ''}:${e.colno || ''}`;
        const logLine = `${msg} (${e.filename || 'unknown'}:${e.lineno || 0})`;
        window._pushCovoLog('ERR', logLine);
        if (typeof window._reportTelemetryError === 'function') {
          window._reportTelemetryError('error', msg, stack);
        } else {
          if (window._earlyErrors.length < 50) window._earlyErrors.push({ type: 'error', message: msg, stack: stack, time: Date.now() });
          window._sendEarlyTelemetry('error', msg, stack);
        }
        if (!window.__app_fully_loaded__ && document.visibilityState === 'visible') {
          showEmergencyRecoveryPanel(msg, e.error);
        }
      });
      window.addEventListener('unhandledrejection', function(e) {
        const r = e.reason;
        const msg = (r && r.message) || String(r || '非同期処理エラー (Unhandled Rejection)');
        const stack = (r && r.stack) || '';
        const isApp = isAppScriptError(msg, stack, '');
        const isExt = !isApp && _isIgnoredEarlyError(msg, '', r);
        if (isExt) {
          try { e.preventDefault(); e.stopPropagation(); } catch (_) {}
          return; // 拡張機能のエラーはコンソール・ログ・画面へ出さずに完全消音
        }
        // ネットワーク切断やブラウザ一時停止などのノイズも消音
        if (_isIgnoredEarlyError(msg, '', r)) {
          try { e.preventDefault(); } catch (_) {}
          return;
        }
        const logLine = `Uncaught (in promise) ${msg}`;
        window._pushCovoLog('ERR', logLine);
        if (typeof window._reportTelemetryError === 'function') {
          window._reportTelemetryError('unhandledrejection', msg, stack);
        } else {
          if (window._earlyErrors.length < 50) window._earlyErrors.push({ type: 'unhandledrejection', message: msg, stack: stack, time: Date.now() });
          window._sendEarlyTelemetry('unhandledrejection', msg, stack);
        }
        if (!window.__app_fully_loaded__ && document.visibilityState === 'visible') {
          showEmergencyRecoveryPanel(msg, e.reason);
        }
      });
    }
    // 起動スプラッシュのセーフティタイマー（auth-ready確定まで画面を維持し、タイトルバー浮き上がり・真っ暗フリーズを完全防止）
    setTimeout(function() {
      const splash = document.getElementById("appLoadingSplash");
      if (splash && document.body.classList.contains("auth-ready")) {
        splash.style.opacity = '0';
        setTimeout(function() { splash.remove(); }, 300);
      }
    }, 1200);
    setTimeout(function() {
      const splash = document.getElementById("appLoadingSplash");
      if (splash && document.body.classList.contains("auth-ready")) {
        splash.style.opacity = '0';
        setTimeout(function() { splash.remove(); }, 300);
      }
    }, 3000);
    // 最大セーフティ（通信遮断やオフライン時に8秒でフォールバック消去）
    setTimeout(function() {
      const splash = document.getElementById("appLoadingSplash");
      if (splash) {
        splash.style.opacity = '0';
        setTimeout(function() { splash.remove(); }, 300);
      }
    }, 8000);
    // フォールバック（Safari等でIndexedDBや通信待機が長引いた場合、12秒でログイン画面を先行表示し真っ白フリーズを解除）
    setTimeout(function() {
      const isAnyUiShown = document.body.classList.contains("auth-ready") ||
                           document.getElementById("serverListScreen")?.classList.contains("hidden") === false ||
                           document.getElementById("appContainer")?.classList.contains("hidden") === false ||
                           document.getElementById("authContainer")?.classList.contains("hidden") === false ||
                           document.getElementById("emergencyRecoveryOverlay")?.classList.contains("hidden") === false;
      if (!isAnyUiShown) {
        const authContainer = document.getElementById("authContainer");
        if (authContainer) {
          authContainer.classList.remove("hidden");
          console.warn('[Watchdog] 起動待機が長時間に及んだため、ログイン画面を先行表示しました。');
        }
      }
    }, 12000);
    setTimeout(function() {
      const isUiVisible = document.body.classList.contains("auth-ready") ||
                          document.getElementById("serverListScreen")?.classList.contains("hidden") === false ||
                          document.getElementById("appContainer")?.classList.contains("hidden") === false ||
                          document.getElementById("authContainer")?.classList.contains("hidden") === false;
      if (!window.__app_fully_loaded__ && document.visibilityState === 'visible' && !isUiVisible) {
        console.warn('[Watchdog Timer] アプリ起動完了タイムアウトを確認しました。リカバリーパネルを展開します。');
        showEmergencyRecoveryPanel('アプリ起動完了タイムアウト（通信遮断またはネットワーク遅延の可能性）', null);
      }
    }, 28000);
  </script>
