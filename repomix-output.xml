/* スプラッシュ画面のスマホUI視覚的中央補正（ダイナミックアイランド・ノッチ・ステータスバー相殺） */
.splash-icon-container {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}
@media (max-width: 768px) {
  .splash-icon-container {
    transform: translateY(calc(-28px - (env(safe-area-inset-top, 0px) * 0.35))) !important;
  }
}
/* === サーバーリスト画面 === */
    #serverListScreen {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #f3f4f6;
      overflow-y: auto;
    }
    #serverListScreen.hidden {
      display: none !important;
    }
    /* === アニメーション定義 === */
    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
    @keyframes slideUpFade {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes scaleInFade {
      from {
        opacity: 0;
        transform: scale(0.96) translateY(6px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }
    @keyframes cardIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .anim-fade-in {
      animation: fadeIn 0.18s ease both;
    }
    .anim-slide-up {
      animation: slideUpFade 0.22s ease both;
    }
    .anim-scale-in {
      animation: scaleInFade 0.22s ease both;
    }
    .anim-card {
      animation: cardIn 0.28s ease both;
      opacity: 0;
    }
    /* === サーバーリスト画面 === */
    .server-list-header {
      background: #1f2937;
      color: white;
      padding: 0.875rem 1.25rem;
      padding-top: calc(0.875rem + var(--safe-top, env(safe-area-inset-top, 0px)));
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }
    .server-list-title {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .server-list-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .server-list-actions button:not(.server-list-user-btn) {
      padding: 7px 13px;
      border: none;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.15s;
    }
    #joinServerBtn {
      background: rgba(255, 255, 255, 0.12);
      color: white;
    }
