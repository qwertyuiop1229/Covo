    #callButton:disabled, #fileShareButton:disabled { opacity: 0.35; cursor: not-allowed; }
    body.dark-server-theme #fileShareButton { color: #94a3b8; }
    body.dark-server-theme #fileShareButton:hover:not(:disabled) { color: #e2e8f0; }

    /* P2Pファイル共有: 進捗オーバーレイ */
    #fsProgressOverlay, #fsPreviewOverlay {
      position: fixed; inset: 0; z-index: 99999; display: none;
