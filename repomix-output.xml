      const myUser = (cachedUsers || []).find(u => u.id === userId);
      const isAwayOrOffline = !myUser || myUser.computedState === 'away' || myUser.computedState === 'offline' || myUser.state === 'away' || myUser.state === 'offline';
      if (isAwayOrOffline) {
        handleWindowFocus();
