    body.dark-server-theme .whatsnew-body-box {
      background-color: rgba(15, 23, 42, 0.6) !important;
      border-color: rgba(255, 255, 255, 0.06) !important;
      color: #cbd5e1 !important;
    }
    body.dark-server-theme .whatsnew-body-box a {
      color: #818cf8;
    }
    body.discord-dark-theme .whatsnew-body-box {
      background-color: #1e1f22 !important;
      border-color: #1f2023 !important;
      color: #dbdee1 !important;
    }
    body.discord-dark-theme .whatsnew-body-box a {
      color: #5865f2;
    }
    .whatsnew-footer {
      padding: 1rem 1.5rem;
      border-top: 1px solid #f1f5f9;
      display: flex;
      align-items: center;
