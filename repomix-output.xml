    /* ===== アプリ独自カスタムドロップダウン ===== */
    .covo-custom-select {
      position: relative;
      display: inline-block;
      user-select: none;
    }
    .covo-select-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 8px 14px;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      font-size: 0.82rem;
      font-weight: 600;
      color: #1e293b;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1);
    }
    .covo-select-trigger:hover {
      background: #e2e8f0;
      border-color: #94a3b8;
    }
