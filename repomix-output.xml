.covo-quick-switcher { position:fixed; z-index:100001; top:15vh; left:50%; transform:translateX(-50%); width:min(540px,calc(100vw - 24px)); max-height:70dvh; overflow:auto; padding:16px; border-radius:12px; background:var(--bg-primary,#fff); color:var(--text-primary,#111827); box-shadow:0 0 0 100vmax #0007,0 12px 40px #0005; }
