    }
    /* On mobile, hide the PC 2-column layout; use mobile full-screen instead */
    @media (max-width: 768px) {
      #settingsModal {
        display: none !important;
      }
      /* iOS PWA: body/htmlの背景をボトムナビと完全に同一色にしてツートン割れを根絶 */
      html, body {
        background-color: #0b0f19 !important;
      }
      /* DiscordUIモード(ライト)時 */
      body:not(.dark-server-theme):not(.discord-dark-theme).discord-ui-mode,
      html:has(body:not(.dark-server-theme):not(.discord-dark-theme).discord-ui-mode) {
        background-color: #ffffff !important;
      }
      /* ネイビーモード時 */
      body.dark-server-theme,
      html:has(body.dark-server-theme) {
        background-color: #0b0f19 !important;
      }
      /* Discordダーク時 */
      body.discord-dark-theme,
      html:has(body.discord-dark-theme) {
        background-color: #1e1f22 !important;
      }
      /* チャット画面時はチャット背景(白)と揃える */
      body.in-chat-view,
      html:has(body.in-chat-view) {
        background-color: #ffffff !important;
      }
      /* ダークモード+チャット時 */
      body.in-chat-view.dark-server-theme,
      html:has(body.in-chat-view.dark-server-theme) {
        background-color: #1a202c !important;
      }
      /* ボトムナビゲーション完全撤去により余白・ナビ背景色ルールを消去 */
      /* iOS Safari: フォーカス時の自動ズームを防ぐ（font-size 16px未満で発生） */
      input[type="text"],
      input[type="email"],
      input[type="password"],
      textarea {
        font-size: max(16px, 1em) !important;
      }
      /* コンテナ背景はbody側でoverscrollをカバーするため不要 */
      /* ローディング中の2層問題を解消:
         dark-server-theme時、#mainContent背景(#111827)がnavバー(#1f2937)と
         微妙に色が違うため2層に見える。モバイルでは#1f2937に統一する。 */
      body.dark-server-theme #mainContent,
      body.dark-server-theme .container {
        background-color: #1f2937 !important;
      }
      /* ★スマホUI専用：サーバー設定や作成画面を根本のデザインから一から作り直した、同等以上の質と洗練さを放つ究極のフルスクリーン仕様 */
      .modal-overlay:not(.hidden) {
        padding: 0 !important;
        margin: 0 !important;
        display: flex !important;
        align-items: flex-start !important;
        justify-content: flex-start !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100% !important;
        height: 100% !important;
      }
      /* 親コンテナの p-6 を強制解除し、隙間や段差を100%根絶 */
      .modal-overlay:not(.hidden) > div:not(.modal-box) {
        padding: 0 !important;
        margin: 0 !important;
        display: flex !important;
        align-items: flex-start !important;
        justify-content: flex-start !important;
        width: 100% !important;
        height: 100% !important;
      }
      /* モーダル本体を完璧なフルスクリーン・美しいネイティブビューへ大劇変（右クリックメニュー等を完全排除！） */
      .modal-overlay:not(.hidden) .modal-box, 
      #serverSettingsModal:not(.hidden) .modal-box, 
      #createServerModal:not(.hidden) .modal-box, 
      #joinServerModal:not(.hidden) .modal-box, 
      #settingsModal:not(.hidden) .modal-box,
      #joinRoomPasswordModal:not(.hidden) .modal-box,
      #adminJoinModal:not(.hidden) .modal-box {
        width: 100% !important;
        max-width: 100% !important;
        height: 100% !important;
        max-height: 100% !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        margin: 0 !important;
        padding: 0 !important; /* 内部ヘッダーとコンテンツエリアを全画面で美しく分けるため0にする */
        overflow-y: hidden !important; /* 親はスクロールさせず、内部のコンテンツエリアだけを気持ちよくスクロールさせる！ */
        display: flex; /* !importantを外すか、開いているモーダル内限定にするため完全安全！ */
        flex-direction: column !important;
        box-sizing: border-box !important;
        animation: mobileFullscreenOpen 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
        background: #f8fafc !important; /* スマホ設定画面にふさわしい、上品でモダンなスレート系ライト背景 */
      }
      body.dark-server-theme .modal-overlay:not(.hidden) .modal-box {
        background: #0f172a !important; /* ダークモード時は極上の重厚ダークスレート背景 */
      }
      /* 内部に専用ヘッダーを持たないモーダルは、親全体をスクロール可能にしてSafe Area余白を美しく確保 */
      /* ※確認ダイアログ・アラートダイアログは小型モーダルなのでフルスクリーン適用除外 */
      #createServerModal:not(.hidden) .modal-box,
      #joinServerModal:not(.hidden) .modal-box,
      #joinRoomPasswordModal:not(.hidden) .modal-box,
      #deleteRoomConfirmModal:not(.hidden) .modal-box {
        padding: var(--safe-top) 24px 90px 24px !important;
        overflow-y: auto !important;
        justify-content: center !important;
      }
      /* 確認・アラートダイアログ・ユーザープロフィール・ステメ・パスワード等: スマホUIでの全画面化・変形バグを完全解消 */
      #customConfirmModal:not(.hidden),
      #customAlertModal:not(.hidden),
      #messagePreviewModal:not(.hidden),
      #addServerSelectModal:not(.hidden),
      #customStatusModal:not(.hidden),
      #passwordResetModal:not(.hidden),
      #changePasswordModal:not(.hidden),
      #recoveryKeyManagerModal:not(.hidden),
      #feedbackModal:not(.hidden),
      #windowsDownloadModal:not(.hidden),
      #whatsNewModal:not(.hidden),
      #avatarLightbox:not(.hidden),
      #discordCallIncomingModal:not(.hidden) {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        padding: 16px !important;
        position: fixed !important;
        inset: 0 !important;
        z-index: 100005 !important;
      }
      #customConfirmModal:not(.hidden) .modal-box,
      #customAlertModal:not(.hidden) .modal-box,
      #messagePreviewModal:not(.hidden) .modal-box,
      #addServerSelectModal:not(.hidden) .modal-box,
      #passwordResetModal:not(.hidden) .modal-box,
      #changePasswordModal:not(.hidden) .modal-box,
      #recoveryKeyManagerModal:not(.hidden) .modal-box,
      #feedbackModal:not(.hidden) .modal-box,
      #windowsDownloadModal:not(.hidden) .modal-box,
      #whatsNewModal:not(.hidden) .modal-box,
      #avatarLightbox:not(.hidden) .modal-box,
      #discordCallIncomingModal:not(.hidden) .modal-box,
      #discordCallIncomingModal:not(.hidden) .discord-incoming-card {
        max-width: 380px !important;
        width: min(92vw, 380px) !important;
        padding: 20px !important;
        overflow-y: auto !important;
        justify-content: flex-start !important;
        animation: modalScaleUp 0.25s cubic-bezier(0.17, 0.84, 0.44, 1) forwards !important;
        border-radius: 1.5rem !important;
        min-height: unset !important;
        height: auto !important;
        max-height: min(88vh, calc(100dvh - 32px)) !important;
        position: relative !important;
        top: auto !important;
        left: auto !important;
        right: auto !important;
        bottom: auto !important;
        transform: none !important;
        margin: 0 auto !important;
        box-sizing: border-box !important;
      }
      /* 確認ダイアログ・アラートダイアログ等のボタンが iPhone / iOS で巨大化・縦伸び・変形するバグを徹底防止 */
      #customConfirmModal .confirm-box button,
      #customPromptModal .confirm-box button,
