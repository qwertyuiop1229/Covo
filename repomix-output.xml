                    let in_any_monitor = monitors.iter().any(|m| {
                        let mp = m.position();
                        let ms = m.size();
                        state.x >= mp.x - 50 && state.x < mp.x + ms.width as i32
                            && state.y >= mp.y - 50 && state.y < mp.y + ms.height as i32
