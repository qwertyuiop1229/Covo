    body.dark-server-theme .fs-prog-bar { background: #334155; }
    .fs-prog-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #3b82f6, #6366f1); transition: width 0.15s; }
    .fs-prog-pct { font-size: 0.8rem; font-weight: 700; margin-top: 8px; color: #3b82f6; }
    .fs-prog-cancel {
      margin-top: 16px; width: 100%; padding: 10px; border: none; border-radius: 12px;
      background: #f3f4f6; color: #6b7280; font-weight: 700; font-size: 0.85rem; cursor: pointer;
