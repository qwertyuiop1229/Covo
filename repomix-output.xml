              .bind(m.id, m.roomId, m.serverId, appId, m.senderId || verifiedUser.uid, m.text || "", m.createdAt || Date.now(), m.isPinned ? 1 : 0, JSON.stringify(m.reactions || {}), JSON.stringify(merged)));
