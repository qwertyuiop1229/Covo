      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    }

    .pinned-message-item:hover {
      background-color: #f1f5f9;
    }

    /* 未読バッジ（ルーム用・小さいドット） */
    .unread-badge {
      background-color: #4f46e5;
      width: 8px;
      height: 8px;
      min-width: 8px;
      border-radius: 50%;
      flex-shrink: 0;
      margin-left: auto;
      transition: background-color 0.2s, box-shadow 0.2s;
    }
    body.dark-server-theme .unread-badge,
    body.discord-dark-theme .unread-badge {
      background-color: #818cf8;
      box-shadow: 0 0 6px rgba(129, 140, 248, 0.45);
    }
    body.discord-dark-theme .unread-badge {
      background-color: #5865f2;
      box-shadow: 0 0 6px rgba(88, 101, 242, 0.45);
    }

    /* サーバーカード未読ドット */
    .server-card-unread-dot {
      position: absolute;
      top: 9px;
      right: 9px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #4f46e5;
      border: 2px solid white;
      transition: background-color 0.2s, border-color 0.2s, box-shadow 0.2s;
    }
    body.dark-server-theme .server-card-unread-dot,
    body.discord-dark-theme .server-card-unread-dot {
      background: #818cf8;
      border-color: #1e293b;
      box-shadow: 0 0 6px rgba(129, 140, 248, 0.45);
    }
    body.discord-dark-theme .server-card-unread-dot {
      background: #5865f2;
      border-color: #2b2d31;
      box-shadow: 0 0 6px rgba(88, 101, 242, 0.45);
    }

    /* 検索バー */
    #searchContainer {
      padding: 0.5rem;
      background: #f3f4f6;
      border-bottom: 1px solid #e5e7eb;
    }

    #searchContainer input {
      background-color: #fff;
      border: 1px solid #d1d5db;
      border-radius: 0.5rem;
      color: #374151;
      font-size: 16px;
      /* スマホでの自動拡大防止のため16pxに固定 */
