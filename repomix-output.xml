    /* スマホ対応CSS - LINE風UI（ブレークポイントを768pxに統一） */
    @media (max-width: 768px) {
      body {
        padding: 0;
      }

      .container>div {
        flex-direction: column;
      }

      #appContainer {
        flex-direction: column;
        position: relative;
      }

      #sidebar {
        width: 100% !important;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 10;
        background: white;
      }

      #resizer, #resizerRight {
        display: none;
      }

      #membersSidebar {
        display: none;
      }

      /* サイドバーが非表示時はチャットエリアがフル表示 */
      #sidebar.mobile-hidden {
        display: none !important;
      }

      #roomList {
        flex: 1;
        overflow-y: auto;
        border-bottom: none;
      }

      #messagesDisplay {
        flex: 1;
        min-height: 0;
      }

      .my-message,
      .other-message {
        max-width: 85%;
      }

      /* スマホではユーザーパネルを大きく */
      #userPanel {
        padding: 1rem;
      }

      /* スマホ用の戻るボタン */
      #mobileBackButton {
        display: flex !important;
      }

      /* スマホ入力欄: 下部Safe Area（ホームバー）を自然に吸収し、無駄な余白をゼロに */
      #messageInputArea {
        border-top: 0 none !important;
        border-top-width: 0 !important;
        border-bottom: 0 none !important;
        padding-top: 0.5rem !important;
        padding-bottom: max(10px, env(safe-area-inset-bottom, 0px)) !important;
        margin-bottom: 0 !important;
        background-color: #ffffff !important;
        box-shadow: none !important;
        flex-shrink: 0 !important;
      }
      /* 入力欄とボトムナビの境目に出る影・線を完全に除去 */
      #messageInputArea::before,
      #messageInputArea::after {
        display: none !important;
        box-shadow: none !important;
      }
      #mobileBottomNav {
        box-shadow: none !important;
        border-top: 0 none !important;
        border: 0 none !important;
      }
      /* チャットエリア下端の影も念のため消す */
      #chatArea {
        box-shadow: none !important;
      }
      /* mobile: 入力フィールド・サイドボタンの影を消す */
      #messageInputInner,
      #messageInputInner:focus-within,
      .input-side-btn,
      .input-side-btn:hover,
      .input-side-btn:active,
      .input-side-btn:focus {
        box-shadow: none !important;
      }
      /* mobile: 入力ボックスの枠線（黒っぽい線に見えていた1.5px border）を消し、
         薄グレー背景で形を保つ。枠線が無いので影/線が一切出ない。
         ファイル添付ボタンと高さ・縦位置を完全に揃えるため min-height を固定し中央寄せ。 */
      #messageInputInner,
      #messageInputInner:focus-within {
        border: 0 none !important;
        background: #f3f4f6 !important;
        min-height: 42px;
        align-items: center;
      }
      body.dark-server-theme #messageInputInner,
      body.dark-server-theme #messageInputInner:focus-within {
        background: #0f172a !important;
      }
      /* 入力欄が1行のときボタンと天地が揃うよう、行は中央揃えにする */
      #messageInputArea .flex.items-end {
        align-items: center !important;
      }
      /* mobile: ファイル添付ボタンを入力ボックスと同じ「枠線なし・薄グレー・同じ高さ」に統一。
         送信ボタン(.send-btn)は主要アクションなので対象外。 */
      #fileAttachButton, #stickerButton {
        border: 0 none !important;
        background: #f3f4f6 !important;
        box-shadow: none !important;
        color: #6b7280 !important;
        height: 42px !important;
      }
      #fileAttachButton:disabled, #stickerButton:disabled {
        background: #f3f4f6 !important;
        color: #c4c8ce !important;
      }
      body.dark-server-theme #fileAttachButton, body.dark-server-theme #stickerButton {
        background: #0f172a !important;
        color: #94a3b8 !important;
      }
      body.dark-server-theme #fileAttachButton:disabled, body.dark-server-theme #stickerButton:disabled {
        background: #0f172a !important;
        color: #475569 !important;
      }
      /* ダークモード時はチャット背景の#1a202cに合わせる */
      body.dark-server-theme #messageInputArea {
        background-color: #1a202c !important;
      }
      /* mobile: userPanel上の境界線を消し、背景をsidebarと同色にして影感を消す */
      #userPanel {
        border-top: none !important;
        background-color: #f3f4f6 !important;
      }

      /* iPhoneでの勝手なズーム拡大を防止 */
      input,
      textarea,
      select {
        font-size: 16px !important;
      }

      /* メンバー一覧のボトムシート対応 */
      #bottomSheetOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 40;
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      #bottomSheetOverlay.show {
        display: block;
        opacity: 1;
      }

      #membersSidebar {
        display: flex !important;
        /* Tailwindの hidden md:flex を上書き */
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 70vh;
        background-color: white;
        z-index: 50;
        border-radius: 1rem 1rem 0 0;
        /* box-shadow は閉じている時に上向きの影が画面下部(ナビ付近)へ漏れて
           黒っぽいグラデに見える原因だったため、開いている時だけ付与する。 */
        box-shadow: none;
        transform: translateY(100%);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        flex-direction: column;
        border-left: none;
        /* PC用のボーダーを消す */
      }

      #membersSidebar.bottom-sheet-open {
        transform: translateY(0);
        box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.1);
      }

      /* ボトムシートのドラッグハンドル */
      #bottomSheetHandle {
        display: flex;
        justify-content: center;
        padding: 12px 0;
        cursor: pointer;
        flex-shrink: 0;
      }

      

      #bottomSheetHandle::after {
        content: "";
        width: 40px;
        height: 5px;
        background-color: #d1d5db;
        border-radius: 3px;
      }
    }

    @media (min-width: 768px) {
      #mobileBottomNav { display: none !important; }
      #mobileBackButton {
        display: none !important;
      }

      #bottomSheetOverlay {
        display: none !important;
      }

      #bottomSheetHandle {
        display: none !important;
      }
    }

    /* デスクトップ時のメッセージ入力欄の余白 */
    @media (min-width: 769px) {
      #messageInputArea {
        padding-bottom: 1rem;
      }
    }
    /* === Discord風UIモード専用スタイル === */
    body.discord-ui-mode #serverListScreen {
      display: none !important; /* 既存のカード群リストを完全遮断 */
    }

    body.discord-ui-mode #appContainer {
      display: flex !important;
      flex-direction: row !important;
      width: 100% !important;
      height: 100% !important;
      flex: 1 1 0 !important;
    }

    body.discord-ui-mode #discordServerNav {
      display: flex !important;
      padding-top: 14px !important; /* PC時に個チャマークが上部天井にくっつくのを解消 */
    }

    body.discord-ui-mode #backToServerListBtn {
      display: none !important; /* Discord風ヘッダーのため不要 */
    }

    /* サーバーナビゲーション内の要素 */
    .discord-server-item {
      position: relative;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      margin-bottom: 8px;
    }

    .discord-server-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1.2rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }

    .discord-server-icon img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: inherit;
    }

    .discord-server-item:hover .discord-server-icon,
    .discord-server-item.active .discord-server-icon {
      border-radius: 16px; /* Discord調の美しいスクワークル変形 */
    }

    /* 左側のアクティブインジケーター（ピル）- Discord本家同等の滑らかで優雅なアニメーション */
    .discord-server-pill {
      position: absolute;
      left: -12px;
      width: 4px;
      height: 8px;
      background: white;
      border-radius: 0 4px 4px 0;
      transform: translateX(-4px);
      opacity: 0;
      pointer-events: none;
      /* 滑らかに緩やかに伸びるリッチな流体イージング */
      transition: height 0.28s cubic-bezier(0.34, 1.2, 0.64, 1),
                  transform 0.22s cubic-bezier(0.25, 1, 0.5, 1),
                  opacity 0.2s ease-out;
      will-change: height, transform, opacity;
    }

    /* ホバー時: 左からスライドインして20px高さ */
    @media (hover: hover) and (pointer: fine) {
      .discord-server-item:hover .discord-server-pill {
        transform: translateX(0);
        height: 20px;
        opacity: 1;
      }
    }

    /* アクティブ時: スーッと滑らかに40pxまで伸びる */
    .discord-server-item.active .discord-server-pill {
      transform: translateX(0) !important;
      height: 40px !important;
      opacity: 1 !important;
    }

    /* 未読時: 8px（ドット表示） */
    .discord-server-item.has-unread .discord-server-pill {
      transform: translateX(0);
      height: 8px;
      opacity: 1;
    }
    @media (hover: hover) and (pointer: fine) {
      .discord-server-item.has-unread:hover .discord-server-pill {
        transform: translateX(0);
        height: 20px;
        opacity: 1;
      }
    }

    /* ホーム画面・DM・探索ビュー切替ロジック (DiscordUIモード時) */
    body.discord-ui-mode.discord-home-view #chatArea,
    body.discord-ui-mode.discord-home-view #membersSidebar,
    body.discord-ui-mode.discord-home-view #roomList,
    body.discord-ui-mode.discord-home-view #serverHeader {
      display: none !important;
    }
    @media (min-width: 1024px) {
      body.discord-ui-mode.discord-home-view #discordHomeMembers {
        display: flex !important;
      }
    }

    /* 1. DM/フレンドビュー (吹き出しマーク) */
    body.discord-ui-mode.discord-dm-view #discordDmHomeView {
      display: flex !important;
      flex: 1 1 0% !important;
      min-width: 0 !important;
    }
    body.discord-ui-mode.discord-dm-view #discordHomeSidebar {
      display: flex !important;
    }
    body.discord-ui-mode.discord-dm-view #discordDiscoverView {
      display: none !important;
    }

    /* 2. 探索/サーバービュー (コンパスマーク) */
    body.discord-ui-mode.discord-discover-view #discordDiscoverView {
      display: flex !important;
      flex: 1 1 0% !important;
      min-width: 0 !important;
    }
    body.discord-ui-mode.discord-discover-view #discordDmHomeView,
    body.discord-ui-mode.discord-discover-view #discordHomeSidebar,
    body.discord-ui-mode.discord-discover-view #sidebar {
      display: none !important;
    }

    /* サーバー内（チャット表示時）の非表示制御 */
    body.discord-ui-mode:not(.discord-home-view) #discordDmHomeView,
    body.discord-ui-mode:not(.discord-home-view) #discordDiscoverView,
    body.discord-ui-mode:not(.discord-home-view) #discordHomeSidebar,
