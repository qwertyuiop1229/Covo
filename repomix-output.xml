        const body = await request.json();
        const { appId, serverId, roomId, userId } = body;
        if (!appId || !roomId || !userId) return new Response(JSON.stringify({ error: "Missing required param" }), { status: 400, headers: d1Cors });
        if (verifiedUser.uid !== userId) {
          const isAdmin = await isD1Admin(appId, verifiedUser, env);
          if (!isAdmin) {
            return new Response(JSON.stringify({ error: "Forbidden: Not authorized for rescue" }), { status: 403, headers: d1Cors });
          }
        }
        // 1. __escrow__ 用の合鍵を取得
        let targetKeyData = null;
        const escrowRow = await env.DB.prepare("SELECT key_data FROM room_keys WHERE room_id = ? AND app_id = ? AND user_id = ?").bind(roomId, appId, "__escrow__").first();
        if (escrowRow && escrowRow.key_data) {
          targetKeyData = JSON.parse(escrowRow.key_data);
        } else {
          // 2. __escrow__ が未登録の場合、同じルーム内で最新更新された有効なユーザー鍵を特定して救済プールとする（フォールバック）
          const fallbackRow = await env.DB.prepare("SELECT key_data FROM room_keys WHERE room_id = ? AND app_id = ? ORDER BY updated_at DESC LIMIT 1").bind(roomId, appId).first();
          if (fallbackRow && fallbackRow.key_data) {
            targetKeyData = JSON.parse(fallbackRow.key_data);
          }
        }
        if (!targetKeyData) {
          return new Response(JSON.stringify({ success: false, error: "No escrow or fallback key found for this room" }), { status: 404, headers: d1Cors });
        }
        // 3. 対象ユーザー(userId)向けにレスキューされた鍵を格納（復旧）
        await env.DB.prepare("INSERT INTO room_keys (room_id, user_id, server_id, app_id, key_data, updated_at) VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT(room_id, user_id) DO UPDATE SET key_data = excluded.key_data, updated_at = excluded.updated_at")
          .bind(roomId, userId, serverId || "unknown", appId, JSON.stringify(targetKeyData), Date.now()).run();
        return new Response(JSON.stringify({ success: true, keyData: targetKeyData, rescued: true }), { status: 200, headers: d1Cors });
        }
        }
        return new Response(JSON.stringify({ error: "Unknown D1 API subpath" }), { status: 404, headers: d1Cors });
        } catch (err) {
        console.error("D1 API Error:", err);
        return new Response(JSON.stringify({ error: "D1 API Internal Error", details: err.toString() }), { status: 200, headers: d1Cors });
        }
        }
        // -------------------------------------------------------------
        // サーバーメンバー判定ヘルパー (プルーニング認可用)
        // -------------------------------------------------------------
        async function isServerMemberCheck(appId, serverId, verifiedUser, env) {
        if (!appId || !serverId || !verifiedUser) return false;
        try {
        const adminToken = await getAdminTokenForFirestore(env);
        if (adminToken) {
        const srvUrl = `https://firestore.googleapis.com/v1/projects/${env.FIREBASE_PROJECT_ID}/databases/(default)/documents/artifacts/${appId}/servers/${serverId}`;
        const srvRes = await fetch(srvUrl, { headers: { "Authorization": `Bearer ${adminToken}` } });
        const srvData = await srvRes.json();
        if (!srvData.error && srvData.fields) {
        if (srvData.fields.createdBy?.stringValue === verifiedUser.uid) return true;
        if (srvData.fields.joinedUsers?.arrayValue?.values) {
          const members = srvData.fields.joinedUsers.arrayValue.values.map(v => (v.stringValue || "").trim());
          if (members.includes(verifiedUser.uid.trim())) return true;
        }
        }
        }
        } catch (e) {
        console.error("isServerMemberCheck Firestore error:", e);
        }
        return false;
        }
        // -------------------------------------------------------------
        // 1,000件超過メッセージ自動プルーニング & Cloudflare KV ファイル自動完全消去
        // -------------------------------------------------------------
        async function handlePruneChannelMessages(request, env) {
          const cors = getCorsHeaders(request);
          try {
            const authHeader = request.headers.get("Authorization") || "";
            const idToken = authHeader.replace("Bearer ", "").trim();
            if (!idToken) {
              return new Response(JSON.stringify({ error: "Unauthorized" }), { status: 401, headers: { ...cors, "Content-Type": "application/json" } });
            }
            const verifiedUser = await verifyFirebaseIdToken(idToken, env);
            if (!verifiedUser) {
              return new Response(JSON.stringify({ error: "Unauthorized" }), { status: 401, headers: { ...cors, "Content-Type": "application/json" } });
            }
            const { appId, serverId, roomId, dmId, forcePrune, retentionPolicy, maxKeep } = await request.json();
            if (!appId || (!dmId && (!serverId || !roomId))) {
              return new Response(JSON.stringify({ error: "Missing required parameters" }), { status: 400, headers: { ...cors, "Content-Type": "application/json" } });
            }
            if (!isValidAppId(appId, env)) {
              return new Response(JSON.stringify({ error: "Invalid appId" }), { status: 400, headers: { ...cors, "Content-Type": "application/json" } });
            }
            if (serverId && !/^[a-zA-Z0-9_\-]+$/.test(serverId)) {
              return new Response(JSON.stringify({ error: "Invalid serverId" }), { status: 400, headers: { ...cors, "Content-Type": "application/json" } });
            }
            if (roomId && !/^[a-zA-Z0-9_\-]+$/.test(roomId)) {
              return new Response(JSON.stringify({ error: "Invalid roomId" }), { status: 400, headers: { ...cors, "Content-Type": "application/json" } });
            }
            if (dmId && (!/^[a-zA-Z0-9_\-]+$/.test(dmId) || dmId.split('_').length !== 2)) {
              return new Response(JSON.stringify({ error: "Invalid dmId" }), { status: 400, headers: { ...cors, "Content-Type": "application/json" } });
            }
            const isGlobal = await isAppAdmin(appId, verifiedUser, env);
            let hasServerAdminRights = isGlobal;
            if (dmId) {
              const parts = dmId.split('_');
              if (!isGlobal && !parts.includes(verifiedUser.uid)) {
                return new Response(JSON.stringify({ error: "Forbidden: Not a participant of this DM" }), { status: 403, headers: { ...cors, "Content-Type": "application/json" } });
              }
            } else {
              const isSvAdmin = serverId ? await isServerAdminCheck(appId, serverId, verifiedUser, env) : false;
              hasServerAdminRights = isGlobal || isSvAdmin;
              if (!hasServerAdminRights) {
                const isMember = await isServerMemberCheck(appId, serverId, verifiedUser, env);
                if (!isMember) {
                  return new Response(JSON.stringify({ error: "Forbidden: Not a member of this server" }), { status: 403, headers: { ...cors, "Content-Type": "application/json" } });
                }
                if (forcePrune) {
                  return new Response(JSON.stringify({ error: "Forbidden: Server admin rights required for force prune" }), { status: 403, headers: { ...cors, "Content-Type": "application/json" } });
                }
              }
            }
            const projectId = env.FIREBASE_PROJECT_ID;
            const rtdbBase = env.FIREBASE_DATABASE_URL || `https://${projectId}-default-rtdb.asia-southeast1.firebasedatabase.app`;
            // サービスアカウント優先、フォールバックでWorker認証トークンまたはユーザーIDトークンを使用
            let adminToken = null;
            let rtdbToken = null;
            let isOAuth = false;
            if (env.SERVICE_ACCOUNT_JSON) {
              try {
                const [aTok, rTok] = await Promise.all([
                  getFirestoreAdminToken(env.SERVICE_ACCOUNT_JSON),
                  getRTDBToken(env.SERVICE_ACCOUNT_JSON)
                ]);
                adminToken = aTok;
                rtdbToken = rTok;
                isOAuth = true;
              } catch (tokErr) {
                console.warn("[Prune] Service account token error, falling back:", tokErr);
              }
            }
            if (!adminToken || !rtdbToken) {
              const workerToken = await getWorkerAuthToken(env);
              if (workerToken) {
                adminToken = adminToken || workerToken;
                rtdbToken = workerToken;
                isOAuth = false;
              } else {
                adminToken = adminToken || idToken;
                rtdbToken = idToken;
                isOAuth = false;
              }
            }
            const authQuery = isOAuth ? `access_token=${rtdbToken}` : `auth=${rtdbToken}`;
            const rtdbPath = dmId
              ? `${rtdbBase.replace(/\/$/, '')}/artifacts/${appId}/dm_messages/${dmId}.json?${authQuery}`
              : `${rtdbBase.replace(/\/$/, '')}/artifacts/${appId}/servers/${serverId}/rooms/${roomId}/messages.json?${authQuery}`;
            const rtdbRes = await fetch(rtdbPath + '&shallow=true', {
              headers: {
                "Accept": "application/json"
              }
            });
            if (!rtdbRes.ok) {
              const errText = await rtdbRes.text().catch(() => "");
              console.warn(`[Prune] RTDB fetch skipped (status ${rtdbRes.status}):`, errText);
              return new Response(JSON.stringify({ success: true, prunedCount: 0, skipped: true }), {
                status: 200, headers: { ...cors, "Content-Type": "application/json" }
              });
            }
            const keys = await rtdbRes.json();
            const maxAllowed = 1000;
            const count = keys && typeof keys === 'object' ? Object.keys(keys).length : 0;
            const noPrune = () => new Response(JSON.stringify({ success: true, prunedCount: 0, deletedFiles: 0, retentionLimit: maxAllowed }), { status: 200, headers: { ...cors, 'Content-Type': 'application/json' } });
            if (count <= maxAllowed) return noPrune();
            // Once count - 1000 pins are found, at most 1000 unpinned records
            // remain. Downloading the rest of the pinned bodies proves nothing
            // more and can dominate traffic in heavily pinned channels.
            const pinnedResponse = await fetch(rtdbPath + '&orderBy=%22isPinned%22&equalTo=true&limitToFirst=' + (count - maxAllowed));
            if (!pinnedResponse.ok) throw new Error('Pinned retention lookup failed');
            const pinned = await pinnedResponse.json() || {};
            const unpinnedCount = count - Object.keys(pinned).length;
            if (unpinnedCount <= maxAllowed) return noPrune();
            const excessCount = Math.min(100, unpinnedCount - maxAllowed);
            const oldestResponse = await fetch(rtdbPath + '&orderBy=%22timestamp%22&limitToFirst=' + (Object.keys(pinned).length + excessCount));
            if (!oldestResponse.ok) throw new Error('Retention tail lookup failed');
            const rtdbData = await oldestResponse.json() || {};
            const msgsList = Object.entries(rtdbData).filter(([id]) => /^[A-Za-z0-9_-]+$/.test(id)).map(([id, message]) => ({ ...message, id }));
            msgsList.sort((a, b) => (a.timestamp || a.createdAt || 0) - (b.timestamp || b.createdAt || 0) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
            const excessMsgs = msgsList.filter(message => !message.isPinned).slice(0, excessCount);
            // A second pruner may have removed the original tail while this
            // request was selecting candidates. Never spend a stale excess
            // count on the next (still retained) messages. Only keys, not full
            // bodies, are downloaded for this conservative consistency check.
            const currentKeysResponse = await fetch(rtdbPath + '&shallow=true');
            if (!currentKeysResponse.ok) throw new Error('Retention consistency lookup failed');
            const currentKeys = await currentKeysResponse.json() || {};
            if (Object.keys(currentKeys).length !== count || Object.keys(keys).some(key => !Object.hasOwn(currentKeys, key))) {
              return new Response(JSON.stringify({ success: true, prunedCount: 0, deletedFiles: 0, skipped: true, reason: 'channel-changed', retentionLimit: maxAllowed }), { status: 200, headers: { ...cors, 'Content-Type': 'application/json' } });
            }
            let deletedFiles = 0;
            let prunedCount = 0;
            let failedDeletes = 0;
            for (const msg of excessMsgs) {
              const delMsgRtdbUrl = dmId
                ? `${rtdbBase.replace(/\/$/, '')}/artifacts/${appId}/dm_messages/${dmId}/${msg.id}.json?${authQuery}`
                : `${rtdbBase.replace(/\/$/, '')}/artifacts/${appId}/servers/${serverId}/rooms/${roomId}/messages/${msg.id}.json?${authQuery}`;
              let restoreOnFailure = null;
              const restoreLegacy = async () => {
                if (!restoreOnFailure) return;
                const restored = await fetch(delMsgRtdbUrl, { method: 'PUT', headers: { 'Content-Type': 'application/json', 'if-match': 'null_etag' }, body: JSON.stringify(restoreOnFailure) });
                if (!restored.ok && restored.status !== 412) throw new Error('Retention rollback failed');
                restoreOnFailure = null;
              };
              try {
                const liveResponse = await fetch(delMsgRtdbUrl, { headers: { 'X-Firebase-ETag': 'true' } });
                if (!liveResponse.ok) { failedDeletes++; continue; }
                const live = await liveResponse.json();
                if (!live || live.isPinned) continue;
                if ((live.timestamp || live.createdAt || 0) !== (msg.timestamp || msg.createdAt || 0)) continue;
                const storedId = msg.id;
                Object.assign(msg, live, { id: storedId });
                const etag = liveResponse.headers.get('ETag');
                if (!etag) { failedDeletes++; continue; }
                const deleted = await fetch(delMsgRtdbUrl, { method: 'DELETE', headers: { 'if-match': etag } });
                if (!deleted.ok) { failedDeletes++; continue; }
                if (!dmId && serverId && roomId && adminToken && !(Number(live.storageVersion) >= 2)) {
                  restoreOnFailure = live;
                  const fsUrl = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents/artifacts/${appId}/servers/${serverId}/rooms/${roomId}/messages/${msg.id}`;
                  const mirrorRead = await fetch(fsUrl + '?mask.fieldPaths=senderId&mask.fieldPaths=userId&mask.fieldPaths=timestamp&mask.fieldPaths=createdAt&mask.fieldPaths=isPinned', { headers: { Authorization: 'Bearer ' + adminToken } });
                  let mirrorFailed = !mirrorRead.ok && mirrorRead.status !== 404;
                  const mirror = mirrorRead.ok ? await mirrorRead.json() : null;
                  const fields = mirror?.fields;
                  const mirrorOwner = fields?.senderId?.stringValue || fields?.userId?.stringValue;
                  const storedTime = fields?.timestamp || fields?.createdAt;
                  const mirrorTime = storedTime?.integerValue != null ? Number(storedTime.integerValue) : storedTime?.doubleValue != null ? Number(storedTime.doubleValue) : Date.parse(storedTime?.timestampValue || '');
                  // A colliding ID in a second store is not proof that both rows
                  // represent the same message. Never delete a different owner/version.
                  if (mirrorRead.ok && (!fields || mirrorOwner !== (live.senderId || live.userId) || mirrorTime !== (live.timestamp || live.createdAt || 0) || fields.isPinned?.booleanValue === true)) mirrorFailed = true;
                  if (!mirrorFailed && fields) {
                    if (!mirror.updateTime) mirrorFailed = true;
                    else {
                      const fsDeleted = await deleteFirestoreAtVersion(projectId, `artifacts/${appId}/servers/${serverId}/rooms/${roomId}/messages/${msg.id}`, mirror.updateTime, adminToken);
