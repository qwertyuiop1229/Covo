      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
    }
    body:not(.dark-server-theme):not(.discord-dark-theme).discord-ui-mode .discord-hero-btn-pri {
      background: #0284c7;
      color: #ffffff;
