  border-radius: 0.625rem;
  background: var(--vc-bar-bg, #f2f3f5);
  border: 1px solid var(--vc-bar-border, rgba(0,0,0,0.08));
  overflow: hidden;
  transition: all 0.2s ease;
  animation: vc-bar-slide-in 0.25s ease;
}
@keyframes vc-bar-slide-in {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
.vc-connection-bar.hidden {
