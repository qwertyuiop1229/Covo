        bar.className = 'voice-live-bar flex-1 rounded-full bg-[#5865F2] transition-all duration-75';
        bar.style.height = '4px';
        bar.style.minWidth = '2px';
        bar.style.maxWidth = '4px';
        liveWave.appendChild(bar);
