        status: 200, headers: { ...cors, 'Content-Type': 'application/json' }
      });
    }
    const adminKey = url.searchParams.get('adminKey') || '';
    let isPrivilegedAdmin = false;
    if (env.ADMIN_SECRET_KEY && adminKey === env.ADMIN_SECRET_KEY) {
