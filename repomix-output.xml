<file path="scripts/build_firebase.mjs">
import { build } from 'esbuild';
import { mkdir, writeFile } from 'node:fs/promises';
await mkdir('.cache/firebase', { recursive: true });
for (const name of ['app', 'auth', 'storage', 'messaging']) {
  await writeFile(`.cache/firebase/firebase-${name}.js`, `export * from 'firebase-runtime/${name}';\n`);
}
const firebaseBuild = await build({
  entryPoints: {
    'firebase-app': '.cache/firebase/firebase-app.js',
    'firebase-auth': '.cache/firebase/firebase-auth.js',
    'firebase-storage': '.cache/firebase/firebase-storage.js',
    'firebase-messaging': '.cache/firebase/firebase-messaging.js',
    'firebase-firestore': 'scripts/firebase-entry.mjs',
    'firebase-database': 'scripts/database-entry.mjs'
  },
  outdir: 'public/vendor/firebase', bundle: true, splitting: true,
  format: 'esm', platform: 'browser', target: ['safari15', 'chrome100'], minify: true, metafile: true,
  external: ['../../js/communication_runtime.js'],
  plugins: [{ name: 'shared-local-metrics', setup(b) {
    b.onResolve({ filter: /communication_runtime\.js$/ }, () => ({ path: '../../js/communication_runtime.js', external: true }));
  } }]
});
await writeFile('.cache/firebase/metafile.json', JSON.stringify(firebaseBuild.metafile, null, 2));
await build({ entryPoints: ['node_modules/@tauri-apps/plugin-updater/dist-js/index.js'], outfile: 'public/vendor/desktop-updater.js', bundle: true, format: 'esm', minify: true });
</file>

<file path="scripts/build_windows_setup.ps1">
param([switch]$Bootstrap)
$ErrorActionPreference = 'Stop'
$taskRoot = Split-Path -Parent $PSScriptRoot
$sourceRoot = Join-Path $taskRoot 'src-tauri\windows'
$outputRoot = Join-Path $sourceRoot 'bin'
New-Item -ItemType Directory -Path $outputRoot -Force | Out-Null
if (-not (Get-Command cl.exe -ErrorAction SilentlyContinue)) { throw 'MSVCのDeveloper PowerShellで実行してください。' }
$config = Get-Content -LiteralPath (Join-Path $taskRoot 'src-tauri\tauri.conf.json') -Raw | ConvertFrom-Json
$versionHeader = '#define COVO_SETUP_VERSION L"' + $config.version + '"'
$resourceArgs = @()
$definitions = @('/DCOVO_MAINTENANCE')
$executableName = 'CovoMaintenance.exe'
if ($Bootstrap) {
  $engines = @(Get-ChildItem -LiteralPath (Join-Path $taskRoot 'src-tauri\target\release\bundle\nsis') -Filter '*-setup.exe')
  if ($engines.Count -ne 1) { throw 'NSISエンジンを一意に選択できません。ビルド成果物を確認してください。' }
  $engine = $engines[0].FullName
  $digest = (Get-FileHash -LiteralPath $engine -Algorithm SHA256).Hash
  $bytes = for ($index = 0; $index -lt 64; $index += 2) { '0x' + $digest.Substring($index, 2) }
  $versionHeader += "`n#define COVO_ENGINE_SHA256 " + ($bytes -join ',')
  $resource = '101 RCDATA "' + $engine.Replace('\','\\') + '"'
  [IO.File]::WriteAllText((Join-Path $outputRoot 'engine.rc'), $resource)
  & rc.exe /nologo /fo (Join-Path $outputRoot 'engine.res') (Join-Path $outputRoot 'engine.rc')
  if ($LASTEXITCODE -ne 0) { throw 'リソースの生成に失敗しました。' }
  $resourceArgs = @((Join-Path $outputRoot 'engine.res'))
  $definitions = @()
  $executableName = 'CovoSetup.exe'
}
[IO.File]::WriteAllText((Join-Path $outputRoot 'setup_version.h'), $versionHeader)
& cl.exe /nologo /std:c++17 /EHsc /utf-8 /O2 /MT /W4 @definitions /I $outputRoot (Join-Path $sourceRoot 'setup.cpp') @resourceArgs /Fo"$outputRoot\setup.obj" /Fe"$outputRoot\$executableName" /link /SUBSYSTEM:WINDOWS /DYNAMICBASE /NXCOMPAT /MANIFEST:EMBED /MANIFESTUAC:"level='asInvoker' uiAccess='false'"
if ($LASTEXITCODE -ne 0) { throw 'Covoセットアップのビルドに失敗しました。' }
</file>

<file path="scripts/bump-version.js">
#!/usr/bin/env node
/**
 * バージョン管理は deploy.ps1 (npm run deploy) が一元担う。
 * firebase deploy 直接実行時はバンプしない。
 *   - タグなし・git push なし → Windows ビルドが動かない
 *   - tauri.conf.json との同期漏れを防ぐ
 */
console.log('[version] skip bump (use "npm run deploy" to bump)');
process.exit(0);
</file>

