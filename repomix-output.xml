/* --- コンポーネント用ユーティリティ（ベース重複を解消） --- */
    .flipped {
      transform: scaleY(-1);
    }

    .message-bubble {
      max-width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 1rem;
      margin-bottom: 0;
      word-wrap: break-word;
      -webkit-touch-callout: none;
      /* iOS長押しメニュー防止 */
    }


    .msg-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #374151;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.78rem;
      font-weight: 700;
      flex-shrink: 0;
      cursor: pointer;
      overflow: hidden;
      transition: opacity 0.15s;
    }

    .msg-avatar:hover {
      opacity: 0.85;
    }

    .msg-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .my-message {
      background-color: #e0e0e0;
      /* 薄いグレー */
      border-top-right-radius: 0.25rem;
    }

    .other-message {
      background-color: #f0f0f0;
      /* 非常に薄いグレー */
      border-top-left-radius: 0.25rem;
    }

    .scrollable {
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    /* === アップデートオーバーレイ（Covo専用スタイリッシュ＆シンプルデザイン） === */
    #updateOverlay {
      position: fixed;
      inset: 0;
      z-index: 99999;
      display: none;
      align-items: center;
      justify-content: center;
