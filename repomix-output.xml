// Web Crypto SHA-256
async function _sha256Hash(text) {
  const enc = new TextEncoder();
  const buf = await crypto.subtle.digest('SHA-256', enc.encode(String(text || '')));
  return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
}
// 24文字のセキュアな緊急リカバリーキー生成 (Base32相当・判読しやすい文字セット)
function _generateRandomRecoveryKey() {
  const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
  const parts = [];
  for (let p = 0; p < 4; p++) {
    let segment = '';
    const randomVals = new Uint8Array(4);
    crypto.getRandomValues(randomVals);
    for (let i = 0; i < 4; i++) {
      segment += chars[randomVals[i] % chars.length];
    }
    parts.push(segment);
  }
  return `COVO-${parts.join('-')}`;
}
// リカバリーキーの形式検証と正規化 (#96)
export function normalizeAndValidateRecoveryKey(rawKey) {
  if (!rawKey || typeof rawKey !== 'string') {
    return { valid: false, key: '', error: 'リカバリーキーを入力してください。' };
  }
  const cleaned = rawKey
    .replace(/[ー－―–—]/g, '-')
    .replace(/\s+/g, '')
    .toUpperCase();
  const regex = /^COVO-[2-9A-HJ-NP-Z]{4}-[2-9A-HJ-NP-Z]{4}-[2-9A-HJ-NP-Z]{4}-[2-9A-HJ-NP-Z]{4}$/;
  if (!regex.test(cleaned)) {
    return {
      valid: false,
      key: cleaned,
      error: 'キー形式が正しくありません。「COVO-XXXX-XXXX-XXXX-XXXX」の形式（英大文字・数字16文字）で入力してください。'
    };
  }
  return { valid: true, key: cleaned, error: null };
}
