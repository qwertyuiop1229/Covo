    /* 過去メッセージ読み込みスピナー */
    #topLoadingSpinner {
      display: none;
    }
    .top-spinner {
      width: 18px;
      height: 18px;
      border: 2px solid #e5e7eb;
      border-top-color: #6b7280;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    /* =============================================
       Mobile Bottom Navigation & BottomSheet System
    ============================================= */
    :root {
          /* すべてのiPhone / iPad / Android / PWA をサポートする正規Safe Area変数 */
          --safe-top: env(safe-area-inset-top, 0px);
          --safe-bottom: env(safe-area-inset-bottom, 0px);
          --safe-left: env(safe-area-inset-left, 0px);
          --safe-right: env(safe-area-inset-right, 0px);
        }
    /* 汎用ボトムシート（Drawer）共通スタイル */
    .bottom-sheet-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 9998;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .bottom-sheet-overlay.show {
      opacity: 1;
      pointer-events: auto;
    }
    .bottom-sheet-handle,
    .call-picker-handle {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      padding: 12px 0 8px;
      cursor: grab;
      flex-shrink: 0;
      touch-action: none;
      -webkit-tap-highlight-color: transparent;
    }
    .bottom-sheet-handle:active,
    .call-picker-handle:active {
      cursor: grabbing;
    }
    .bottom-sheet-handle-bar {
      width: 40px;
      height: 5px;
      background-color: #cbd5e1;
      border-radius: 9999px;
      margin: 0 auto;
      transition: background-color 0.2s, transform 0.2s;
    }
    body.dark-server-theme .bottom-sheet-handle-bar {
      background-color: #475569;
    }
    body.discord-dark-theme .bottom-sheet-handle-bar {
      background-color: #4e5058;
    }
    @media (max-width: 768px) {
      /* スマホUIではファイル共有右側のメンバーボタンを完全非表示 */
      #toggleMembersSidebarBtn {
        display: none !important;
      }
      .covo-bottom-sheet,
      #membersSidebar,
      #callPickerModal .call-picker-box {
        position: fixed !important;
