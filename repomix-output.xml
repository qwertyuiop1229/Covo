#vcGridOverlay {
  position: fixed;
  inset: 0;
  z-index: 2100;
  background: #1a1b1e;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
#vcGridOverlay.hidden {
  display: none;
}
.vc-grid-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  background: rgba(0,0,0,0.3);
  flex-shrink: 0;
}
.vc-grid-header-info {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.vc-grid-header-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #23a55a;
}
.vc-grid-header-name {
  font-size: 0.875rem;
  font-weight: 700;
  color: #f2f3f5;
}
.vc-grid-header-count {
  font-size: 0.75rem;
  color: #949ba4;
}
.vc-grid-header-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.vc-grid-body {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-content: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 1rem;
  overflow: hidden;
}
.vc-grid-tile {
  background: #2b2d31;
  border-radius: 0.75rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: box-shadow 0.18s ease;
  min-width: 120px;
  min-height: 120px;
}
/* speaking ring for grid tiles */
.vc-grid-tile.speaking {
  box-shadow: 0 0 0 3px #23a55a, 0 0 20px rgba(35,165,90,0.3);
}
@keyframes vc-grid-speaking-pulse {
  0%, 100% { box-shadow: 0 0 0 3px #23a55a; }
  50% { box-shadow: 0 0 0 3px #23a55a, 0 0 20px rgba(35,165,90,0.5); }
}
.vc-grid-tile.speaking {
  animation: vc-grid-speaking-pulse 1.2s ease-in-out infinite;
}
.vc-grid-avatar {
  width: 4rem;
  height: 4rem;
  border-radius: 50%;
  background: #4b5563;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  font-weight: 700;
  overflow: hidden;
  flex-shrink: 0;
}
.vc-grid-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}
.vc-grid-tile-name {
  position: absolute;
  bottom: 0.5rem;
  left: 0.5rem;
  right: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.25rem;
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(4px);
  border-radius: 0.375rem;
  padding: 0.2rem 0.5rem;
}
.vc-grid-tile-name-text {
  font-size: 0.7rem;
  color: #f2f3f5;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.vc-grid-video-container {
  position: absolute;
  inset: 0;
  background: #111;
}
.vc-grid-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 1rem;
  background: rgba(0,0,0,0.3);
  flex-shrink: 0;
}
.vc-ctrl-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  background: #383a40;
  border: none;
  color: #f2f3f5;
  cursor: pointer;
  font-size: 1rem;
  transition: all 0.15s ease;
}
.vc-ctrl-btn:hover {
  background: #4e5058;
}
.vc-ctrl-btn.active {
  background: rgba(35,165,90,0.25);
  color: #23a55a;
}
.vc-ctrl-btn.muted {
  background: rgba(220,38,38,0.2);
  color: #f87171;
}
