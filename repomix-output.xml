    body.dark-server-theme #mobileNotifScreen { background: #111827; }
    body.dark-server-theme .mobile-notif-item {
      background: #1e293b !important;
      border-color: rgba(255,255,255,0.07) !important;
    }

    /* チャンネルサイドバー */
