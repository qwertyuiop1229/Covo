      let cursor;
      do {
        const listed = await env.FILES.list({ cursor, limit: 1000 });
        for (const key of listed.keys) {
          const folder = key.metadata?.folder || '';

          if (deleteType === "messages_only") {
             if (folder !== 'simplechat/messages') continue;
