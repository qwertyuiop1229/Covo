function __setAvatarImg(container, url, name, opts) {
  if (!container) return;
  opts = opts || {};
  const styleStr = opts.style || 'width:100%;height:100%;object-fit:cover;border-radius:50%';
  const className = opts.className || '';
  const initial = ((name || '?').charAt(0) || '?').toUpperCase();
