      background-color: #e2e8f0;
      transition: background-color 0.15s ease;
      flex-shrink: 0;
      position: relative;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      z-index: 25;
    }
    /* タッチ・ホバー判定領域を左右に大幅拡張（見た目は細いまま指で簡単に掴める） */
    #resizer::before, #resizerRight::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: -10px;
      right: -10px;
      width: calc(100% + 20px);
