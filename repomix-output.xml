    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* === 設定トグルスイッチ === */
    .setting-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 0;
      border-bottom: 1px solid #f3f4f6;
    }

    .setting-row:last-child {
