    .reply-quote-text {
      color: #334155;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      opacity: 0.9;
      flex: 1 1 auto;
      min-width: 0;
    }

    .message-highlight {
      transition: background-color 0.8s ease-out;
      background-color: #bde4ff !important;
    }
    /* === ダークモード全体 === */
    body.dark-server-theme { background: #111827; }
    body.dark-server-theme #mainContent,
    body.dark-server-theme #appContainer { background: #111827; }

