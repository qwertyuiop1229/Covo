    body.discord-dark-theme .code-expand-toggle:hover {
      background-color: #383a40 !important;
      color: #7983f5 !important;
    }
    /* ===== ダークネイビー: 送信ボタン Blurple 上書き ===== */
    body.dark-server-theme .send-btn:not(:disabled) {
      background-color: #5865F2 !important;
      border-color: #5865F2 !important;
      color: #ffffff !important;
    }
    body.dark-server-theme .send-btn:not(:disabled):hover {
      background-color: #4752c4 !important;
