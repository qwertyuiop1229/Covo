  justify-content: center;
  transition: transform 0.2s ease;
}
@media (max-width: 768px) {
  .splash-icon-container {
    transform: translateY(calc(-28px - (env(safe-area-inset-top, 0px) * 0.35))) !important;
  }
}
/* === サーバーリスト画面 === */
    #serverListScreen {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #f3f4f6;
      overflow-y: auto;
    }
    #serverListScreen.hidden {
      display: none !important;
    }
    /* === アニメーション定義 === */
    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
