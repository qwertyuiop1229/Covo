      catch(error) { if (status) status.textContent = error.message || '復旧ツールを読み込めませんでした。接続を確認して再試行してください。'; }
      finally { if (button) button.disabled = false; }
    };
    window.emergencyOpenRecoveryEngine = function() {
      const invoke = window.__TAURI__?.core?.invoke;
