    }

    /* ユーザーパネル */
    body.dark-server-theme #userPanel {
      background-color: #162032 !important;
      border-color: rgba(255, 255, 255, 0.06) !important;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25) !important;
    }
    body.dark-server-theme #userPanel:hover {
