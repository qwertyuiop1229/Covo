    body:not(.dark-server-theme):not(.discord-dark-theme).discord-ui-mode .discord-server-item.active .discord-server-icon:not(.custom-bg) {
      background-color: #1e293b !important; /* Covo美学: 極上のダークネイビー */
      color: white !important;
