  async switchSpeaker(deviceId) {
    if (!deviceId) return;
    for (const [peerUid, audioEl] of this._audioElements) {
      if (audioEl && typeof audioEl.setSinkId === 'function') {
        try {
          await audioEl.setSinkId(deviceId);
