      canvas.style.width = CROP_CSS_SIZE + 'px';
      canvas.style.height = CROP_CSS_SIZE + 'px';
      const ctx = canvas.getContext('2d');
      ctx.setTransform(1, 0, 0, 1, 0, 0);
