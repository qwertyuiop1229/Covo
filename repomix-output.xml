    /* Discordを意識したメッセージホバー・クイックアクションバーは、
       LINE風メッセージの方針と合わないため撤去（未閉じコメントで無効化されていたブロックごと削除） */
/* Encrypted attachments remain obscured until download, decryption and media decoding finish. */
.covo-media-loading {
  filter: blur(8px);
  opacity: .5;
  background: linear-gradient(110deg, var(--bg-secondary, #e5e7eb), var(--bg-primary, #f3f4f6), var(--bg-secondary, #e5e7eb));
  min-height: 96px;
  transition: filter .18s ease, opacity .18s ease;
}
@media (prefers-reduced-motion: reduce) {
  .covo-media-loading { transition: none; }
}
.covo-media-shell { position:relative; display:block; width:320px; max-width:100%; aspect-ratio:1.6; margin-top:8px; overflow:hidden; border-radius:10px; background:var(--covo-surface-muted,var(--bg-secondary,#e5e7eb)); isolation:isolate; }
.covo-media-shell > img,.covo-media-shell > video { position:absolute; inset:0; margin:0!important; width:100%; height:100%; max-height:100%!important; object-fit:contain; min-height:0; }
.covo-media-shell.is-loading > img,.covo-media-shell.is-loading > video { opacity:0!important; }
.covo-media-shell.is-loading::before { content:''; position:absolute; inset:-15%; background:radial-gradient(ellipse at 20% 25%,var(--covo-accent,#5865f2) 0%,transparent 55%),radial-gradient(ellipse at 85% 80%,#8b5cf6 0%,transparent 60%); filter:blur(28px); opacity:.22; }
.covo-media-shell.is-loading::after { content:''; position:absolute; inset:0; background:linear-gradient(110deg,transparent 25%,#ffffff24 50%,transparent 75%); transform:translateX(-100%); animation:covo-media-shimmer 2s ease-in-out infinite; pointer-events:none; }
@keyframes covo-media-shimmer { to { transform:translateX(100%); } }
body.covo-background .covo-media-shell::after { animation-play-state:paused; }
@media(prefers-reduced-motion:reduce) { .covo-media-shell.is-loading::after { animation:none; transform:none; } }
.channel-load-status { display:flex; gap:12px; align-items:center; padding:6px 12px; font-size:12px; background:var(--bg-secondary,#e5e7eb); color:var(--text-primary,#111827); flex-shrink:0; }
.channel-load-status[hidden] { display:none; }
.channel-load-status button,.delivery-status button { text-decoration:underline; cursor:pointer; }
.delivery-status { font-size:11px; opacity:.8; display:flex; gap:8px; justify-content:flex-end; }
.conversation-notification-button { margin-left:8px; font-size:12px; padding:4px 8px; border-radius:6px; }
.covo-settings-popover { position:fixed; top:80px; right:16px; z-index:10000; background:var(--bg-primary,#fff); color:var(--text-primary,#111827); padding:16px; border:1px solid #8885; border-radius:10px; box-shadow:0 8px 30px #0004; max-width:calc(100vw - 32px); }
.covo-settings-popover label { display:flex; flex-direction:column; gap:6px; margin:12px 0; }
.covo-settings-popover select { background:var(--bg-secondary,#e5e7eb); color:inherit; padding:8px; }
body.covo-background .animate-pulse,body.covo-background .covo-msg-loading-shimmer { animation-play-state:paused !important; }
.covo-quick-switcher { position:fixed; z-index:100001; top:15vh; left:50%; transform:translateX(-50%); width:min(540px,calc(100vw - 24px)); max-height:70dvh; overflow:auto; padding:16px; border-radius:12px; background:var(--bg-primary,#fff); color:var(--text-primary,#111827); box-shadow:0 0 0 100vmax #0007,0 12px 40px #0005; }
.covo-quick-switcher input { width:100%; padding:12px; background:var(--bg-secondary,#e5e7eb); color:inherit; border-radius:8px; }
.covo-quick-switcher button { display:block; padding:10px; text-align:left; width:100%; }
.covo-quick-switcher .selected { background:#5865f233; }
.server-search-results { max-height:35dvh; overflow:auto; width:100%; }
.server-search-results button { display:block; padding:8px; width:100%; text-align:left; border-bottom:1px solid #8883; }
