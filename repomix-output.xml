    body:not(.dark-server-theme):not(.discord-dark-theme).discord-ui-mode .discord-hero-btn-sec:hover {
      background: #475569;
    }
    body:not(.dark-server-theme):not(.discord-dark-theme).discord-ui-mode .discord-server-card {
      background: #ffffff !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
      color: #1e293b !important;
    }
    body:not(.dark-server-theme):not(.discord-dark-theme).discord-ui-mode .discord-server-card:hover {
      background: #f1f5f9 !important;
    }
    body:not(.dark-server-theme):not(.discord-dark-theme).discord-ui-mode .discord-card-icon {
      background: #e2e8f0;
      color: #1e293b;
    }
    body:not(.dark-server-theme):not(.discord-dark-theme).discord-ui-mode .discord-card-btn {
      background: #1e293b;
      color: #ffffff;
      border: 1px solid #0f172a;
    }
    body:not(.dark-server-theme):not(.discord-dark-theme).discord-ui-mode .discord-card-btn:hover {
      background: #0f172a;
    }

    /* モバイルビューのDiscordレイアウト適応（添付画像0/1/5/6/7完全準拠） */
    @media (max-width: 768px) {
      #discordTitleBar {
        display: none !important;
      }
      /* アプリ基盤背景色をサーバーナビ色と完全一致（時計周り・ステータスバー・角丸外側の一体化） */
      html, body, .container {
        background-color: #f2f3f5 !important;
      }
      body.dark-server-theme, html:has(body.dark-server-theme), body.dark-server-theme .container {
        background-color: #0b0f19 !important;
      }
      body.discord-dark-theme, html:has(body.discord-dark-theme), body.discord-dark-theme .container {
        background-color: #1e1f22 !important;
      }

      body.discord-ui-mode #appContainer {
        flex-direction: row !important;
        display: flex !important;
        width: 100% !important;
        height: 100% !important;
        flex: 1 1 0 !important;
        background: transparent !important;
        box-shadow: none !important;
      }

      /* スマホ表示時は右側メンバーリストを非表示にしてメイン画面を全幅にする */
      body.discord-ui-mode #discordHomeMembers {
        display: none !important;
      }
      /* #discordServerNav（添付画像準拠の幅70px & アイコン48px、下部スクロール余白80px） */
      body.discord-ui-mode #discordServerNav {
        width: 70px !important;
        min-width: 70px !important;
        padding-top: max(12px, var(--safe-top, env(safe-area-inset-top, 0px))) !important;
        padding-bottom: max(80px, calc(80px + var(--safe-bottom, env(safe-area-inset-bottom, 0px)))) !important;
        z-index: 30;
        background: transparent !important;
        border-right: none !important;
        overflow-y: auto;
        overflow-x: hidden;
      }
      body.discord-ui-mode #serverHeader {
        padding-top: max(8px, var(--safe-top, env(safe-area-inset-top, 0px))) !important;
        min-height: calc(48px + var(--safe-top, env(safe-area-inset-top, 0px))) !important;
        border-bottom: 1px solid rgba(0,0,0,0.06);
        box-sizing: border-box;
      }
      body.discord-ui-mode.dark-server-theme #serverHeader {
        border-bottom: 1px solid rgba(255,255,255,0.06);
      }
      /* サーバーアイコンサイズ（48px） */
      body.discord-ui-mode .discord-server-item {
        width: 48px !important;
        height: 48px !important;
        margin-bottom: 8px !important;
      }
      body.discord-ui-mode .discord-server-icon {
        width: 48px !important;
        height: 48px !important;
        font-size: 1.15rem !important;
      }
      /* モバイル時のピル左端密着調整 */
      body.discord-ui-mode .discord-server-pill {
        left: -11px !important;
      }
      body.discord-ui-mode .discord-server-item.active .discord-server-pill {
        height: 38px !important;
      }
      /* モバイル時：#sidebarに左上角丸28pxを適用し、下の余白も不要な影ゼロで実装！ */
      body.discord-ui-mode #sidebar {
        position: relative !important;
        left: auto !important;
        top: auto !important;
        flex: 1 1 auto !important;
        width: calc(100% - 70px) !important;
        max-width: calc(100% - 70px) !important;
        display: flex !important;
        min-width: 0 !important;
        border-top-left-radius: 28px !important;
        box-shadow: none !important; /* 下部の余計な影を完全排除 */
        overflow: hidden !important;
      }
      body.discord-ui-mode.dark-server-theme #sidebar {
        box-shadow: none !important;
      }
      /* ルームリスト（下部ユーザーバーに隠れないよう80pxパディングを確保） */
      body.discord-ui-mode #sidebar #roomList {
        padding-bottom: 80px !important;
      }
      /* 下部ユーザーミニバー（最前面に浮き出て、サーバーが増えても隠れない） */
      body.discord-ui-mode #sidebar #userPanel {
        position: absolute !important;
        bottom: max(10px, var(--safe-bottom, env(safe-area-inset-bottom, 0px))) !important;
        left: 8px !important;
        right: 8px !important;
        z-index: 50 !important;
        background-color: #ffffff !important;
        border: 1px solid #e2e8f0 !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06) !important;
        margin: 0 !important;
      }
      body.discord-ui-mode.dark-server-theme #sidebar #userPanel {
        background-color: #162032 !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4) !important;
      }
      /* ルームリスト全体の余白とアイテムデザインをプロフェッショナル仕様に極上化 */
      body.discord-ui-mode #sidebar .overflow-y-auto {
        padding: 12px 10px !important;
      }
      body.discord-ui-mode .room-item-animate {
        border-radius: 10px !important;
        padding: 11px 12px !important;
        margin-bottom: 6px !important;
        transition: all 0.15s ease !important;
      }
      /* スマホ表示時の全体メンバーリスト非表示（画面幅240px占拠・探索画面押し潰れの完全防止） */
      body.discord-ui-mode #discordHomeMembers {
        display: none !important;
      }

      /* 各ヘッダー（探索・DM・チャット）に Safe Area Top を適用してダイナミックアイランドを回避 */
      body.discord-ui-mode #discordDiscoverHeader,
      body.discord-ui-mode #discordDmHeader,
      #currentRoomHeader {
        padding-top: max(8px, env(safe-area-inset-top, 0px)) !important;
        min-height: calc(48px + env(safe-area-inset-top, 0px)) !important;
        height: auto !important;
        box-sizing: border-box !important;
      }

      /* スマホ表示のホーム状態：ディスカバリーとDMの切り替え適応（全幅に最適化） */
      body.discord-ui-mode.discord-discover-view #sidebar {
        display: none !important;
      }
      body.discord-ui-mode.discord-discover-view #discordDiscoverView {
        flex: 1 1 0% !important;
        width: auto !important;
        max-width: none !important;
        display: flex !important;
        padding: 0 !important;
        min-width: 0 !important;
        overflow-x: hidden !important;
      }
      body.discord-ui-mode.discord-dm-view #discordDmHomeView {
        display: none !important;
      }
      body.discord-ui-mode.discord-dm-view #sidebar {
        display: flex !important;
        flex: 1 1 0% !important;
        width: auto !important;
        max-width: none !important;
        min-width: 0 !important;
      }
      body.discord-ui-mode.discord-dm-view #discordHomeSidebar {
        display: flex !important;
        width: 100% !important;
      }

      /* チャット画面表示中：親Flexコンテナ内で自然に全画面展開（fixed inset 0 の破壊的レイアウトを廃止） */
      body.discord-ui-mode.in-chat-view #discordServerNav,
      body.discord-ui-mode.in-chat-view #sidebar {
        display: none !important;
      }
      body.discord-ui-mode.in-chat-view #chatArea {
        position: relative !important;
        inset: auto !important;
        z-index: 10 !important;
        display: flex !important;
        width: 100% !important;
        height: 100% !important;
        flex: 1 1 0% !important;
        min-height: 0 !important;
      }
      /* チャット画面非表示時(ルーム一覧等)：チャットエリアを完全非表示 */
      body.discord-ui-mode:not(.in-chat-view) #chatArea {
        display: none !important;
      }
    }

    /* サーバー追加モーダルの「参加」ボタン - ダークモード対応 */
    .add-server-join-btn {
      background-color: #f1f5f9;
      color: #1e293b;
    }
    .add-server-join-btn:hover {
      background-color: #e2e8f0;
    }
    .add-server-join-icon {
      background-color: #e2e8f0;
      color: #475569;
    }
    .add-server-join-sub {
      color: #64748b;
    }
    .add-server-join-arrow {
      color: #94a3b8;
    }
    .add-server-join-btn:hover .add-server-join-arrow {
      color: #475569;
    }
    body.dark-server-theme .add-server-join-btn {
      background-color: #1e293b !important;
      color: #e2e8f0 !important;
    }
    body.dark-server-theme .add-server-join-btn:hover {
      background-color: #243040 !important;
    }
    body.dark-server-theme .add-server-join-icon {
      background-color: #243040 !important;
      color: #94a3b8 !important;
    }
    body.dark-server-theme .add-server-join-sub {
      color: #64748b !important;
    }
    body.dark-server-theme .add-server-join-arrow {
      color: #475569 !important;
    }
    body.dark-server-theme .add-server-join-btn:hover .add-server-join-arrow {
      color: #94a3b8 !important;
    }


    /* --- Google Material Design Channel List UI --- */
    body.discord-ui-mode .room-item-animate {
      background: transparent !important;
      color: #4b5563 !important;
      transition: background 0.2s cubic-bezier(0.4, 0, 0.2, 1), color 0.2s ease !important;
      font-weight: 600 !important;
      border-radius: 9999px !important; /* Material Pill Shape */
      padding: 0.4rem 1rem !important; /* Slightly more padding for pill */
      margin-left: 0.25rem !important;
      margin-right: 0.25rem !important;
      margin-bottom: 0.25rem !important;
    }
    body.discord-ui-mode .room-item-animate .room-hashtag {
      color: #9ca3af !important;
      margin-right: 0.5rem !important;
    }
    body.discord-ui-mode .room-item-animate:hover {
      background: rgba(0, 0, 0, 0.08) !important;
      color: #111827 !important;
    }
    body.discord-ui-mode .room-item-animate:hover .room-hashtag {
      color: #6b7280 !important;
    }
    body.discord-ui-mode .room-item-animate.active {
      background: rgba(0, 0, 0, 0.12) !important;
      color: #111827 !important;
    }
    body.discord-ui-mode .room-item-animate.active .room-hashtag {
      color: #374151 !important;
    }

    /* Dark Server Theme Overrides */
    body.dark-server-theme.discord-ui-mode .room-item-animate {
      color: #9ca3af !important;
    }
    body.dark-server-theme.discord-ui-mode .room-item-animate .room-hashtag {
      color: #6b7280 !important;
    }
    body.dark-server-theme.discord-ui-mode .room-item-animate:hover {
      background: rgba(255, 255, 255, 0.08) !important;
      color: #f3f4f6 !important;
    }
    body.dark-server-theme.discord-ui-mode .room-item-animate:hover .room-hashtag {
      color: #9ca3af !important;
    }
    body.dark-server-theme.discord-ui-mode .room-item-animate.active {
      background: rgba(255, 255, 255, 0.12) !important;
      color: #ffffff !important;
    }
    body.dark-server-theme.discord-ui-mode .room-item-animate.active .room-hashtag {
      color: white !important;
    }

    /* 未ログイン時の完全表示制御（認証確定前はスプラッシュ表示、認証確定後かつ未ログイン時のみログイン画面を表示） */
    body:not(.auth-ready) #appContainer,
    body:not(.auth-ready) #serverListScreen,
    body:not(.auth-ready) #globalAppHeader,
    body:not(.auth-ready) #nicknameContainer,
    body:not(.auth-ready) #authContainer {
      display: none !important;
    }
    body.auth-ready:not(.logged-in) #appContainer,
    body.auth-ready:not(.logged-in) #serverListScreen,
    body.auth-ready:not(.logged-in) #globalAppHeader,
    body.auth-ready:not(.logged-in) #nicknameContainer {
      display: none !important;
    }
    body.auth-ready:not(.logged-in) #authContainer {
      display: flex !important;
      width: 100% !important;
      min-height: 100vh !important;
    }
    /* ----------------------------------- */
</file>

