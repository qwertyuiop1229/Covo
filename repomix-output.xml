    if (unsubDoc) { unsubDoc(); unsubDoc = null; }
    if (unsubCands) { unsubCands(); unsubCands = null; }
    if (pc) { try { pc.close(); } catch (_) {} pc = null; }
    deleteDoc(syncDocRef).catch(() => {});
