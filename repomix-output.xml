    /* モバイルビューのDiscordレイアウト適応（添付画像0/1/5/6/7完全準拠） */
    @media (max-width: 768px) {
      #discordTitleBar {
        display: none !important;
      }
      /* アプリ基盤背景色をサーバーナビ色と完全一致（時計周り・ステータスバー・角丸外側の一体化） */
      html, body, .container {
        background-color: #f2f3f5 !important;
      }
      body.dark-server-theme, html:has(body.dark-server-theme), body.dark-server-theme .container {
        background-color: #0b0f19 !important;
