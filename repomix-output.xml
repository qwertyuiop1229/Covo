    }
    /* =========================================================================
       Discord風 アプリ内通知 (In-App Notification) PC & スマホ
       ========================================================================= */
    /* PC用トーストカード */
    .discord-notif-pc {
      width: 320px;
      max-width: calc(100vw - 32px);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      pointer-events: auto;
      cursor: pointer;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
      animation: notifSlideInUp 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease, box-shadow 0.2s ease;
      user-select: none;
    }
    .discord-notif-pc:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
    }
    .discord-notif-pc.dismissing {
      animation: notifSlideOutRight 0.22s cubic-bezier(0.4, 0, 1, 1) forwards !important;
      pointer-events: none;
    }
    .discord-notif-pc.pop-update {
      animation: notifPopUpdate 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes notifSlideInUp {
      from { opacity: 0; transform: translateY(20px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes notifSlideOutRight {
      from { opacity: 1; transform: translateX(0); }
      to { opacity: 0; transform: translateX(50px) scale(0.9); }
    }
    @keyframes notifPopUpdate {
      0% { transform: scale(1); }
      50% { transform: scale(1.04); }
      100% { transform: scale(1); }
    }
    /* プログレスバー（消えるまでのタイマー） */
    .discord-notif-progress {
      position: absolute;
      top: 0;
      left: 0;
      height: 3px;
      background: #5865f2;
      width: 100%;
      transform-origin: left;
      animation: notifProgressLinear linear forwards;
    }
    .discord-notif-pc:hover .discord-notif-progress {
      animation-play-state: paused;
    }
    @keyframes notifProgressLinear {
      from { width: 100%; }
      to { width: 0%; }
    }
    /* モバイル用スライドインバナー */
    .discord-notif-mobile {
      width: 100%;
      max-width: 480px;
      border-radius: 16px;
      overflow: hidden;
      position: relative;
      pointer-events: auto;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      animation: notifSlideInDown 0.32s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      touch-action: pan-y;
      user-select: none;
    }
