      <p id="mobileNotifEmpty" style="text-align:center;color:#9ca3af;font-size:0.85rem;padding:2rem 0">通知はありません</p>
      <div id="mobileNotifList"></div>
    </div>
  </div>

<!-- 全体お知らせ / What's New モーダル -->
  <div id="whatsNewModal" class="fixed inset-0 modal-overlay flex items-center justify-center z-[99998] hidden p-4" onclick="if(event.target===this) closeWhatsNewModal()">
    <div class="bg-white dark:bg-[#313338] border border-gray-200 dark:border-[#202225] rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col modal-box animate-pop-in text-gray-800 dark:text-gray-200 max-h-[85vh]">
      <div class="p-6 bg-gradient-to-r from-indigo-600 to-purple-600 text-white flex items-center justify-between flex-shrink-0 relative overflow-hidden">
        <div class="relative z-10">
          <div class="flex items-center gap-2 mb-1">
            <span id="whatsNewTypeBadge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-white/20 text-white tracking-wider uppercase">UPDATE</span>
            <span id="whatsNewVersion" class="text-xs font-mono font-bold text-white/90"></span>
          </div>
          <h2 id="whatsNewTitle" class="text-xl font-black tracking-tight text-white">最新アップデートのお知らせ</h2>
          <p id="whatsNewDate" class="text-[11px] text-white/75 mt-0.5"></p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-white/10 backdrop-blur flex items-center justify-center text-white text-2xl flex-shrink-0 relative z-10">
          <i id="whatsNewIcon" class="fas fa-sparkles"></i>
        </div>
      </div>
      <div class="p-6 overflow-y-auto flex-1 text-sm leading-relaxed whitespace-pre-wrap select-text text-gray-700 dark:text-gray-300 font-sans" id="whatsNewContent"></div>
      <div class="p-4 border-t border-gray-100 dark:border-white/5 flex items-center justify-between bg-gray-50/50 dark:bg-[#2b2d31]/50 flex-shrink-0">
        <span class="text-[11px] text-gray-400">アプリ情報からいつでも再確認できます</span>
        <button onclick="closeWhatsNewModal()" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-md transition-all">
          確認しました
        </button>
      </div>
    </div>
  </div>

<div id="feedbackModal" class="fixed inset-0 modal-overlay flex items-center justify-center z-50 hidden p-4">
    <div class="bg-[#313338] rounded-2xl shadow-2xl w-full max-w-sm modal-box confirm-box animate-pop-in overflow-hidden flex flex-col border border-[#1e1f22]" style="max-height: 90vh;">
      <div class="p-5 border-b border-[#1e1f22] flex items-center gap-3 bg-[#2b2d31]">
        <div class="w-10 h-10 rounded-full bg-[#1e1f22] text-indigo-400 flex items-center justify-center flex-shrink-0 shadow-inner">
          <i class="fas fa-bug text-lg"></i>
        </div>
        <div>
          <h2 class="text-base font-bold text-gray-100 leading-snug">バグ報告・フィードバック</h2>
          <p class="text-xs text-gray-400 mt-0.5">アプリの改善にご協力ください</p>
        </div>
      </div>
      <div class="p-5 flex-1 overflow-y-auto custom-scrollbar bg-[#313338]">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-bold text-gray-300 mb-1.5">カテゴリ</label>
            <div class="relative">
              <select id="feedbackCategory" class="w-full py-2.5 pl-3 pr-8 bg-[#1e1f22] border border-[#1e1f22] rounded-xl text-sm text-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all appearance-none cursor-pointer shadow-inner">
                <option value="bug">バグ報告</option>
                <option value="feature">機能要望</option>
                <option value="other">その他</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-500">
                <i class="fas fa-chevron-down text-xs"></i>
              </div>
            </div>
          </div>
          <div>
            <label class="block text-sm font-bold text-gray-300 mb-1.5">内容 <span class="text-xs font-normal text-gray-500 ml-1">(必須)</span></label>
            <textarea id="feedbackContent" rows="5" class="w-full p-3 bg-[#1e1f22] border border-[#1e1f22] rounded-xl text-sm text-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all resize-none placeholder-gray-500 shadow-inner" placeholder="具体的な状況やご意見をお書きください..."></textarea>
          </div>
        </div>
      </div>
      <div class="p-4 bg-[#2b2d31] border-t border-[#1e1f22] flex justify-end gap-2">
        <button onclick="window.closeFeedbackModal && window.closeFeedbackModal()" class="px-4 py-2 rounded-xl text-sm font-bold text-gray-300 hover:text-white hover:underline transition-all">キャンセル</button>
        <button onclick="window.submitFeedback && window.submitFeedback()" id="feedbackSubmitBtn" class="px-5 py-2 rounded-xl text-sm font-bold text-white bg-indigo-500 hover:bg-indigo-600 shadow-lg hover:shadow-indigo-500/25 active:scale-95 transition-all flex items-center justify-center min-w-[90px]">送信</button>
      </div>
    </div>
  </div>
  <!-- 地理学習（隠し機能）用コンテナとスクリプト -->
  <div id="geoStudyContainer" class="hidden fixed inset-0 z-[9999999] bg-gray-900 flex-col overflow-hidden text-white"></div>
  <link rel="stylesheet" href="css/geo_study.css" />
  <script src="js/geo_study.js" defer></script>
  <script src="js/geoguessr_locations.js" defer></script>
</body>
</html>
