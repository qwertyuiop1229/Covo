    if (!targetUser) {
      feedback.className = 'text-xs font-semibold px-2 min-h-[1.25rem] text-rose-500';
      feedback.textContent = 'ユーザーが見つかりませんでした。綴りを確認してください。';
      btn.disabled = false;
