    if (targetUser.id === userId) {
      feedback.className = 'text-xs font-semibold px-2 min-h-[1.25rem] text-rose-500';
      feedback.textContent = '自分自身にフレンド申請を送信することはできません。';
      btn.disabled = false;
      return;
