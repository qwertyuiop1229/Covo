      const idxA = recent.indexOf(a.nickname);
      const idxB = recent.indexOf(b.nickname);
      if (idxA !== -1 && idxB !== -1) return idxA - idxB;
      if (idxA !== -1) return -1;
      if (idxB !== -1) return 1;
      return a.nickname.localeCompare(b.nickname);
