    }

    /* ===== スタンプ ===== */
    /* スタンプメッセージは吹き出しの背景・枠を消して絵文字だけ大きく見せる */
    .message-bubble.sticker-bubble {
      background: transparent !important;
      box-shadow: none !important;
      padding: 2px 0 !important;
      border: none !important;
    }
    .sticker-content { line-height: 1; font-size: 128px; }
    .sticker-content img.emoji { width: 128px !important; height: 128px !important; object-fit: contain; margin: 0 !important; display: block; }
    /* 本文中のTwemoji絵文字は文字サイズに馴染ませる */
    .message-content img.emoji { width: 1.3em; height: 1.3em; vertical-align: -0.25em; margin: 0 1px; }

    /* スタンプピッカー */
    #stickerPicker {
      position: fixed; z-index: 99996; display: none;
      background: #ffffff; border: 1px solid #e5e7eb; border-radius: 18px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.18);
      width: 360px; max-width: calc(100vw - 20px);
      height: 420px; max-height: 60vh; flex-direction: column; overflow: hidden;
    }
    #stickerPicker.show { display: flex; }
    body.dark-server-theme #stickerPicker,
    body.discord-dark-theme #stickerPicker { background: #1e293b; border-color: rgba(255,255,255,0.1); }
    body.discord-dark-theme #stickerPicker { background: #2b2d31; border-color: #383a40; }
    .sticker-tabs {
      display: flex; gap: 2px; padding: 8px; border-bottom: 1px solid #f3f4f6;
      overflow-x: auto; flex-shrink: 0; scrollbar-width: none;
    }
    .sticker-tabs::-webkit-scrollbar { display: none; }
    body.dark-server-theme .sticker-tabs,
    body.discord-dark-theme .sticker-tabs { border-bottom-color: rgba(255,255,255,0.08); }
    body.discord-dark-theme .sticker-tabs { border-bottom-color: #1f2023; }
    .sticker-tab {
      flex-shrink: 0; width: 34px; height: 34px; border: none; background: transparent;
      border-radius: 9px; cursor: pointer; font-size: 1.1rem; display: flex;
      align-items: center; justify-content: center; color: #9ca3af; transition: background 0.12s;
    }
    .sticker-tab.active { background: #eef2ff; }
    body.dark-server-theme .sticker-tab.active,
    body.discord-dark-theme .sticker-tab.active { background: #334155; }
    body.discord-dark-theme .sticker-tab.active { background: #35373c; }
    .sticker-tab img.emoji { width: 22px; height: 22px; }
    .sticker-grid {
      flex: 1; overflow-y: auto; padding: 12px;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; align-content: start;
    }
    .sticker-cell {
      aspect-ratio: 1; border: none; background: transparent; border-radius: 14px;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background 0.12s, transform 0.08s; position: relative; -webkit-tap-highlight-color: transparent;
    }
    .sticker-cell:hover { background: #f3f4f6; }
    .sticker-cell:active { background: #eef2ff; transform: scale(0.9); }
    body.dark-server-theme .sticker-cell:hover,
    body.discord-dark-theme .sticker-cell:hover { background: #283548; }
    body.discord-dark-theme .sticker-cell:hover { background: #35373c; }
    body.dark-server-theme .sticker-cell:active,
    body.discord-dark-theme .sticker-cell:active { background: #334155; }
    body.discord-dark-theme .sticker-cell:active { background: #3f4248; }
    .sticker-cell .sk-em { font-size: 52px; line-height: 1; }
    .sticker-cell img.emoji { width: 56px; height: 56px; }
    .sticker-cat-label {
      grid-column: 1 / -1; font-size: 0.68rem; font-weight: 700; color: #9ca3af;
      padding: 6px 4px 2px; text-transform: uppercase; letter-spacing: 0.04em;
    }
    .sticker-fav-star {
      position: absolute; top: 2px; right: 2px; font-size: 0.6rem; color: #f59e0b; display: none;
    }
    .sticker-cell.is-fav .sticker-fav-star { display: block; }
    .sticker-empty { grid-column: 1/-1; text-align: center; color: #9ca3af; font-size: 0.8rem; padding: 24px 0; }

    /* 独立アクションボタン（ファイル添付・メンション） */
