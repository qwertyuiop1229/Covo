{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "removeComments": false,
    "removeEmptyLines": true,
    "showLineNumbers": false,
    "copyToClipboard": false
  },
  "include": [],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "repomix-output.xml",
      "repomix.config.json",
      "package-lock.json",
      "yarn.lock",

      ".patch_backup/",
      "scratch/",
      "tools/",

      "node_modules/",
      "server/node_modules/",

      "public/assets/",
      "public/covo-stamps/",
      "public/webfonts/",
      "public/icons/",
      "public/img/",

      "public/js/geoguessr_locations.js",
      "public/css/font-awesome.min.css",
      "public/css/styles.css",

      "public/404.html",
      "public/.repomixignore",

      "scripts/migrate_firestore_to_rtdb.js",
      "scripts/cleanup_webrtc*.js",
      "scripts/generate_geoguessr_data.py",

      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.ico",
      "*.woff2",
      "*.ttf",
      "*.svg",
      "*.gif",
      "*.webp",

      "dist/",
      "build/",
      ".wrangler/",
      "server/.wrangler/",
      ".firebase/",

      "src-tauri/target/"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}