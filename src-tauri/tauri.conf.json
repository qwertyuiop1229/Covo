      "endpoints": [
        "https://github.com/qwertyuiop1229/Covo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVERjY0RTU1QjU4QjlCOTYKUldTV200dTFWVTcyWGRJaEEzaEQyL29tVHFjMVZoT2JaeTlxalZ1b0daUkZoOWMyRndDSWRNVncK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "windows": {
      "nsis": {
        "languages": [
