rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // 🛡️ ユーティリティ関数 & ロール判定 (軽量・高速化)
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // アプリ全体管理者 (Super Admin / Global Admin)
    function isGlobalAdmin(appId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList) &&
        (
          ('emails' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data && 'email' in request.auth.token && request.auth.token.email in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data.emails) ||
          ('admins' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data.admins)
        );
    }

    // ログイン許可リスト管理者 (List Admin)
    function isListAdmin(appId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList) &&
        (
          ('emails' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data && 'email' in request.auth.token && request.auth.token.email in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data.emails) ||
          ('admins' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data.admins)
        );
    }

    // サーバー管理者 / モデレーター判定 (get呼び出しを1回のみに集約)
    function isServerAdmin(appId, serverId) {
      return isAuthenticated() && (
        isGlobalAdmin(appId) ||
        (
          exists(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)) &&
          (
            request.auth.uid == get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data.createdBy ||
            ('serverAdmins' in get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data &&
             request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data.serverAdmins)
          )
        )
      );
    }

    // サーバーオーナー判定
    function isServerOwner(appId, serverId) {
      return isAuthenticated() && (
        isGlobalAdmin(appId) ||
        (
          exists(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)) &&
          request.auth.uid == get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data.createdBy
        )
      );
    }

    // ========================================================================
    // 📁 各コレクションのセキュリティルール
    // ========================================================================

    match /artifacts/{appId} {

      // 1. 全体設定 (Settings)
      match /settings/{docId} {
        allow read: if (isAuthenticated() && docId != 'allowedEmails') || isGlobalAdmin(appId);
        allow write: if isGlobalAdmin(appId);
      }
      match /settings/allowedEmailsConfig {
        allow read: if isAuthenticated();
        allow write: if isListAdmin(appId) || isGlobalAdmin(appId);
      }
      
      // ログイン許可リスト (Allowed Emails)
      match /allowedEmails/{emailId} {
        allow get: if isAuthenticated();
        allow list: if isGlobalAdmin(appId) ||
                    (isListAdmin(appId) && ('addedBy' in resource.data && resource.data.addedBy == request.auth.uid));
        allow create: if isGlobalAdmin(appId) ||
                      (isListAdmin(appId) && request.resource.data.addedBy == request.auth.uid);
        allow update, delete: if isGlobalAdmin(appId) ||
                              (isListAdmin(appId) && ('addedBy' in resource.data && resource.data.addedBy == request.auth.uid));
      }

      // 全体サーバーカスタムスタンプ
      match /server_stamps/{docId} {
        allow read: if isAuthenticated();
        allow write: if isGlobalAdmin(appId);
      }

      // バグ報告・フィードバック
      match /feedbacks/{docId} {
        allow create: if isAuthenticated() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 10000 &&
          (!('category' in request.resource.data) ||
           request.resource.data.category in ['bug', 'feature', 'other']);
        allow read, update, delete: if isGlobalAdmin(appId);
      }

      // 全体お知らせ・リリースノート (What's New)
      match /announcements/{docId} {
        allow read: if isAuthenticated();
        allow write: if isGlobalAdmin(appId);
      }

      // システムエラー・警告テレメトリ
      match /error_reports/{docId} {
        allow create, update: if
          request.resource.data.message is string &&
          request.resource.data.message.size() > 0 &&
          request.resource.data.message.size() <= 8000;
        allow read: if isAuthenticated();
        allow delete: if isGlobalAdmin(appId) || isListAdmin(appId);
      }

      // 緊急アカウントリカバリー保管庫
      match /recovery_vault/{userDocId} {
        allow read: if isAuthenticated() && (request.auth.uid == userDocId || isGlobalAdmin(appId));
        allow write: if isAuthenticated() && request.auth.uid == userDocId;
      }
      match /recovery_index/{emailHash} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isGlobalAdmin(appId));
        allow update, delete: if isAuthenticated() && (('userId' in resource.data && resource.data.userId == request.auth.uid) || isGlobalAdmin(appId));
      }

      // 管理者承認による緊急パスワード再設定支援 (ワンタイムPIN)
      match /admin_recovery_requests/{userDocId} {
        allow read: if isAuthenticated() && (request.auth.uid == userDocId || isGlobalAdmin(appId));
        allow write: if isGlobalAdmin(appId);
      }
      match /admin_recovery_index/{emailHash} {
        allow read: if isGlobalAdmin(appId);
        allow write: if isGlobalAdmin(appId);
      }

      // モデレーション監査ログ (Audit Logs)
      match /audit_logs/{logId} {
        allow read: if isAuthenticated() && (isGlobalAdmin(appId) || isListAdmin(appId));
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }

      // 招待コードインデックス (逆引き)
      match /inviteIndex/{code} {
        allow get: if isAuthenticated();
        allow create: if isServerAdmin(appId, request.resource.data.serverId);
        allow update: if isServerAdmin(appId, resource.data.serverId) && isServerAdmin(appId, request.resource.data.serverId);
        allow delete: if isServerAdmin(appId, resource.data.serverId);
      }

      // 2. ユーザー情報 (Users & Profiles)
      match /users/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin(appId));
      }

      match /userQuotas/{qUserId} {
        allow read: if isAuthenticated() && (request.auth.uid == qUserId || isGlobalAdmin(appId));
        allow write: if isGlobalAdmin(appId);
      }

      match /users/{userId}/profile/{docId} {
        allow get: if isAuthenticated();
        allow list: if isGlobalAdmin(appId);
        allow write: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin(appId));
      }

      // E2EE 秘密鍵バックアップ (本人のみ読み書き)
      match /users/{userId}/private/{docId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // 既読状態の同期
      match /users/{userId}/readStates/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin(appId));
      }

      // フレンド関係性 (Relationships)
      match /users/{userId}/relationships/{targetUserId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (
          isGlobalAdmin(appId) ||
          request.auth.uid == userId ||
          (request.auth.uid == targetUserId && (
            (request.resource.data.status == 'pending_received' && (resource == null || !('status' in resource.data) || resource.data.status != 'blocked')) ||
            (request.resource.data.status == 'friends' && resource != null && 'status' in resource.data && resource.data.status == 'pending_sent')
          ))
        );
        allow delete: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == targetUserId || isGlobalAdmin(appId));
      }

      // ダイレクトメッセージ (DM) チャンネル
      match /dm_channels/{dmId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants || isGlobalAdmin(appId));
        allow update, delete: if isAuthenticated() && (request.auth.uid in resource.data.participants || isGlobalAdmin(appId));

        match /keys/{keyUserId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated() &&
            (isGlobalAdmin(appId) ||
             (exists(/databases/$(database)/documents/artifacts/$(appId)/dm_channels/$(dmId)) &&
              request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/dm_channels/$(dmId)).data.participants) ||
             dmId.matches('^' + request.auth.uid + '_.*') ||
             dmId.matches('^.*_' + request.auth.uid + '$'));
        }
      }

      // 端末間データ移行 (P2P Device Transfers)
      match /device_transfers/{sessionCode} {
        allow read, delete: if isAuthenticated();
        allow create, update: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isGlobalAdmin(appId));
        match /{subcollection}/{docId} {
          allow read, write: if isAuthenticated();
        }
      }

      // P2P 過去ログ分散補完 (P2P Log Sync)
      match /p2p_log_sync/{syncId} {
        allow read, delete: if isAuthenticated();
        allow create: if isAuthenticated() &&
          (isGlobalAdmin(appId) ||
           (request.resource.data.requesterUid == request.auth.uid &&
            (!('dmId' in request.resource.data) ||
             request.resource.data.dmId == null ||
             request.resource.data.dmId == request.auth.uid + '_' + request.resource.data.targetUid ||
             request.resource.data.dmId == request.resource.data.targetUid + '_' + request.auth.uid)));
        allow update: if isAuthenticated();
        match /{subcollection}/{docId} {
          allow read, write: if isAuthenticated();
        }
      }

      // 3. グローバルオンライン状態 (Status)
      match /status/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin(appId));
      }

      // 4. P2P音声通話シグナリング (Calls)
      match /calls/{callId} {
        allow read, delete: if isAuthenticated();
        allow update: if isAuthenticated() &&
          (
            isGlobalAdmin(appId) ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['caller', 'callee', 'calleeUid'])
          );
        allow create: if isAuthenticated() &&
          (isGlobalAdmin(appId) ||
           ('caller' in request.resource.data && 'uid' in request.resource.data.caller &&
            request.resource.data.caller.uid == request.auth.uid));

        match /{subcollection}/{candId} {
          allow read, write: if isAuthenticated();
        }
      }

      // 4b. P2Pファイル共有シグナリング (File Shares)
      match /fileshares/{shareId} {
        allow read, delete: if isAuthenticated();
        allow update: if isAuthenticated() &&
          (
            isGlobalAdmin(appId) ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sender', 'receiverUid'])
          );
        allow create: if isAuthenticated() &&
          (isGlobalAdmin(appId) ||
           ('sender' in request.resource.data && 'uid' in request.resource.data.sender &&
            request.resource.data.sender.uid == request.auth.uid));

        match /{subcollection}/{candId} {
          allow read, write: if isAuthenticated();
        }
      }

      // ========================================================================
      // 🏰 サーバーベース構造 (Servers, Rooms, Messages)
      // ========================================================================

      match /servers/{serverId} {
        allow read: if isAuthenticated();

        // サーバー作成: 自分自身を管理者・初期参加者として作成
        allow create: if isAuthenticated() &&
          (isGlobalAdmin(appId) ||
           (request.resource.data.createdBy == request.auth.uid &&
            request.resource.data.serverAdmins == [request.auth.uid] &&
            request.resource.data.joinedUsers == [request.auth.uid]));

        // サーバー設定の更新:
        allow update: if (isServerOwner(appId, serverId) || isGlobalAdmin(appId)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']);

        allow update: if isServerAdmin(appId, serverId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']) &&
          (!('serverAdmins' in request.resource.data) || ('createdBy' in resource.data && resource.data.createdBy in request.resource.data.serverAdmins));

        allow update: if isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['joinedUsers', 'serverAdmins', 'memberCount']) &&
          request.auth.uid in resource.data.joinedUsers &&
          request.resource.data.joinedUsers == resource.data.joinedUsers.removeAll([request.auth.uid]) &&
          (!('serverAdmins' in resource.data) ? (!('serverAdmins' in request.resource.data)) : (request.resource.data.serverAdmins == resource.data.serverAdmins.removeAll([request.auth.uid]))) &&
          (!('memberCount' in resource.data) || request.resource.data.memberCount == resource.data.memberCount - 1);

        // サーバー削除: サーバーオーナーまたは全体管理者のみ
        allow delete: if isServerOwner(appId, serverId) || isGlobalAdmin(appId);

        // サーバー内の秘密情報 (パスワードハッシュ等)
        match /secrets/{docId} {
          allow read, write: if isServerAdmin(appId, serverId) || isGlobalAdmin(appId);
          allow delete: if isServerOwner(appId, serverId) || isGlobalAdmin(appId);
        }

        // ルーム一覧 (Channels / Rooms)
        match /rooms/{roomId} {
          allow read: if isAuthenticated();
          allow create, delete: if isServerAdmin(appId, serverId);
          allow update: if isServerAdmin(appId, serverId) || (
            isAuthenticated() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageSender', 'lastMessageText', 'sharedKey', 'legacyKeyMigrated', 'currentKeyVersion'])
          );

          // ルーム内メッセージ (Messages)
          match /messages/{messageId} {
            allow read: if isAuthenticated();
            allow create: if isAuthenticated() &&
              (request.resource.data.senderId == request.auth.uid || isGlobalAdmin(appId)) &&
              (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 32000));

            allow update: if isAuthenticated() && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
               request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned']) && (resource.data.senderId == request.auth.uid || isServerAdmin(appId, serverId)))
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned', 'reactions']) && (resource.data.senderId == request.auth.uid || isServerAdmin(appId, serverId)))
              || (resource.data.senderId == request.auth.uid
                  && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'createdAt', 'timestamp', 'isPinned'])
                  && (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 32000)))
              || isGlobalAdmin(appId)
            );

            allow delete: if isAuthenticated() && (
              resource.data.senderId == request.auth.uid ||
              (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
              isServerAdmin(appId, serverId) ||
              isServerOwner(appId, serverId) ||
              isGlobalAdmin(appId)
            );
          }

          // 既読レシート (Read Receipts)
          match /readReceipts/{receiptUserId} {
            allow read: if isAuthenticated();
            allow create, update: if isAuthenticated() &&
              (request.auth.uid == receiptUserId || isGlobalAdmin(appId));
            allow delete: if isAuthenticated() &&
              (request.auth.uid == receiptUserId || isServerAdmin(appId, serverId));
          }

          // E2EE ルーム暗号鍵 (Room Keys: 全メンバーの自動バックフィル・救済配布を許可)
          match /roomKeys/{keyId} {
            allow read, write: if isAuthenticated();
          }

          // E2EE 救済リクエスト (Rescue Requests)
          match /rescueRequests/{reqUserId} {
            allow read, delete: if isAuthenticated();
            allow create, update: if isAuthenticated() && (request.auth.uid == reqUserId || isGlobalAdmin(appId));
          }

          // タイピングインジケーター (Typing)
          match /typing/{userId} {
            allow read: if isAuthenticated();
            allow write: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin(appId));
          }
        }

        // サーバー別プロフィール (Profiles)
        match /profiles/{profileUserId} {
          allow read: if isAuthenticated();
          allow create, update: if isAuthenticated() &&
            (request.auth.uid == profileUserId || isGlobalAdmin(appId));
          allow delete: if isAuthenticated() &&
            (request.auth.uid == profileUserId || isServerAdmin(appId, serverId));
        }

        // サーバーカスタムスタンプ (Stamps)
        match /stamps/{stampId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() &&
            (request.resource.data.createdBy == request.auth.uid || isGlobalAdmin(appId)) &&
            request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.name.size() <= 32 &&
            request.resource.data.url is string &&
            (request.resource.data.url.matches('https://.*') || request.resource.data.url.matches('data:image/.*'));
          allow delete, update: if isServerAdmin(appId, serverId) || isGlobalAdmin(appId);
        }

        // スタンプグループ (Stamp Groups)
        match /stampGroups/{groupId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() &&
            (request.resource.data.createdBy == request.auth.uid || isGlobalAdmin(appId)) &&
            request.resource.data.name is string;
          allow delete, update: if isServerAdmin(appId, serverId) || isGlobalAdmin(appId);
        }

        // 招待コード (Invite Codes)
        match /inviteCodes/{code} {
          allow get: if isAuthenticated();
          allow list: if isServerAdmin(appId, serverId);
          allow write: if isServerAdmin(appId, serverId);
        }
      }

      // VC シグナリング (P2P WebRTC Offer/Answer/ICE候補交換 - artifacts配下)
      match /vc_signaling/{sigDocId} {
        allow read, delete: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.toUid is string;
      }
    }

    // ルート直下 VC シグナリング (フォールバック用)
    match /vc_signaling/{sigDocId} {
      allow read, delete: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string;
    }

  }
}
