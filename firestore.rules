rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // 🛡️ ユーティリティ関数 & ロール判定 (軽量・高速化)
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }
    function messageSummaryIsConsistent() {
      let data = request.resource.data;
      return (data.get('lastMessageAt', null) == null && data.get('lastMessageId', null) == null) ||
        (data.get('lastMessageAt', null) is timestamp && data.get('lastMessageId', null) is string &&
         data.lastMessageId.size() > 0 && data.lastMessageId.size() <= 160 &&
         data.get('lastMessageStorageVersion', 0) in [1, 2] &&
         data.get('lastMessageStorageTimestamp', null) == data.lastMessageAt.toMillis());
    }
    function preservesMessageSummary() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'lastMessageId', 'lastMessageStorageVersion', 'lastMessageStorageTimestamp',
        'lastMessageAt', 'lastMessageSender', 'lastMessageSenderNickname', 'lastMessageText'
      ]) || messageSummaryIsConsistent();
    }

    // アプリ全体管理者 (Super Admin / Global Admin)
    function isGlobalAdmin(appId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList) &&
        (
          ('emails' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data && 'email' in request.auth.token && request.auth.token.email in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data.emails) ||
          ('admins' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/settings/adminList).data.admins)
        );
    }

    // ログイン許可リスト管理者 (List Admin)
    function isListAdmin(appId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList) &&
        (
          ('emails' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data && 'email' in request.auth.token && request.auth.token.email in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data.emails) ||
          ('admins' in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/settings/listAdminList).data.admins)
        );
    }

    // サーバー管理者 / モデレーター判定 (get呼び出しを1回のみに集約)
    function isServerAdmin(appId, serverId) {
      return isAuthenticated() && (
        isGlobalAdmin(appId) ||
        (
          exists(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)) &&
          (
            request.auth.uid == get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data.createdBy ||
            ('serverAdmins' in get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data &&
             request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data.serverAdmins)
          )
        )
      );
    }

    // サーバーオーナー判定
    function isServerOwner(appId, serverId) {
      return isAuthenticated() && (
        isGlobalAdmin(appId) ||
        (
          exists(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)) &&
          request.auth.uid == get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data.createdBy
        )
      );
    }

    // サーバーメンバー判定 (サーバー参加者またはサーバー管理者)
    function isServerMember(appId, serverId) {
      return isAuthenticated() && (
        isServerAdmin(appId, serverId) ||
        (
          exists(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)) &&
          ('joinedUsers' in get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data.joinedUsers)
        )
      );
    }

    // ========================================================================
    // 📁 各コレクションのセキュリティルール
    // ========================================================================

    match /artifacts/{appId} {

      // 1. 全体設定 (Settings)
      match /settings/{docId} {
        allow read: if (isAuthenticated() && docId != 'allowedEmails') || isGlobalAdmin(appId);
        allow write: if isGlobalAdmin(appId);
      }
      match /settings/allowedEmailsConfig {
        allow read: if isAuthenticated();
        allow write: if isListAdmin(appId) || isGlobalAdmin(appId);
      }

      // ログイン許可リスト (Allowed Emails)
      match /allowedEmails/{emailId} {
        allow get: if isAuthenticated();
        allow list: if isGlobalAdmin(appId) ||
                    (isListAdmin(appId) && ('addedBy' in resource.data && resource.data.addedBy == request.auth.uid));
        allow create: if isGlobalAdmin(appId) ||
                      (isListAdmin(appId) && request.resource.data.addedBy == request.auth.uid);
        allow update, delete: if isGlobalAdmin(appId) ||
                              (isListAdmin(appId) && ('addedBy' in resource.data && resource.data.addedBy == request.auth.uid));
      }

      // 全体サーバーカスタムスタンプ
      match /server_stamps/{docId} {
        allow read: if isAuthenticated();
        allow write: if isGlobalAdmin(appId);
      }

      // バグ報告・フィードバック
      match /feedbacks/{docId} {
        allow create: if isAuthenticated() &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 10000 &&
          (!('category' in request.resource.data) ||
           request.resource.data.category in ['bug', 'feature', 'other']);
        allow read, update, delete: if isGlobalAdmin(appId);
      }

      // 全体お知らせ・リリースノート (What's New)
      match /announcements/{docId} {
        allow read: if isAuthenticated();
        allow write: if isGlobalAdmin(appId);
      }

      // システムエラー・警告テレメトリ
      match /error_reports/{docId} {
        // Current telemetry uses the authenticated, bounded Worker -> RTDB path.
        // Do not let old clients (or unauthenticated callers) recreate copies.
        allow create, update: if false;
        allow read, delete: if isGlobalAdmin(appId) || isListAdmin(appId);
      }

      // 緊急アカウントリカバリー保管庫
      match /recovery_vault/{userDocId} {
        allow read: if isAuthenticated() && (request.auth.uid == userDocId || isGlobalAdmin(appId));
        allow write: if isAuthenticated() && request.auth.uid == userDocId;
      }
      match /recovery_index/{emailHash} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isGlobalAdmin(appId));
        allow update: if isGlobalAdmin(appId) || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
        allow delete: if isAuthenticated() && (('userId' in resource.data && resource.data.userId == request.auth.uid) || isGlobalAdmin(appId));
      }

      // 管理者承認による緊急パスワード再設定支援 (ワンタイムPIN)
      match /admin_recovery_requests/{userDocId} {
        allow read: if isAuthenticated() && (request.auth.uid == userDocId || isGlobalAdmin(appId));
        allow create, delete: if isGlobalAdmin(appId);
        allow update: if isGlobalAdmin(appId) ||
          (isAuthenticated() && request.auth.uid == userDocId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt']) &&
           request.resource.data.used == true);
      }
      match /admin_recovery_index/{emailHash} {
        allow read: if isGlobalAdmin(appId);
        allow write: if isGlobalAdmin(appId);
      }

      // モデレーション監査ログ (Audit Logs)
      match /audit_logs/{logId} {
        allow read: if isAuthenticated() && (isGlobalAdmin(appId) || isListAdmin(appId));
        allow create: if isAuthenticated();
        allow update, delete: if false;
      }

      // 招待コードインデックス (逆引き)
      match /inviteIndex/{code} {
        allow get: if isAuthenticated();
        allow create: if isServerAdmin(appId, request.resource.data.serverId) || isServerMember(appId, request.resource.data.serverId);
        allow update: if isServerAdmin(appId, resource.data.serverId) && isServerAdmin(appId, request.resource.data.serverId);
        allow delete: if isServerAdmin(appId, resource.data.serverId);
      }

      // 2. ユーザー情報 (Users & Profiles: IDOR保護 & Stored XSS防止)
      match /users/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin(appId))
          && (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl == null || request.resource.data.avatarUrl == '' || request.resource.data.avatarUrl.matches('^https?://.*') || request.resource.data.avatarUrl.matches('^data:image/.*'));
      }

      match /userQuotas/{qUserId} {
        allow read: if isAuthenticated() && (request.auth.uid == qUserId || isGlobalAdmin(appId));
        allow write: if isGlobalAdmin(appId);
      }

      match /users/{userId}/profile/{docId} {
        allow get: if isAuthenticated();
        allow list: if isGlobalAdmin(appId);
        allow write: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin(appId));
      }

      match /users/{userId}/notificationSettings/preferences {
        allow read, delete: if isAuthenticated() && request.auth.uid == userId;
        allow create, update: if isAuthenticated() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['servers', 'channels'])
          && (!('servers' in request.resource.data) || request.resource.data.servers is map)
          && (!('channels' in request.resource.data) || request.resource.data.channels is map);
      }

      // E2EE 秘密鍵バックアップ (本人のみ読み書き)
      match /users/{userId}/private/{document=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      // 既読状態の同期
      match /users/{userId}/readStates/{docId} {
        allow read, delete: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin(appId));
        allow create, update: if false;
      }

      // フレンド関係性 (Relationships)
      match /users/{userId}/relationships/{targetUserId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (
          isGlobalAdmin(appId) ||
          request.auth.uid == userId ||
          (request.auth.uid == targetUserId && (
            (request.resource.data.status == 'pending_received' && (resource == null || !('status' in resource.data) || resource.data.status != 'blocked')) ||
            (request.resource.data.status == 'friends' && resource != null && 'status' in resource.data && (resource.data.status == 'pending_sent' || resource.data.status == 'friends'))
          ))
        );
        allow delete: if isAuthenticated() && (request.auth.uid == userId || request.auth.uid == targetUserId || isGlobalAdmin(appId));
      }

      // ダイレクトメッセージ (DM) チャンネル (IDOR保護・参加者限定アクセス)
      match /dm_channels/{dmId} {
        allow read: if isAuthenticated() && (
          isGlobalAdmin(appId) ||
          (resource != null && 'participants' in resource.data && request.auth.uid in resource.data.participants) ||
          (resource == null && (dmId.matches('^' + request.auth.uid + '_.*') || dmId.matches('^.*_' + request.auth.uid + '$')))
        );
        allow create: if isAuthenticated() && messageSummaryIsConsistent() && request.resource.data.get('sharedKey', null) == null && request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.resource.data.participants[0] != request.resource.data.participants[1] && request.auth.uid in request.resource.data.participants && (dmId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1] || dmId == request.resource.data.participants[1] + '_' + request.resource.data.participants[0]);
        allow update: if isAuthenticated() && preservesMessageSummary() && (isGlobalAdmin(appId) || (request.auth.uid in resource.data.participants && request.resource.data.participants == resource.data.participants &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharedKey']) || request.resource.data.get('sharedKey', null) == null)));
        allow delete: if isAuthenticated() && (request.auth.uid in resource.data.participants || isGlobalAdmin(appId));

        match /keys/{keyUserId} {
          allow read: if isAuthenticated() && (
            isGlobalAdmin(appId) ||
            (exists(/databases/$(database)/documents/artifacts/$(appId)/dm_channels/$(dmId)) &&
             request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/dm_channels/$(dmId)).data.participants)
          );
          function isDmParticipant() {
            return isAuthenticated() && exists(/databases/$(database)/documents/artifacts/$(appId)/dm_channels/$(dmId)) &&
              request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/dm_channels/$(dmId)).data.participants;
          }
          allow create: if isGlobalAdmin(appId) || (isDmParticipant() && keyUserId in get(/databases/$(database)/documents/artifacts/$(appId)/dm_channels/$(dmId)).data.participants);
          allow delete: if isGlobalAdmin(appId) || (isDmParticipant() && request.auth.uid == keyUserId);
          allow update: if isGlobalAdmin(appId) || (isDmParticipant() &&
            (request.auth.uid == keyUserId ||
             (request.resource.data.versions is map && resource.data.get('versions', {}) is map &&
              request.resource.data.versions.diff(resource.data.get('versions', {})).changedKeys().size() == 0 &&
              request.resource.data.versions.diff(resource.data.get('versions', {})).removedKeys().size() == 0 &&
              request.resource.data.versions.diff(resource.data.get('versions', {})).addedKeys().size() > 0 &&
              (!('wrappedKey' in resource.data) || ('versions' in resource.data) || request.resource.data.versions.get('1', null) == resource.data.wrappedKey) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['versions', 'latestVersion', 'wrappedKey', 'updatedAt']))));
        }
      }

      // 端末間データ移行 (P2P Device Transfers: 本人・管理者限定)
      match /device_transfers/{sessionCode} {
        allow read, delete: if isAuthenticated() && (
          isGlobalAdmin(appId) ||
          (resource != null && 'uid' in resource.data && request.auth.uid == resource.data.uid)
        );
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow update: if isAuthenticated() && (isGlobalAdmin(appId) || (resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid));
        match /{subcollection}/{docId} {
          function isSessionParticipant() {
            let session = get(/databases/$(database)/documents/artifacts/$(appId)/device_transfers/$(sessionCode)).data;
            return isAuthenticated() && (isGlobalAdmin(appId) || ('uid' in session && session.uid == request.auth.uid));
          }
          allow read, write: if isSessionParticipant();
        }
      }

      // P2P 過去ログ分散補完 (P2P Log Sync: 要求者・対象者・管理者限定、削除後の完了読み取りを許容)
      match /p2p_log_sync/{syncId} {
        allow read, delete: if isAuthenticated() && (
          isGlobalAdmin(appId) ||
          resource == null ||
          (resource != null && 'requesterUid' in resource.data && request.auth.uid == resource.data.requesterUid) ||
          (resource != null && 'targetUid' in resource.data && request.auth.uid == resource.data.targetUid)
        );
        allow create: if isAuthenticated() &&
          (isGlobalAdmin(appId) ||
           (request.resource.data.requesterUid == request.auth.uid &&
            (!('dmId' in request.resource.data) ||
             request.resource.data.dmId == null ||
             request.resource.data.dmId == request.auth.uid + '_' + request.resource.data.targetUid ||
             request.resource.data.dmId == request.resource.data.targetUid + '_' + request.auth.uid)));
        allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['requesterUid', 'targetUid', 'channelType', 'serverId', 'roomId', 'dmId', 'beforeTs']) && isAuthenticated() && (
          isGlobalAdmin(appId) ||
          (resource != null && 'requesterUid' in resource.data && request.auth.uid == resource.data.requesterUid) ||
          (resource != null && 'targetUid' in resource.data && request.auth.uid == resource.data.targetUid)
        );
        match /{subcollection}/{docId} {
          function isSessionParticipant() {
            let session = get(/databases/$(database)/documents/artifacts/$(appId)/p2p_log_sync/$(syncId)).data;
            return isAuthenticated() && (isGlobalAdmin(appId) || ('requesterUid' in session && session.requesterUid == request.auth.uid) || ('targetUid' in session && session.targetUid == request.auth.uid));
          }
          allow read, write: if isSessionParticipant();
        }
      }

      // 3. グローバルオンライン状態 (Status)
      match /status/{userId} {
        allow read: if isAuthenticated();
        allow delete: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin(appId));
        allow create, update: if false;
      }

      // 4. P2P音声通話シグナリング (Calls: 通話参加者・管理者限定)
      match /calls/{callId} {
        allow read, delete: if isAuthenticated() && (
          isGlobalAdmin(appId) ||
          (resource != null && 'caller' in resource.data && 'uid' in resource.data.caller && request.auth.uid == resource.data.caller.uid) ||
          (resource != null && 'calleeUid' in resource.data && request.auth.uid == resource.data.calleeUid) ||
          (resource != null && 'callee' in resource.data && 'uid' in resource.data.callee && request.auth.uid == resource.data.callee.uid)
        );
        allow update: if isAuthenticated() &&
          (
            isGlobalAdmin(appId) ||
            (
              ((resource != null && 'caller' in resource.data && 'uid' in resource.data.caller && request.auth.uid == resource.data.caller.uid) ||
               (resource != null && 'calleeUid' in resource.data && request.auth.uid == resource.data.calleeUid) ||
               (resource != null && 'callee' in resource.data && 'uid' in resource.data.callee && request.auth.uid == resource.data.callee.uid)) &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['caller', 'callee', 'calleeUid'])
            )
          );
        allow create: if isAuthenticated() &&
          (isGlobalAdmin(appId) ||
           ('caller' in request.resource.data && 'uid' in request.resource.data.caller &&
            request.resource.data.caller.uid == request.auth.uid));

        match /{subcollection}/{candId} {
          function isSessionParticipant() {
            let session = get(/databases/$(database)/documents/artifacts/$(appId)/calls/$(callId)).data;
            return isAuthenticated() && (isGlobalAdmin(appId) || ('caller' in session && 'uid' in session.caller && session.caller.uid == request.auth.uid) || ('calleeUid' in session && session.calleeUid == request.auth.uid) || ('callee' in session && 'uid' in session.callee && session.callee.uid == request.auth.uid));
          }
          allow read, write: if isSessionParticipant();
        }
      }

      // 4b. P2Pファイル共有シグナリング (File Shares: 送信者・受信者・管理者限定)
      match /fileshares/{shareId} {
        allow read, delete: if isAuthenticated() && (
          isGlobalAdmin(appId) ||
          (resource != null && 'sender' in resource.data && 'uid' in resource.data.sender && request.auth.uid == resource.data.sender.uid) ||
          (resource != null && 'receiverUid' in resource.data && request.auth.uid == resource.data.receiverUid)
        );
        allow update: if isAuthenticated() &&
          (
            isGlobalAdmin(appId) ||
            (
              ((resource != null && 'sender' in resource.data && 'uid' in resource.data.sender && request.auth.uid == resource.data.sender.uid) ||
               (resource != null && 'receiverUid' in resource.data && request.auth.uid == resource.data.receiverUid)) &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sender', 'receiverUid'])
            )
          );
        allow create: if isAuthenticated() &&
          (isGlobalAdmin(appId) ||
           ('sender' in request.resource.data && 'uid' in request.resource.data.sender &&
            request.resource.data.sender.uid == request.auth.uid));

        match /{subcollection}/{candId} {
          function isSessionParticipant() {
            let session = get(/databases/$(database)/documents/artifacts/$(appId)/fileshares/$(shareId)).data;
            return isAuthenticated() && (isGlobalAdmin(appId) || ('sender' in session && 'uid' in session.sender && session.sender.uid == request.auth.uid) || ('receiverUid' in session && session.receiverUid == request.auth.uid));
          }
          allow read, write: if isSessionParticipant();
        }
      }

      // ========================================================================
      // 🏰 サーバーベース構造 (Servers, Rooms, Messages)
      // ========================================================================

      match /servers/{serverId} {
        allow read: if isAuthenticated();

        // サーバー作成: 自分自身を管理者・初期参加者として作成
        allow create: if isAuthenticated() &&
          (isGlobalAdmin(appId) ||
           (request.resource.data.createdBy == request.auth.uid &&
            request.resource.data.serverAdmins == [request.auth.uid] &&
            request.resource.data.joinedUsers == [request.auth.uid]));

        // サーバー設定の更新:
        allow update: if (isServerOwner(appId, serverId) || isGlobalAdmin(appId)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']);

        allow update: if isServerAdmin(appId, serverId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'serverAdmins']);

        allow update: if isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['joinedUsers', 'serverAdmins', 'memberCount']) &&
          request.auth.uid in resource.data.joinedUsers &&
          request.resource.data.joinedUsers == resource.data.joinedUsers.removeAll([request.auth.uid]) &&
          (!('serverAdmins' in resource.data) ? (!('serverAdmins' in request.resource.data)) : (request.resource.data.serverAdmins == resource.data.serverAdmins.removeAll([request.auth.uid]))) &&
          (!('memberCount' in resource.data) || request.resource.data.memberCount == resource.data.memberCount - 1);

        // サーバー削除: サーバーオーナーまたは全体管理者のみ
        allow delete: if isServerOwner(appId, serverId) || isGlobalAdmin(appId);

        // サーバー内の秘密情報 (パスワードハッシュ等)
        match /secrets/{docId} {
          allow read, write: if isServerAdmin(appId, serverId) || isGlobalAdmin(appId);
          allow delete: if isServerOwner(appId, serverId) || isGlobalAdmin(appId);
        }

        // ルーム一覧 (Channels / Rooms)
        match /rooms/{roomId} {
          allow read: if isServerMember(appId, serverId);
          allow create: if isServerAdmin(appId, serverId) && messageSummaryIsConsistent();
          allow delete: if isServerAdmin(appId, serverId);
          allow update: if preservesMessageSummary() && (isServerAdmin(appId, serverId) || (
            isAuthenticated() &&
            exists(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)) &&
            request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/servers/$(serverId)).data.joinedUsers &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageId', 'lastMessageStorageVersion', 'lastMessageStorageTimestamp', 'lastMessageAt', 'lastMessageSender', 'lastMessageSenderNickname', 'lastMessageText', 'sharedKey', 'legacyKeyMigrated', 'currentKeyVersion']) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sharedKey']) || request.resource.data.get('sharedKey', null) == null) &&
            (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentKeyVersion']) || (resource.data.get('currentKeyVersion', 1) == 1 && request.resource.data.currentKeyVersion == 1))
          ));

          // ルーム内メッセージ (Messages: サーバー参加者・管理者のみ作成可能)
          match /messages/{messageId} {
            allow read: if isServerMember(appId, serverId);
            // Version 2 bodies have a single authority in RTDB. In particular,
            // a downgraded client's pending outbox must not recreate a mirror.
            allow create: if false;

            allow update: if request.resource.data.get('storageVersion', 1) == 1 && isServerMember(appId, serverId) && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
               request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))
              || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPinned']) && (resource.data.senderId == request.auth.uid || isServerAdmin(appId, serverId)))

              || (resource.data.senderId == request.auth.uid
                  && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'userId', 'createdAt', 'timestamp', 'isPinned', 'reactions'])
                  && (!('content' in request.resource.data) || (request.resource.data.content is string && request.resource.data.content.size() <= 32000))
                  && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 32000)))
              || isGlobalAdmin(appId)
            );

            allow delete: if isAuthenticated() && (
              resource.data.senderId == request.auth.uid ||
              (!('senderId' in resource.data) && resource.data.get('userId', null) == request.auth.uid) ||
              isServerAdmin(appId, serverId) ||
              isServerOwner(appId, serverId) ||
              isGlobalAdmin(appId)
            );
          }

          // 既読レシート (Read Receipts)
          match /readReceipts/{receiptUserId} {
            allow read: if isServerMember(appId, serverId);
            allow create, update: if false;
            allow delete: if isServerMember(appId, serverId) && (request.auth.uid == receiptUserId || isGlobalAdmin(appId));
            allow delete: if isAuthenticated() &&
              (request.auth.uid == receiptUserId || isServerAdmin(appId, serverId));
          }

          // E2EE ルーム暗号鍵 (Room Keys: サーバーメンバーおよび管理者限定)
          match /roomKeys/{keyId} {
            allow read, create: if isServerMember(appId, serverId);
            allow delete: if isServerAdmin(appId, serverId);
            allow update: if isServerAdmin(appId, serverId) ||
              (isServerMember(appId, serverId) && (request.auth.uid == keyId ||
                (request.resource.data.versions is map && resource.data.get('versions', {}) is map &&
                 request.resource.data.versions.diff(resource.data.get('versions', {})).changedKeys().size() == 0 &&
                 request.resource.data.versions.diff(resource.data.get('versions', {})).removedKeys().size() == 0 &&
                 request.resource.data.versions.diff(resource.data.get('versions', {})).addedKeys().size() > 0 &&
                 request.resource.data.diff(resource.data).affectedKeys().hasOnly(['versions', 'latestVersion', 'wrappedKey', 'updatedAt']))));
          }

          // E2EE 救済リクエスト (Rescue Requests: 本人・サーバー管理者・全体管理者限定)
          match /rescueRequests/{reqUserId} {
            allow read, delete: if isAuthenticated() && (
              request.auth.uid == reqUserId ||
              isServerAdmin(appId, serverId) ||
              isGlobalAdmin(appId)
            );
            allow create, update: if isServerMember(appId, serverId) && (request.auth.uid == reqUserId || isGlobalAdmin(appId));
          }

          // タイピングインジケーター (Typing)
          match /typing/{userId} {
            allow read: if isServerMember(appId, serverId);
            allow write: if isServerMember(appId, serverId) && (request.auth.uid == userId || isGlobalAdmin(appId));
          }
        }

        // サーバー別プロフィール (Profiles)
        match /profiles/{profileUserId} {
          allow read: if isAuthenticated();
          allow create, update: if isAuthenticated() &&
            (request.auth.uid == profileUserId || isGlobalAdmin(appId));
          allow delete: if isAuthenticated() &&
            (request.auth.uid == profileUserId || isServerAdmin(appId, serverId));
        }

        // サーバーカスタムスタンプ (Stamps)
        match /stamps/{stampId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() &&
            (request.resource.data.createdBy == request.auth.uid || isGlobalAdmin(appId)) &&
            request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.name.size() <= 32 &&
            request.resource.data.url is string &&
            (request.resource.data.url.matches('https://.*') || request.resource.data.url.matches('data:image/.*'));
          allow delete, update: if isServerAdmin(appId, serverId) || isGlobalAdmin(appId);
        }

        // スタンプグループ (Stamp Groups)
        match /stampGroups/{groupId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() &&
            (request.resource.data.createdBy == request.auth.uid || isGlobalAdmin(appId)) &&
            request.resource.data.name is string;
          allow delete, update: if isServerAdmin(appId, serverId) || isGlobalAdmin(appId);
        }

        // 招待コード (Invite Codes: メンバーによる招待画面表示・コード発行に対応)
        match /inviteCodes/{code} {
          allow get: if isAuthenticated();
          allow list: if isServerAdmin(appId, serverId) || isServerMember(appId, serverId);
          allow create: if isServerAdmin(appId, serverId) || isServerMember(appId, serverId);
          allow update, delete: if isServerAdmin(appId, serverId);
        }
      }

      // VC シグナリング (P2P WebRTC Offer/Answer/ICE候補交換 - artifacts配下)
      match /vc_signaling/{sigDocId} {
        allow read, delete: if isAuthenticated() &&
          (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isGlobalAdmin(appId));
        allow create: if isAuthenticated() &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.toUid is string;
        allow update: if isAuthenticated() &&
          (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isGlobalAdmin(appId)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fromUid', 'toUid']);
      }
    }

    // ルート直下 VC シグナリング (フォールバック用)
    match /vc_signaling/{sigDocId} {
      allow read, delete: if isAuthenticated() &&
        (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string;
      allow update: if isAuthenticated() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fromUid', 'toUid']);
    }

  }
}
